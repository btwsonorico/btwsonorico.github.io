---
import Base from '../layouts/Base.astro';
import Attivita from '../components/Attivita.astro';
import Grafo from '../components/Grafo.astro';
import Lista from '../components/Lista.astro';
import TabHome from '../components/TabHome';
import { areePubbliche, grafoCompetenze, grafoKnowledge, scrittiPubblici } from '../lib/grafi';
import { COMPETENZE } from '../content.config';

const scritti = (await scrittiPubblici()).slice(0, 5);
const aree = await areePubbliche();
const [knowledge, projects] = await Promise.all([grafoKnowledge({ fonti: false }), grafoCompetenze()]);
const data = (d: Date) => d.toISOString().slice(0, 10);
const tipo = (s: (typeof scritti)[number]) => s.data.sources.find(f => f.role === 'main')?.type;
---
<Base title="Riccardo Mondi">
  <main>
    <section class="intro">
      <h1>Riccardo Mondi</h1>
      <p class="ruoli mono">
        <span>AI Advisor & Developer</span>
        <span class="ente">Politecnico di Milano - Osservatorio Artificial Intelligence</span>
      </p>
      <p class="link mono">
        <a href="mailto:riccardo.mondi@polimi.it">email</a>
        <a href="https://github.com/btwsonorico" rel="me">github</a>
        <a href="https://www.linkedin.com/in/riccardo-mondi-7717181aa/" rel="me">linkedin</a>
      </p>
    </section>

    <div class="tab"><TabHome client:only="react" /></div>

    <div class="pannelli">
      <section data-pannello="knowledge">
        <Grafo dati={knowledge} legenda={['testo', 'tema']} />
        <Lista titolo="Latest" righe={scritti.map(s => ({
          id: s.id, data: data(s.data.date), titolo: s.data.title, href: `/knowledge/${s.id}/`,
          etichetta: [tipo(s), s.data.lang].filter(Boolean).join(' · '),
        }))} />
        <p class="tutto mono"><a href="/knowledge/">all writing →</a></p>
      </section>

      <section data-pannello="projects" data-tono="arancio" hidden>
        <Grafo dati={projects} legenda={['skill', 'area']} />
        <div class="commit"><Attivita /></div>
        <Lista titolo="Key skills" righe={Object.entries(COMPETENZE).map(([id, c], i) => ({
          id: `skill:${id}`, data: String(i + 1).padStart(2, '0'), titolo: c.title, href: `/projects/#${id}`, nota: c.summary,
          etichetta: `${aree.filter(a => a.data.skill === id).length} areas`,
        }))} />
        <p class="tutto mono"><a href="/projects/">all skills and areas →</a></p>
      </section>
    </div>
  </main>
</Base>

<script>
  // Cambio di tab: dissolvenza con le View Transitions quando il browser le supporta
  const pannelli = document.querySelectorAll<HTMLElement>('[data-pannello]');
  let attuale = 'knowledge';
  window.addEventListener('home:tab', e => {
    const tab = (e as CustomEvent<string>).detail;
    if (tab === attuale) return;
    attuale = tab;
    const applica = () => pannelli.forEach(p => { p.hidden = p.dataset.pannello !== tab; });
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(applica);
    else applica();
  });
</script>

<style>
  .intro { padding: 56px 0 28px; }
  h1 { margin: 0 0 16px; font-size: 44px; font-weight: 400; line-height: 1.1; letter-spacing: -0.01em; }
  .intro p { margin: 0 0 16px; max-width: 560px; }
  .ruoli { display: flex; flex-direction: column; gap: 2px; font-size: 22px; color: var(--fg); }
  .intro .ruoli { max-width: none; }
  .ente { font-size: 14px; color: var(--muted); }
  .link { display: flex; gap: 18px; flex-wrap: wrap; }
  .tab { min-height: 40px; margin-bottom: 14px; font-family: var(--mono); }
  .pannelli { view-transition-name: pannelli; }
  .commit { padding-bottom: 8px; }
  .tutto { margin: 0 0 32px; }
  .tutto a { text-decoration: none; }
  @media (max-width: 640px) {
    .intro { padding-top: 16px; }
    h1 { font-size: 34px; }
  }
</style>

<style is:global>
  ::view-transition-old(pannelli) { animation: 160ms ease-in both pannello-esce; }
  ::view-transition-new(pannelli) { animation: 260ms cubic-bezier(.2, .8, .2, 1) both pannello-entra; }
  @keyframes pannello-esce { to { opacity: 0; transform: translateY(-6px); filter: blur(2px); } }
  @keyframes pannello-entra { from { opacity: 0; transform: translateY(8px); filter: blur(2px); } }
</style>
