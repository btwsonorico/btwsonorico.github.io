---
import Base from '../layouts/Base.astro';
import Attivita from '../components/Attivita.astro';
import Grafo from '../components/Grafo.astro';
import Lista from '../components/Lista.astro';
import TabHome from '../components/TabHome';
import { advisoryPubbliche, areePubbliche, datiCompetenze, grafoKnowledge, scrittiPubblici } from '../lib/grafi';
import { COMPETENZE, COMPETENZE_ADVISORY } from '../content.config';

const scritti = (await scrittiPubblici()).slice(0, 5);
const aree = await areePubbliche();
const [knowledge, projects, advisory] = await Promise.all([grafoKnowledge({ fonti: false }), datiCompetenze('projects'), datiCompetenze('advisory')]);
const consulenze = await advisoryPubbliche();
const data = (d: Date) => d.toISOString().slice(0, 10);
const tipo = (s: (typeof scritti)[number]) => s.data.sources.find(f => f.role === 'main')?.type;
---
<Base title="Riccardo Mondi" largo>
  <main class="affianca">
    <div class="a-testa">
    <section class="intro testa-pagina">
      <h1>Riccardo Mondi</h1>
      <p class="ruoli mono">
        <span>AI Advisor & Developer</span>
        <span class="ente">Politecnico di Milano - Osservatorio Artificial Intelligence + R&amp;D Osservatori</span>
      </p>
      <p class="link mono">
        <a href="mailto:riccardo.mondi@polimi.it">email</a>
        <a href="https://github.com/btwsonorico" rel="me">github</a>
        <a href="https://www.linkedin.com/in/riccardo-mondi-7717181aa/" rel="me">linkedin</a>
      </p>
    </section>

    <div class="tab"><TabHome client:only="react" /></div>
    </div>

    <!-- Un grafo per tab: su schermi larghi stanno a destra, accanto al nome -->
    <div class="a-grafo grafi">
      <div data-pannello="knowledge" hidden><Grafo dati={knowledge} legenda={['testo', 'tema']} /></div>
      <div data-pannello="projects" data-tono="arancio" hidden><Grafo dati={projects} legenda={['skill', 'area']} motore="bosco" nomi={{ skill: 'clearing: key skill', area: 'tree: area' }} aiuto="taller tree, more technologies · click a tree to open · drag to rotate" /></div>
      <div data-pannello="advisory" data-tono="lilla"><Grafo dati={advisory} legenda={['skill', 'area']} motore="orbite" nomi={{ skill: 'planet: key skill', area: 'moon: area' }} aiuto="click a planet or a moon to open · drag to rotate" /></div>
    </div>

    <div class="a-resto pannelli">
      <section data-pannello="knowledge" hidden>
        <Lista titolo="Latest" righe={scritti.map(s => ({
          id: s.id, data: data(s.data.date), titolo: s.data.title, href: `/knowledge/${s.id}/`,
          etichetta: [tipo(s), s.data.lang].filter(Boolean).join(' · '),
        }))} />
        <p class="tutto mono"><a href="/knowledge/">all writing →</a></p>
      </section>

      <section data-pannello="projects" data-tono="arancio" hidden>
        <section class="sezione"><h2 class="mono">Commits</h2><Attivita /></section>
        <Lista titolo="Key skills" righe={Object.entries(COMPETENZE).map(([id, c], i) => ({
          id: `skill:${id}`, data: String(i + 1).padStart(2, '0'), titolo: c.title, href: `/projects/#${id}`, nota: c.summary,
          etichetta: `${aree.filter(a => a.data.skill === id).length} areas`,
        }))} />
        <p class="tutto mono"><a href="/projects/">all skills and areas →</a></p>
      </section>

      <section data-pannello="advisory" data-tono="lilla">
        <Lista titolo="Key skills" righe={Object.entries(COMPETENZE_ADVISORY).map(([id, c], i) => ({
          id: `skill:${id}`, data: String(i + 1).padStart(2, '0'), titolo: c.title, href: `/advisory/#${id}`, nota: c.summary,
          etichetta: `${consulenze.filter(a => a.data.skill === id).length} areas`,
        }))} />
        <p class="tutto mono"><a href="/advisory/">all skills and areas →</a></p>
      </section>
    </div>
  </main>
</Base>

<script>
  // Cambio di tab: dissolvenza con le View Transitions quando il browser le supporta
  const pannelli = document.querySelectorAll<HTMLElement>('[data-pannello]');
  let attuale = 'advisory';
  // /#projects e /#knowledge aprono subito quel tab: il controllo dei tab può caricarsi prima di questo script e il suo evento andrebbe perso
  const daIndirizzo = location.hash.slice(1);
  if (daIndirizzo === 'projects' || daIndirizzo === 'knowledge') {
    attuale = daIndirizzo;
    pannelli.forEach(p => { p.hidden = p.dataset.pannello !== daIndirizzo; });
  }
  window.addEventListener('home:tab', e => {
    const tab = (e as CustomEvent<string>).detail;
    if (tab === attuale) return;
    attuale = tab;
    const applica = () => pannelli.forEach(p => { p.hidden = p.dataset.pannello !== tab; });
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) doc.startViewTransition(applica);
    else applica();
  });
</script>

<style>
  h1 { margin: 0 0 var(--s2); font-size: 44px; font-weight: 400; line-height: 1.1; }
  .intro p { margin: 0 0 var(--s2); max-width: 560px; }
  .intro p:last-child { margin-bottom: 0; }
  .ruoli { display: flex; flex-direction: column; gap: 2px; font-size: 22px; color: var(--fg); }
  .intro .ruoli { max-width: none; }
  .ente { font-size: 13px; color: var(--muted); }
  .link { display: flex; gap: 18px; flex-wrap: wrap; }
  .tab { min-height: 40px; margin-bottom: var(--s3); font-family: var(--mono); }
  .pannelli { view-transition-name: pannelli; }
  .grafi { view-transition-name: grafi; }
  .tutto { margin: 0; }
  .tutto a { text-decoration: none; }
  @media (max-width: 640px) {
    .intro { padding-top: var(--s3); }
    h1 { font-size: 33px; }
  }
</style>

<style is:global>
  ::view-transition-old(pannelli) { animation: 160ms ease-in both pannello-esce; }
  ::view-transition-new(pannelli) { animation: 260ms cubic-bezier(.2, .8, .2, 1) both pannello-entra; }
  @keyframes pannello-esce { to { opacity: 0; transform: translateY(-6px); filter: blur(2px); } }
  @keyframes pannello-entra { from { opacity: 0; transform: translateY(8px); filter: blur(2px); } }
</style>
