---
import Base from '../layouts/Base.astro';
import { SITO } from '../lib/sito';

// Dati strutturati: chi sono, in una forma che motori di ricerca e AI leggono senza ambiguità
const PERSONA = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITO.nome,
  jobTitle: SITO.ruolo,
  description: SITO.bio,
  email: `mailto:${SITO.email}`,
  url: Astro.site?.href,
  worksFor: { '@type': 'CollegeOrUniversity', name: SITO.ente, department: SITO.gruppo },
  knowsAbout: ['Artificial intelligence', 'AI strategy', 'AI adoption', 'Software engineering', 'LLM applications', 'Human-AI interaction'],
  sameAs: [SITO.github, SITO.linkedin],
};

// Colore di ogni sezione: nella lista, al passaggio del puntatore
const TONI: Record<string, string> = { software: 'verde', advisory: 'azzurro', knowledge: 'arancio' };
// Tutte le pagine del sito, con una riga che dice cosa c'è
const PAGINE = [
  { nome: 'software', href: '/software/', nota: 'what I build: skills, areas, commits' },
  { nome: 'advisory', href: '/advisory/', nota: 'how I help organisations adopt AI' },
  { nome: 'knowledge', href: '/knowledge/', nota: 'notes on papers, talks and books' },
  { nome: 'misc', href: '/misc/', nota: 'small experiments' },
];
---
<Base title="Riccardo Mondi" description="Riccardo Mondi: AI advisor and developer at Politecnico di Milano." tono="neutro" largo>
  <script type="application/ld+json" set:html={JSON.stringify(PERSONA)} />
  <!-- Mondo 3D: il contenitore copre lo schermo; la scena sta dentro, così la vista 3D sa quando è visibile -->
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="about">
    <p class="mono">~/</p>
    <h1>Riccardo Mondi</h1>
    <p class="ruolo">{SITO.ruolo}</p>
    <p class="mono ente">Polimi - {SITO.gruppo}</p>
    <p class="mono link">
      <a href="mailto:riccardo.mondi@polimi.it">email</a>
      <a href="https://github.com/btwsonorico" rel="me">github</a>
      <a href="https://www.linkedin.com/in/riccardo-mondi-7717181aa/" rel="me">linkedin</a>
    </p>
    <nav class="pagine" aria-label="All pages">
      <p class="mono titoletto">pages</p>
      <ul>
        {PAGINE.map(p => <li><a href={p.href} data-sezione={TONI[p.nome] ? `sezione:${p.nome}` : undefined} data-tono={TONI[p.nome]}>{p.nome}</a><span class="mono">{p.nota}</span></li>)}
      </ul>
    </nav>
  </main>
</Base>

<script>
  // Il mondo 3D: bosco (Software), stagno (Advisory), stormo (Knowledge). Si scarica dopo il primo disegno: il testo appare subito
  setTimeout(() => import('../scripts/mondo').then(m => m.monta(document.querySelector<HTMLElement>('.scena3d')!)), 30);
  // Passare sopra una sezione nella lista accende la sua parte del mondo, come nelle liste delle altre pagine
  document.querySelectorAll<HTMLElement>('[data-sezione]').forEach(a => {
    a.addEventListener('mouseenter', () => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: a.dataset.sezione })));
    a.addEventListener('mouseleave', () => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: null })));
  });
</script>

<style>
  /* Il mondo copre tutto lo schermo, dietro al testo; il testo lascia passare il puntatore tranne sui link */
  .about a { pointer-events: auto; }
  /* Il testo sta a metà altezza dello schermo, non in fondo */
  .about { position: relative; z-index: 1; pointer-events: none; display: flex; flex-direction: column; justify-content: center; min-height: calc(100vh - 140px); padding-bottom: 0; }
  .about > * { max-width: 520px; margin: 0 0 var(--s2); }
  h1 { margin-bottom: var(--s1); font-size: 44px; font-weight: 400; line-height: 1.1; }
  .ruolo { font-size: 22px; margin-bottom: var(--s1); }
  .ente { font-size: 13px; }
  .link { display: flex; gap: var(--s2); }
  .link a { color: var(--accent); }
  .pagine ul { margin: 0; padding: 0; list-style: none; }
  .pagine li { display: flex; gap: var(--s2); align-items: baseline; font-size: 13px; line-height: 1.7; }
  .pagine li a { min-width: 80px; padding: 0 5px; margin-left: -5px; color: var(--fg); }
  /* Al passaggio, la sezione diventa un riquadro nel suo colore, come la sua etichetta accesa nel mondo */
  .pagine li a[data-tono]:hover { color: var(--bg); background: var(--accent); text-decoration: none; }
  .titoletto { margin: 0 0 4px; }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  /* Il mondo copre tutta la finestra; la barra e la scritta della build gli stanno sopra */
  .fondo3d { position: fixed; inset: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: none; }
  /* Etichette del mondo: come nelle scene di bosco e laghetto, nel colore della loro sezione */
  .scena3d :global(.etichetta) {
    position: absolute; left: 0; top: 0; pointer-events: none; white-space: nowrap;
    padding: 1px 5px; font-family: var(--mono); font-size: 11px; color: var(--accent);
    background: color-mix(in srgb, var(--bg) 78%, transparent); transition: opacity .15s;
  }
  .scena3d :global(.etichetta.attiva) { color: var(--bg); background: var(--accent); padding: 2px 7px; z-index: 2; }
  /* Sezione sotto il puntatore: la sua etichetta dice che si apre */
  .scena3d :global(.etichetta.skill.attiva)::after { content: ' · open →'; }
  @media (max-width: 640px) {
    h1 { font-size: 33px; }
    /* Sul telefono la scena non sta dietro al testo: occupa una fascia in alto, che scorre via con la pagina.
       Così il testo resta leggibile e i link si toccano */
    .fondo3d { position: absolute; top: 0; left: 0; right: 0; bottom: auto; width: 100%; height: 50vh; }
    .about { padding-top: 45vh; min-height: 0; justify-content: flex-start; }
    /* Sul telefono il trascinamento in verticale fa scorrere la pagina anche sopra il cielo */
    .scena3d { touch-action: pan-y; }
  }
</style>
