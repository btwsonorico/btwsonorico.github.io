---
import Base from '../layouts/Base.astro';
import { SITO } from '../lib/sito';

// Dati strutturati: chi sono, in una forma che motori di ricerca e AI leggono senza ambiguità
const PERSONA = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITO.nome,
  jobTitle: SITO.ruolo,
  description: SITO.bio,
  email: `mailto:${SITO.email}`,
  url: Astro.site?.href,
  worksFor: { '@type': 'CollegeOrUniversity', name: SITO.ente, department: SITO.gruppo },
  knowsAbout: ['Artificial intelligence', 'AI strategy', 'AI adoption', 'Software engineering', 'LLM applications', 'Human-AI interaction'],
  sameAs: [SITO.github, SITO.linkedin],
};

// Colore di ogni sezione: nella lista, al passaggio del puntatore
const TONI: Record<string, string> = { software: 'verde', advisory: 'azzurro', knowledge: 'arancio' };
// Tutte le pagine del sito, con una riga che dice cosa c'è
const PAGINE = [
  { nome: 'software', href: '/software/', nota: 'Things I build, and my skills' },
  { nome: 'advisory', href: '/advisory/', nota: 'My work with companies on AI' },
  { nome: 'knowledge', href: '/knowledge/', nota: 'My thoughts on papers, news and more' },
  { nome: 'learn', href: '/learn/', nota: 'AI concepts you can touch' },
];
---
<Base title="Riccardo Mondi" description="Riccardo Mondi: AI advisor and developer at Politecnico di Milano." tono="neutro" largo>
  <script type="application/ld+json" set:html={JSON.stringify(PERSONA)} />
  <!-- Intro una volta per sessione. Si decide prima del primo disegno, così la home non lampeggia. Senza JavaScript non c'è -->
  <script is:inline slot="testa">
    (() => {
      let vista = false;
      try { vista = sessionStorage.getItem('intro') === '1'; sessionStorage.setItem('intro', '1'); } catch {}
      const prova = new URLSearchParams(location.search).has('intro');
      if (prova || (!vista && !matchMedia('(prefers-reduced-motion: reduce)').matches)) document.documentElement.dataset.intro = 'on';
    })();
  </script>
  <div id="intro" aria-hidden="true">
    <canvas></canvas>
    <p class="intro-nome">/Riccardo Mondi</p>
    <p class="intro-salta mono">click to skip</p>
  </div>
  <!-- Mondo 3D: il contenitore copre lo schermo; la scena sta dentro, così la vista 3D sa quando è visibile -->
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="about">
    <p class="mono titoletto-about">/about</p>
    <h1>Riccardo Mondi</h1>
    <p class="ruolo">{SITO.ruolo} {SITO.dove}</p>
    <p class="bio">{SITO.bio}</p>
    <p class="mono link">
      <a href="mailto:riccardo.mondi@polimi.it">email</a>
      <a href="https://github.com/btwsonorico" rel="me">github</a>
      <a href="https://www.linkedin.com/in/riccardo-mondi-7717181aa/" rel="me">linkedin</a>
    </p>
    <nav class="pagine" aria-label="All pages">
      <p class="mono titoletto">pages</p>
      <ul>
        {PAGINE.map(p => <li><a href={p.href} data-sezione={`sezione:${p.nome}`} data-tono={TONI[p.nome]}>{p.nome}</a><span class="mono">{p.nota}</span></li>)}
      </ul>
    </nav>
  </main>
</Base>

<script>
  // L'intro parte subito; se il suo file non arriva, dopo 3 secondi la home resta comunque libera
  const intro = document.getElementById('intro'), radice = document.documentElement;
  if (intro && radice.dataset.intro) {
    const riserva = setTimeout(() => { delete radice.dataset.intro; intro.remove(); }, 3000);
    import('../scripts/intro').then(m => { clearTimeout(riserva); m.monta(intro); });
  } else intro?.remove();
  // Il mondo 3D: bosco (Software), stagno (Advisory), stormo (Knowledge), cervi (Learn). Si scarica dopo il primo disegno: il testo appare subito
  setTimeout(() => import('../scripts/mondo').then(m => m.monta(document.querySelector<HTMLElement>('.scena3d')!)), 30);
  // Passare sopra una sezione nella lista accende la sua parte del mondo, come nelle liste delle altre pagine
  document.querySelectorAll<HTMLElement>('[data-sezione]').forEach(a => {
    a.addEventListener('mouseenter', () => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: a.dataset.sezione })));
    a.addEventListener('mouseleave', () => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: null })));
  });
</script>

<style>
  /* Intro: copre tutto, anche la barra e il cursore del sito. Il canvas ha pochi pixel, ingranditi senza sfumare */
  #intro { display: none; }
  :global(html[data-intro]) #intro { display: block; position: fixed; inset: 0; z-index: 2000; background: var(--bg); }
  :global(html[data-intro]) #intro.in-volo { background: transparent; pointer-events: none; }
  #intro canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; }
  .intro-nome { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); margin: 0; font-family: var(--mono); font-size: clamp(28px, 5.4vw, 72px); line-height: 1; white-space: nowrap; color: var(--fg); text-shadow: 3px 0 var(--bg), -3px 0 var(--bg), 0 3px var(--bg), 0 -3px var(--bg), 3px 3px var(--bg), -3px -3px var(--bg), 3px -3px var(--bg), -3px 3px var(--bg); }
  /* Il nome scende al suo posto: intanto quello vero non si vede, poi prende il suo posto senza stacco */
  .intro-nome.in-volo { position: fixed; text-shadow: none; white-space: nowrap; }
  :global(html[data-intro]) .about > h1 { visibility: hidden; }
  .intro-salta { position: absolute; right: 16px; bottom: 12px; margin: 0; font-size: 12px; color: var(--muted); }
  #intro.in-volo .intro-salta { display: none; }
  /* Il mondo copre tutto lo schermo, dietro al testo; il testo lascia passare il puntatore tranne sui link */
  .about a { pointer-events: auto; }
  /* Il testo sta a metà altezza dello schermo, non in fondo */
  .about { position: relative; z-index: 1; pointer-events: none; display: flex; flex-direction: column; justify-content: center; min-height: calc(100vh - 140px); padding-bottom: 0; }
  /* Ogni riga è larga quanto il suo testo: il mondo misura da qui lo spazio libero */
  /* Spazi: 8 dentro un gruppo, 16 fra cose collegate, 32 prima di un gruppo nuovo */
  .about > * { width: fit-content; max-width: 520px; margin: 0; }
  .about > .titoletto-about { margin-bottom: var(--s1); }
  .about > h1 { margin-bottom: var(--s1); font-size: 44px; font-weight: 400; line-height: 1.1; }
  /* Ruolo e sede stanno sempre sulla stessa riga */
  .about > .ruolo { max-width: none; margin-bottom: var(--s2); font-size: 18px; white-space: nowrap; }
  /* La scena sta a destra: il testo si ferma prima, anche a finestra stretta */
  .about > .bio { max-width: min(420px, 42vw); margin-bottom: var(--s2); color: var(--muted); font-size: 14px; line-height: 1.6; }
  .about > .link { display: flex; gap: var(--s2); margin-bottom: calc(var(--s3) + var(--s1)); }
  .link a { color: var(--accent); }
  /* Nomi e descrizioni in due colonne allineate */
  .pagine ul { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px var(--s2); margin: 0; padding: 0; list-style: none; }
  .pagine li { display: contents; }
  .pagine li a { justify-self: start; padding: 0 5px; margin-left: -5px; font-size: 13px; line-height: 1.6; color: var(--fg); }
  .pagine li span { align-self: center; font-size: 12px; line-height: 1.4; }
  /* Al passaggio, la sezione diventa un riquadro nel suo colore, come la sua etichetta accesa nel mondo */
  .pagine li a[data-tono]:hover { color: var(--bg); background: var(--accent); text-decoration: none; }
  /* Learn non ha un colore suo: il riquadro è nel colore del testo, bianco in dark mode */
  .pagine li a:not([data-tono]):hover { color: var(--bg); background: var(--fg); text-decoration: none; }
  .titoletto { margin: 0 0 var(--s1); }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  /* Il mondo copre tutta la finestra; la barra e la scritta della build gli stanno sopra */
  .fondo3d { position: fixed; inset: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: none; }
  /* Etichette del mondo: come nelle scene di bosco e laghetto, nel colore della loro sezione */
  .scena3d :global(.etichetta) {
    position: absolute; left: 0; top: 0; pointer-events: none; white-space: nowrap;
    padding: 1px 5px; font-family: var(--mono); font-size: 11px; color: var(--accent);
    background: color-mix(in srgb, var(--bg) 78%, transparent); transition: opacity .15s;
  }
  .scena3d :global(.etichetta.attiva) { color: var(--bg); background: var(--accent); padding: 2px 7px; z-index: 2; }
  /* Sezione sotto il puntatore: la sua etichetta dice che si apre */
  .scena3d :global(.etichetta.skill.attiva)::after { content: ' · open →'; }
  @media (max-width: 640px) {
    .about > h1 { font-size: 33px; }
  }
  /* Telefono: la scena non sta accanto al testo ma in una fascia in alto, che
     scorre via con la pagina. Così il mondo resta grande e centrato, il testo leggibile e i link si toccano */
  @media (max-width: 640px) {
    .about > .bio { max-width: none; }
    .about > .ruolo { font-size: clamp(14px, 4.3vw, 18px); }
    .fondo3d { position: absolute; top: 0; left: 0; right: 0; bottom: auto; width: 100%; height: min(50vh, 105vw); }
    .about { padding-top: calc(min(50vh, 105vw) - 66px); min-height: 0; justify-content: flex-start; }
    .link a, .pagine li a { display: inline-flex; align-items: center; min-height: 32px; }
    .about > .link { gap: var(--s3); margin-bottom: var(--s3); }
    /* Il trascinamento in verticale fa scorrere la pagina anche sopra il cielo */
    .scena3d { touch-action: pan-y; }
  }
</style>
