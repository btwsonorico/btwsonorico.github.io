---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { areePubbliche, scrittiPubblici } from '../../lib/grafi';

export async function getStaticPaths() {
  const scritti = await scrittiPubblici();
  return scritti.map((s, i) => ({ params: { id: s.id }, props: { s, prima: scritti[i + 1], dopo: scritti[i - 1] } }));
}

const { s, prima, dopo } = Astro.props;
const { Content } = await render(s);
const minuti = Math.max(1, Math.round((s.body ?? '').split(/\s+/).length / 220));
const tipo = { essay: 'essay', thought: 'thought', source: 'note on a source' }[s.data.kind];
const aree = (await areePubbliche()).filter(p => p.data.related.includes(s.id));
const principali = s.data.sources.filter(f => f.role === 'main');
const secondarie = s.data.sources.filter(f => f.role === 'secondary');
---
<Base title={`${s.data.title} · Riccardo Mondi`} description={s.data.summary} lang={s.data.lang} tono="arancio">
  <main>
    <article>
      <header>
        <p class="mono testa"><a href="/knowledge/">knowledge</a> · {s.data.date.toISOString().slice(0, 10)} · {tipo} · {s.data.lang} · {minuti} min{s.data.topics.map(t => <span> #{t}</span>)}</p>
        <h1>{s.data.title}</h1>
        <p class="sommario">{s.data.summary}</p>
        {principali.map(f => <p class="fonte mono">
          <span>{f.type}</span>
          <a href={f.url}>{f.title}</a>
          {f.author && <span>{f.author}</span>}
        </p>)}
      </header>
      <div class="prosa"><Content /></div>
      {secondarie.length ? <section class="secondarie sezione">
        <h2 class="mono">Sources</h2>
        <ol class="mono">{secondarie.map(f => <li><span>{f.type}</span> <a href={f.url}>{f.title}</a>{f.author && <span> · {f.author}</span>}</li>)}</ol>
      </section> : null}
      {aree.length ? <p class="mono usato">applied in {aree.map(p => <a href={`/projects/${p.id}/`}>{p.data.title}</a>)}</p> : null}
    </article>
    <nav class="vicini mono">
      {prima ? <a href={`/knowledge/${prima.id}/`}>← {prima.data.title}</a> : <span></span>}
      {dopo ? <a href={`/knowledge/${dopo.id}/`}>{dopo.data.title} →</a> : <span></span>}
    </nav>
  </main>
</Base>

<style>
  article { max-width: 640px; padding: var(--s4) 0 var(--s3); }
  .testa { margin: 0; }
  .testa a { text-decoration: none; }
  .testa span { color: var(--accent); }
  h1 { margin: var(--s1) 0 var(--s2); font-size: 33px; font-weight: 400; line-height: 1.2; }
  .sommario { margin: 0 0 var(--s3); color: var(--muted); }
  .fonte {
    display: grid;
    gap: 2px;
    margin: 0 0 var(--s1);
    padding: var(--s2);
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .fonte span:first-child { color: var(--accent); }
  .fonte a { color: var(--fg); }
  .fonte:last-of-type { margin-bottom: var(--s3); }
  .secondarie { margin-top: var(--s4); }
  .secondarie ol { margin: 0; padding-left: 20px; }
  .secondarie li span:first-child { color: var(--accent); }
  .secondarie a { color: var(--fg); }
  .usato { display: flex; gap: var(--s2); flex-wrap: wrap; margin: var(--s3) 0 0; }

  .prosa :global(h2) { margin: var(--s4) 0 var(--s1); font-size: 22px; font-weight: 400; color: var(--accent); }
  .prosa :global(h2)::before { content: '## '; font-weight: 400; color: var(--muted); }
  .prosa :global(blockquote) { margin: var(--s3) 0; padding-left: 18px; border-left: 2px solid var(--accent); color: var(--muted); }
  .prosa :global(code) { font-family: var(--mono); font-size: 0.85em; padding: 1px 5px; background: var(--line); }
  .prosa :global(pre) { padding: 16px; overflow-x: auto; border: 1px solid var(--line); background: #070809; font-size: 11px; }
  .prosa :global(img) { max-width: 100%; }
  .prosa :global(figure) { margin: var(--s3) 0; }
  .prosa :global(figure svg) { display: block; width: 100%; height: auto; overflow: visible; }

  .vicini { display: flex; justify-content: space-between; gap: var(--s3); padding: var(--s3) 0 0; border-top: 1px solid var(--line); }
  .vicini a { text-decoration: none; max-width: 45%; }

  @media (max-width: 640px) { h1 { font-size: 26px; } }
</style>
