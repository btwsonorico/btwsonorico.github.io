---
import Base from '../../layouts/Base.astro';
import Grafo from '../../components/Grafo.astro';
import Lista from '../../components/Lista.astro';
import { grafoKnowledge, hrefTema, scrittiPubblici } from '../../lib/grafi';

const scritti = await scrittiPubblici();
const dati = await grafoKnowledge({ fonti: false });
const data = (d: Date) => d.toISOString().slice(0, 10);
// Vista a stormi: ogni tema uno stormo, ogni testo un uccello; eta: 0 il più recente, 1 il più vecchio
const inOrdine = [...scritti].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const nomiTemi = [...new Set(inOrdine.flatMap(s => s.data.topics))];
const stormi = {
  temi: nomiTemi.map(t => ({ id: t, label: t, href: hrefTema(t) })),
  testi: inOrdine.map((s, i) => ({ id: s.id, label: s.data.title, href: `/knowledge/${s.id}/`, temi: s.data.topics, eta: inOrdine.length > 1 ? i / (inOrdine.length - 1) : 0 })),
};
const righe = (kind: string) => scritti.filter(s => s.data.kind === kind).map(s => ({
  id: s.id,
  data: data(s.data.date),
  titolo: s.data.title,
  href: `/knowledge/${s.id}/`,
  etichetta: [s.data.sources.find(f => f.role === 'main')?.type, s.data.lang].filter(Boolean).join(' · '),
  temi: s.data.topics,
}));
---
<Base title="Knowledge · Riccardo Mondi" description="Knowledge by Riccardo Mondi: essays, thoughts and notes on AI papers, talks and books." tono="arancio" largo>
  <main class="affianca">
    <header class="testa testa-pagina a-testa">
      <h1>Knowledge</h1>
      <p>What I read, watch and think about. Each point is a piece of writing or a topic; the sources are inside each note.</p>
    </header>
    <div class="a-grafo"><Grafo viste={[{ nome: 'graph', dati }, { nome: 'flocks', dati: stormi, motore: 'stormi' }]} /></div>
    <div class="a-resto">
      <Lista titolo="Essays" righe={righe('essay')} />
      <Lista titolo="Thoughts" righe={righe('thought')} />
      <Lista titolo="Notes on sources" righe={righe('source')} />
    </div>
  </main>
</Base>


<style>
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); max-width: 560px; }
</style>
