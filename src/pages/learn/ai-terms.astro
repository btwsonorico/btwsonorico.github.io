---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// AI timeline: la storia dell'AI vista da una barca da pesca, di notte, su un mare mosso. Ogni evento è una boa; scorrendo
// la barca passa da una all'altra. Gli eventi sono note in src/content/timeline. Il gioco (pescare e ordinare) arriva dopo.
const eventi = (await getCollection('timeline', e => !e.data.draft))
  .map(e => ({ title: e.data.title, year: e.data.year, month: e.data.month, kind: e.data.kind, who: e.data.who, source: e.data.source, text: (e.body ?? '').trim() }))
  .sort((a, b) => a.year - b.year || (a.month ?? 0) - (b.month ?? 0) || a.title.localeCompare(b.title));
const TIPI = [['all', 'All'], ['research', 'Research'], ['system', 'Systems'], ['company', 'Companies'], ['society', 'Society']] as const;
---
<Base title="AI timeline · Riccardo Mondi" description="Sail through the history of AI, from the first artificial neuron in 1943 to today's models." tono="neutro" largo>
  <canvas class="mare" aria-hidden="true"></canvas>
  <main class="timeline">
    <div class="testa">
      <h1>AI timeline</h1>
      <p class="sotto">Sail through the history of AI, from 1943 to today. Scroll to move the boat.</p>
      <div class="filtri mono" role="group" aria-label="filter events">
        {TIPI.map(([k, nome]) => <button type="button" data-tipo={k} aria-pressed={k === 'all' ? 'true' : 'false'}><i class={`tipo-${k}`}></i>{nome}</button>)}
      </div>
    </div>
    <div class="binario"></div>
    <article class="scheda" aria-live="polite">
      <p class="mono quando"></p>
      <h2 class="titolo"></h2>
      <p class="mono chi"></p>
      <p class="testo"></p>
      <div class="sotto-scheda mono">
        <a class="fonte" target="_blank" rel="noopener">source ↗</a>
        <span class="conta"></span>
        <span class="frecce"><button type="button" class="prima" aria-label="previous event">←</button><button type="button" class="dopo" aria-label="next event">→</button></span>
      </div>
    </article>
    <ol class="tutti">
      {eventi.map(e => <li>{e.year}: {e.title}. {e.text}</li>)}
    </ol>
  </main>
  <script type="application/json" id="eventi" set:html={JSON.stringify(eventi)} />
</Base>

<script>
  import { monta, eraDi, ERE, type Evento } from '../../scripts/timelineBarca';

  const TUTTI = JSON.parse(document.getElementById('eventi')!.textContent!) as Evento[];
  const MESI = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const NOMI = { research: 'Research', system: 'System', company: 'Company', society: 'Society' } as const;
  const binario = document.querySelector<HTMLElement>('.binario')!, scheda = document.querySelector<HTMLElement>('.scheda')!;
  const $ = <T extends HTMLElement>(s: string) => scheda.querySelector<T>(s)!;
  let tipo = 'all', eventi = TUTTI, mostrato = -1;

  // Ogni evento occupa un passo di scorrimento; il binario dà alla pagina l'altezza giusta
  const PASSO = () => Math.max(180, window.innerHeight * 0.45);
  const misura = () => { binario.style.height = `${(eventi.length - 1) * PASSO() + window.innerHeight}px`; };
  const inizio = () => binario.offsetTop;
  const indice = () => Math.max(0, Math.min(eventi.length - 1, (window.scrollY - inizio() + window.innerHeight * 0.3) / PASSO()));
  const vai = (i: number, liscio = true) => window.scrollTo({ top: inizio() - window.innerHeight * 0.3 + i * PASSO(), behavior: liscio ? 'smooth' : 'auto' });

  const scrivi = () => {
    const i = Math.round(indice());
    if (i === mostrato || !eventi[i]) return;
    mostrato = i;
    const e = eventi[i]!;
    $('.quando').textContent = `${e.month ? `${MESI[e.month - 1]} ` : ''}${e.year} · ${NOMI[e.kind]} · ${ERE[eraDi(e.year)]!.nome}`;
    $('.quando').dataset.tipo = e.kind;
    $('.titolo').textContent = e.title;
    $('.chi').textContent = e.who;
    $('.testo').textContent = e.text;
    $<HTMLAnchorElement>('.fonte').href = e.source;
    $('.conta').textContent = `${i + 1} / ${eventi.length}`;
    scheda.classList.remove('entra'); void scheda.offsetWidth; scheda.classList.add('entra');
  };

  // I filtri: si resta sull'evento più vicino all'anno di prima
  document.querySelectorAll<HTMLButtonElement>('.filtri button').forEach(b => b.addEventListener('click', () => {
    const anno = eventi[Math.round(indice())]?.year ?? 1943;
    tipo = b.dataset.tipo!;
    document.querySelectorAll<HTMLButtonElement>('.filtri button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    eventi = tipo === 'all' ? TUTTI : TUTTI.filter(e => e.kind === tipo);
    misura();
    let k = 0; eventi.forEach((e, j) => { if (Math.abs(e.year - anno) < Math.abs(eventi[k]!.year - anno)) k = j; });
    mostrato = -1;
    vai(k, false);
    scrivi();
  }));
  $('.prima').addEventListener('click', () => vai(Math.round(indice()) - 1));
  $('.dopo').addEventListener('click', () => vai(Math.round(indice()) + 1));
  window.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown' && e.altKey) { e.preventDefault(); vai(Math.round(indice()) + 1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); vai(Math.round(indice()) - 1); }
  });
  // Quando lo scorrimento si ferma, la barca si ferma su una boa
  let fermo = 0;
  window.addEventListener('scroll', () => { scrivi(); clearTimeout(fermo); fermo = window.setTimeout(() => { const i = indice(); if (Math.abs(i - Math.round(i)) > 0.04) vai(Math.round(i)); }, 220); }, { passive: true });
  window.addEventListener('resize', () => { misura(); scrivi(); });
  misura(); scrivi();

  monta(document.querySelector<HTMLCanvasElement>('.mare')!, { indice, eventi: () => eventi, boaX: () => (window.innerWidth < 760 ? 0.5 : 0.36) });
</script>

<style>
  .mare { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
  :global(.barra), :global(.piede) { position: relative; z-index: 2; }
  .timeline { position: relative; z-index: 1; pointer-events: none; }
  .testa { position: sticky; top: 0; padding-top: var(--s2); max-width: 520px; color: #f4f1ea; }
  h1 { margin: 0 0 6px; font-size: 33px; font-weight: 400; line-height: 1.1; }
  .sotto { margin: 0 0 12px; color: rgb(244 241 234 / .7); }
  .filtri { display: flex; flex-wrap: wrap; gap: 6px; pointer-events: auto; }
  .filtri button { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border: 1px solid rgb(244 241 234 / .3); border-radius: 999px; background: rgb(10 16 28 / .5); color: #f4f1ea; font: inherit; font-size: 12px; cursor: pointer; }
  .filtri button[aria-pressed='true'] { background: #f4f1ea; color: #121417; }
  .filtri i { width: 8px; height: 8px; border-radius: 50%; background: #f4f1ea; }
  .filtri .tipo-research { background: #5fb6d9; } .filtri .tipo-system { background: #f2c14e; } .filtri .tipo-company { background: #ff9fb4; } .filtri .tipo-society { background: #8fd6b4; }
  .binario { pointer-events: none; }
  /* La scheda dell'evento: a destra, ferma mentre la barca si muove */
  .scheda {
    position: fixed; right: 24px; top: 50%; z-index: 1; width: min(380px, 36vw); padding: 18px 20px 14px; transform: translateY(-50%);
    border-radius: 12px; background: rgb(244 241 234 / .96); color: #121417; box-shadow: 0 12px 34px rgb(0 0 0 / .35); pointer-events: auto;
  }
  .scheda.entra { animation: entra .45s cubic-bezier(.2, 1.3, .4, 1); }
  @keyframes entra { from { opacity: 0; transform: translateY(calc(-50% + 14px)); } }
  .scheda p { color: inherit; }
  .quando { margin: 0; font-size: 11px; letter-spacing: .04em; text-transform: uppercase; opacity: .7; }
  .quando::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; background: currentColor; vertical-align: 0; }
  .quando[data-tipo='research']::before { background: #5fb6d9; } .quando[data-tipo='system']::before { background: #f2c14e; } .quando[data-tipo='company']::before { background: #ff9fb4; } .quando[data-tipo='society']::before { background: #8fd6b4; }
  .titolo { margin: 8px 0 4px; font-size: 22px; font-weight: 400; line-height: 1.15; }
  .chi { margin: 0 0 10px; font-size: 12px; opacity: .7; }
  .testo { margin: 0; font-size: 14px; line-height: 1.55; }
  .sotto-scheda { display: flex; align-items: center; gap: 12px; margin-top: 14px; padding-top: 10px; border-top: 1px dashed rgb(18 20 23 / .3); font-size: 12px; }
  .fonte { color: inherit; }
  .conta { margin-left: auto; opacity: .6; }
  .frecce { display: inline-flex; gap: 4px; }
  .frecce button { width: 30px; height: 28px; border: 1px solid rgb(18 20 23 / .35); border-radius: 6px; background: transparent; color: inherit; cursor: pointer; }
  .frecce button:hover { background: rgb(18 20 23 / .08); }
  /* L'elenco completo resta per chi legge con uno screen reader */
  .tutti { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .scheda.entra { animation: none; } }
  @media (max-width: 760px) {
    .sotto { display: none; }
    .scheda { top: auto; bottom: calc(68px + env(safe-area-inset-bottom)); left: 12px; right: 12px; width: auto; transform: none; padding: 14px 16px 12px; }
    @keyframes entra { from { opacity: 0; transform: translateY(14px); } }
    .titolo { font-size: 19px; }
    .testo { font-size: 13px; }
    .frecce button { width: 40px; height: 36px; }
  }
</style>
