---
import Base from '../../layouts/Base.astro';

// Glossario: il reef da pesca a tutto schermo. I termini stanno in src/content/glossario
---
<Base title="Reef · Riccardo Mondi" description="Take a deep dive into the AI lexicon: fish the terms out of a reef, one at a time." tono="neutro" largo>
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="pesca">
    <h1>Reef</h1>
    <p class="sotto">Take a deep dive into the AI lexicon.</p>
    <p class="mono">Tap the water to cast. Answer to catch the term. Bigger fish, harder term.</p>
  </main>
</Base>

<script>
  import('../../scripts/barriera').then(m => m.monta(document.querySelector<HTMLElement>('.scena3d')!, { pesca: true }));
</script>

<style>
  .fondo3d { position: fixed; top: 64px; bottom: 0; left: 0; right: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; }
  .pesca { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s2); }
  .pesca a { pointer-events: auto; color: inherit; }
  .pesca > * { max-width: 420px; margin: 0 0 var(--s1); }
  h1 { font-size: 33px; font-weight: 400; line-height: 1.1; }
  .sotto { color: var(--muted); }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  /* Il biglietto: sopra alla scena, a destra; su telefono in fondo allo schermo */
  :global(.scheda-glossario) { position: fixed; top: 84px; right: 24px; z-index: 2; width: min(430px, 42vw); }
  :global(.scheda-glossario[hidden]) { display: none; }
  :global(.biglietto) { perspective: 1100px; }
  :global(.carta) {
    --rx: 0deg; --ry: 0deg; --lx: 50%; --tinta: #f7cf4f; --inchiostro: #121417;
    position: relative; display: grid; transform-style: preserve-3d; transition: transform .7s cubic-bezier(.3, 1.3, .5, 1);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
  }
  :global(.carta.girata) { transform: rotateX(var(--rx)) rotateY(calc(var(--ry) + 180deg)); }
  :global(.faccia) {
    grid-area: 1 / 1; position: relative; display: flex; min-height: 300px; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    color: var(--inchiostro); background: var(--tinta); border-radius: 10px; overflow: hidden;
    /* Le due tacche del biglietto, dove si stacca il tagliando */
    -webkit-mask: radial-gradient(circle 9px at calc(100% - 92px) 0, #0000 98%, #000) top / 100% 51% no-repeat, radial-gradient(circle 9px at calc(100% - 92px) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
    mask: radial-gradient(circle 9px at calc(100% - 92px) 0, #0000 98%, #000) top / 100% 51% no-repeat, radial-gradient(circle 9px at calc(100% - 92px) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
  }
  /* Il riflesso: una striscia chiara che segue il puntatore */
  :global(.faccia)::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(105deg, transparent calc(var(--lx) - 22%), rgb(255 255 255 / .22) var(--lx), transparent calc(var(--lx) + 22%)); mix-blend-mode: soft-light; }
  :global(.retro) { transform: rotateY(180deg); flex-direction: column; padding: 18px 20px 16px; -webkit-mask: none; mask: none; }
  :global(.corpo-biglietto) { position: relative; flex: 1; min-width: 0; padding: 18px 18px 16px 20px; }
  :global(.biglietto .mono) { font-family: var(--mono); }
  :global(.biglietto .testa), :global(.biglietto .gruppo) { position: relative; margin: 0; font-size: 11px; letter-spacing: .04em; text-transform: uppercase; }
  :global(.biglietto .gruppo) { margin-top: 2px; }
  :global(.biglietto .termine) { position: relative; margin: 14px 0 8px; font-family: var(--mono); font-size: 26px; font-weight: 400; line-height: 1.05; text-transform: uppercase; overflow-wrap: anywhere; }
  :global(.biglietto .domanda) { position: relative; margin: 0 0 12px; font-size: 14px; line-height: 1.4; }
  /* Il retino: puntini nell'inchiostro, come una stampa */
  :global(.retino) { position: absolute; right: -40px; top: -30px; width: 190px; height: 190px; border-radius: 50%; background: radial-gradient(circle, var(--inchiostro) 1.3px, transparent 1.7px) 0 0 / 7px 7px; opacity: .1; }
  :global(.opzioni) { position: relative; display: grid; gap: 6px; }
  :global(.biglietto .opzione) {
    display: flex; gap: 10px; align-items: baseline; width: 100%; min-height: 42px; padding: 9px 11px; border: 1.5px solid var(--inchiostro); border-radius: 6px;
    background: transparent; color: var(--inchiostro); font-size: 13px; line-height: 1.3; text-align: left; cursor: pointer; transition: background .15s, transform .15s;
  }
  :global(.biglietto .opzione span) { flex: none; opacity: .6; }
  :global(.biglietto .opzione:hover:not(:disabled)) { background: color-mix(in srgb, var(--inchiostro) 12%, transparent); transform: translateX(2px); }
  :global(.biglietto .opzione:disabled) { cursor: default; opacity: .55; }
  :global(.biglietto .opzione.giusta) { opacity: 1; background: var(--inchiostro); color: var(--tinta); }
  :global(.biglietto .opzione.sbagliata) { opacity: 1; text-decoration: line-through; }
  /* Il tagliando, dietro una linea tratteggiata: si stacca quando indovini */
  :global(.tagliando) {
    flex: none; display: flex; flex-direction: column; justify-content: space-between; align-items: center; width: 92px; padding: 16px 0;
    border-left: 2px dashed color-mix(in srgb, var(--inchiostro) 45%, transparent); writing-mode: vertical-rl;
    transition: transform .9s cubic-bezier(.5, 0, .7, 1) .55s, opacity .5s linear .9s; transform-origin: 0 100%;
  }
  :global(.tagliando p) { margin: 0; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  :global(.tagliando .numero) { font-size: 22px; letter-spacing: 0; }
  :global(.carta.strappato .tagliando) { transform: translate(26px, 46px) rotate(16deg); opacity: 0; }
  /* Dietro: una grafica grande a retino con il numero, la definizione e un codice a barre */
  :global(.grafica) { position: relative; height: 92px; margin: -18px -20px 10px; overflow: hidden; border-bottom: 2px dashed color-mix(in srgb, var(--inchiostro) 40%, transparent); }
  :global(.grafica .cerchio) { position: absolute; left: -30px; top: -70px; width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle, var(--inchiostro) 1.6px, transparent 2px) 0 0 / 8px 8px; opacity: .3; }
  :global(.grafica .cerchio)::after { content: ''; position: absolute; left: 150px; top: 40px; width: 110px; height: 110px; border-radius: 50%; border: 2px solid var(--inchiostro); }
  :global(.grafica .grande) { position: absolute; right: 14px; bottom: -8px; margin: 0; font-size: 84px; line-height: 1; opacity: .9; }
  :global(.biglietto .esito) { margin: 0 0 2px; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  :global(.retro .termine) { margin-top: 2px; }
  :global(.definizione) { flex: 1; max-height: min(44vh, 360px); overflow-y: auto; font-size: 13px; line-height: 1.6; touch-action: pan-y; }
  :global(.definizione p) { margin: 0 0 8px; }
  :global(.definizione ul) { margin: 0 0 8px; padding-left: 18px; }
  :global(.definizione li) { margin-bottom: 5px; }
  :global(.definizione strong) { font-weight: 400; text-decoration: underline; text-underline-offset: 2px; }
  :global(.piede-biglietto) { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-top: 10px; padding-top: 10px; border-top: 2px dashed color-mix(in srgb, var(--inchiostro) 40%, transparent); }
  :global(.codice) { display: flex; height: 28px; }
  :global(.codice span) { display: block; height: 100%; background: var(--inchiostro); }
  :global(.seriale) { margin: 0; font-size: 10px; text-transform: uppercase; opacity: .75; }
  /* Il bottone per rilasciare il pesce, sotto il biglietto */
  :global(.scheda-glossario .rilascia) { display: block; margin: 10px 0 0 auto; padding: 4px 12px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); cursor: pointer; }
  :global(.scheda-glossario .rilascia:hover) { color: var(--fg); border-color: var(--muted); }
  :global(.scheda-glossario .rilascia[hidden]) { display: none; }
  @media (prefers-reduced-motion: reduce) { :global(.carta), :global(.tagliando) { transition: none; } }
  :global(body:has(.scheda-glossario:not([hidden])) .piede) { visibility: hidden; }
  :global(.conta-pesca) { position: fixed; right: 24px; bottom: 16px; z-index: 2; margin: 0; pointer-events: none; }
  @media (max-width: 640px) {
    .fondo3d { top: 220px; }
    /* Su telefono il biglietto sta in fondo allo schermo, largo quasi quanto lo schermo */
    :global(.scheda-glossario) { top: auto; left: 12px; right: 12px; bottom: calc(10px + env(safe-area-inset-bottom)); width: auto; }
    :global(.faccia) { min-height: 0; }
    :global(.tagliando) { width: 64px; }
    :global(.faccia:not(.retro)) { -webkit-mask: radial-gradient(circle 8px at calc(100% - 64px) 0, #0000 98%, #000) top / 100% 51% no-repeat, radial-gradient(circle 8px at calc(100% - 64px) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat; mask: radial-gradient(circle 8px at calc(100% - 64px) 0, #0000 98%, #000) top / 100% 51% no-repeat, radial-gradient(circle 8px at calc(100% - 64px) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat; }
    :global(.biglietto .termine) { font-size: 21px; margin-top: 10px; }
    :global(.biglietto .opzione) { min-height: 46px; font-size: 14px; }
    :global(.definizione) { max-height: 38vh; }
    :global(.grafica) { height: 70px; }
    :global(.grafica .grande) { font-size: 64px; }
    :global(.scheda-glossario .rilascia) { width: 100%; min-height: 44px; }
    :global(.conta-pesca) { right: 16px; bottom: auto; top: 288px; }
  }
</style>
