---
import Base from '../../layouts/Base.astro';

// Glossario: il reef da pesca a tutto schermo. I termini stanno in src/content/glossario
---
<Base title="AI terms · Riccardo Mondi" description="Take a deep dive into the AI lexicon: fish the terms out of a reef, one at a time." tono="neutro" largo>
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="pesca">
    <h1>AI terms</h1>
    <p class="sotto">Take a deep dive into the AI lexicon.</p>
    <p class="mono">Tap the water to cast. Answer to catch the term. Bigger fish, harder term.</p>
  </main>
</Base>

<script>
  import('../../scripts/barriera').then(m => m.monta(document.querySelector<HTMLElement>('.scena3d')!, { pesca: true }));
</script>

<style>
  .fondo3d { position: fixed; top: 64px; bottom: 0; left: 0; right: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; }
  .pesca { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s2); }
  .pesca a { pointer-events: auto; color: inherit; }
  .pesca > * { max-width: 420px; margin: 0 0 var(--s1); }
  h1 { font-size: 33px; font-weight: 400; line-height: 1.1; }
  .sotto { color: var(--muted); }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  /* Scheda con la definizione intera: sopra alla scena, il testo lungo scorre al suo interno */
  :global(.scheda-glossario) {
    position: fixed; top: 88px; right: 24px; bottom: 64px; z-index: 2; width: min(400px, 40vw); height: fit-content; max-height: calc(100vh - 152px);
    overflow-y: auto; padding: var(--s2); border: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 94%, transparent);
    font-size: 13px; line-height: 1.65; color: var(--muted); touch-action: pan-y;
  }
  :global(.scheda-glossario[hidden]) { display: none; }
  :global(.scheda-glossario h2) { margin: 4px 0 var(--s1); font-size: 18px; font-weight: 400; line-height: 1.2; color: var(--fg); }
  :global(.scheda-glossario p) { margin: 0 0 var(--s1); }
  :global(.scheda-glossario ul) { margin: 0 0 var(--s1); padding-left: 18px; }
  :global(.scheda-glossario li) { margin-bottom: 6px; }
  :global(.scheda-glossario strong) { font-weight: 400; color: var(--fg); }
  /* Il bottone resta sempre visibile, anche mentre il testo lungo scorre */
  :global(.scheda-glossario button) { position: sticky; bottom: 0; padding: 2px 10px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); cursor: pointer; }
  :global(.scheda-glossario button:hover) { color: var(--fg); border-color: var(--muted); }
  :global(.scheda-glossario .opzione) { position: static; display: flex; gap: 10px; align-items: baseline; width: 100%; min-height: 44px; margin: 0 0 6px; padding: 10px 12px; font-size: 13px; text-align: left; color: var(--fg); line-height: 1.35; transition: border-color .12s, background .12s; }
  :global(.scheda-glossario .opzione span) { flex: none; color: var(--muted); }
  :global(.scheda-glossario .opzione:hover:not(:disabled)) { border-color: var(--fg); color: var(--fg); }
  :global(.scheda-glossario .opzione:disabled) { cursor: default; color: var(--muted); }
  :global(.scheda-glossario .opzione.giusta) { border-color: var(--verde); background: color-mix(in srgb, var(--verde) 16%, var(--bg)); color: var(--fg); }
  :global(.scheda-glossario .opzione.sbagliata) { border-color: var(--arancio); background: color-mix(in srgb, var(--arancio) 16%, var(--bg)); color: var(--fg); }
  :global(.scheda-glossario .esito) { margin: 0 0 var(--s1); color: var(--arancio); }
  :global(.scheda-glossario .esito.giusto) { color: var(--verde); }
  :global(.scheda-glossario button[hidden]) { display: none; }
  :global(body:has(.scheda-glossario:not([hidden])) .piede) { visibility: hidden; }
  :global(.conta-pesca) { position: fixed; right: 24px; bottom: 16px; z-index: 2; margin: 0; pointer-events: none; }
  @media (max-width: 640px) {
    .fondo3d { top: 220px; }
    /* Su telefono la scheda sta in fondo allo schermo, e scorre col dito */
    :global(.scheda-glossario) { top: auto; left: 0; right: 0; bottom: 0; width: auto; max-height: 56vh; padding: var(--s2) 16px calc(var(--s2) + env(safe-area-inset-bottom)); border-width: 1px 0 0; font-size: 14px; }
    :global(.scheda-glossario h2) { font-size: 17px; }
    :global(.scheda-glossario .opzione) { min-height: 48px; font-size: 14px; }
    :global(.scheda-glossario > button) { width: 100%; min-height: 44px; }
    :global(.conta-pesca) { right: 16px; bottom: auto; top: 288px; }
  }
</style>
