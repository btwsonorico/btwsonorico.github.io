---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Gioco della timeline: si pescano 7 eventi della storia dell'AI nel reef (src/scripts/barriera.ts, opzione gioco) e si mettono
// in ordine. Il primo pesce va sulla linea da solo; ogni pesce dopo va prima, dopo o in mezzo a quelli già messi. Poi la data
// si scopre. Gli eventi sono gli stessi della AI timeline (src/content/timeline), con le stesse schede: data, tipo e titolo sulla
// linea; il pesce all'amo è la scheda aperta, con il perché e chi, senza data. La logica è in src/scripts/giocoTimeline.ts.
const TIPI: Record<string, string> = { idea: 'ideas', model: 'models', world: 'world' };
const MESI = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const eventi = (await getCollection('timeline', e => !e.data.draft)).map(e => ({
  id: e.id, titolo: e.data.title, chi: e.data.who ?? '', anno: e.data.year, kind: e.data.kind, tipo: TIPI[e.data.kind] ?? e.data.kind, perche: e.data.perche ?? '',
  data: e.data.month ? `${MESI[e.data.month - 1]} ${e.data.year}` : String(e.data.year),
  t: e.data.year + ((e.data.month ?? 6.5) - 0.5) / 12,
}));
---
<Base title="Timeline game · Riccardo Mondi" description="Fish seven moments of AI history out of a reef and put them in the right order." tono="neutro" largo>
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="gioco" data-eventi={JSON.stringify(eventi)}>
    <header class="testa">
      <h1>Timeline game</h1>
      <p class="sotto">Fish seven moments of AI history and put them in order.</p>
      <p class="mono stato" aria-live="polite">Tap the water to cast.</p>
      <div class="mono punteggio" aria-label="Score"></div>
    </header>

    <!-- Il pesce appena preso: titolo e chi, senza data -->
    <!-- La scheda della timeline, aperta, con la data nascosta -->
    <section class="preso" hidden aria-live="polite">
      <div class="corpo">
        <!-- Il pesce appeso all'amo: la lenza sale dalla scheda, il pesce si dimena -->
        <span class="amo" aria-hidden="true"><span class="lenza"></span><svg class="pesce" viewBox="0 0 40 22" aria-hidden="true"><path d="M3 11c5-8 17-10 25-3l9-6v18l-9-6c-8 7-20 5-25-3z"/><circle cx="11" cy="9.5" r="1.8"/></svg></span>
        <p class="mono riga"><span>on the hook · ????</span><span class="tipo-k"></span></p>
        <h2 class="titolo"></h2>
        <p class="perche"></p>
        <p class="chi"></p>
        <p class="mono aiuto">Where does it go? Drag this card into your line, or tap a gap.</p>
      </div>
    </section>

    <!-- La linea: gli eventi già messi, in ordine; fra uno e l'altro, quando c'è un pesce all'amo, i posti dove metterlo -->
    <div class="striscia">
      <ol class="linea" aria-label="Your timeline, from oldest to newest"></ol>
    </div>

    <!-- La fine partita e la pausa: le carte arcade di AI terms (src/pages/learn/airport.astro) -->
    <section class="fine" hidden aria-live="polite">
      <div class="fine-carta" role="dialog" aria-labelledby="fine-titolo">
        <button type="button" class="mono fine-chiudi" aria-label="close">✕</button>
        <p class="mono fine-titolo" id="fine-titolo">Line complete</p>
        <p class="mono fine-punti"><small>in the right place</small><b class="fine-numero">0/6</b></p>
        <dl class="mono fine-dati">
          <div><dt>right</dt><dd class="fine-giuste">0</dd></div>
          <div><dt>best streak</dt><dd class="fine-serie">0</dd></div>
        </dl>
        <p class="commento"></p>
        <button type="button" class="mono grande ancora">Fish again 🎣</button>
        <button type="button" class="mono copia">copy result</button>
        <a class="mono vedi" href="/learn/timeline/">read the whole AI timeline →</a>
      </div>
    </section>
    <div class="pausa-menu" hidden>
      <div class="fine-carta" role="dialog" aria-labelledby="pausa-titolo">
        <p class="mono fine-titolo pausa-titolo" id="pausa-titolo">Paused</p>
        <button type="button" class="mono grande riprendi">Resume 🎣</button>
        <button type="button" class="mono ricomincia">new game</button>
      </div>
    </div>
  </main>
</Base>

<script>
  import { monta } from '../../scripts/giocoTimeline';
  monta(document.querySelector<HTMLElement>('.gioco')!, document.querySelector<HTMLElement>('.scena3d')!);
</script>

<style>
  .fondo3d { position: fixed; top: 64px; bottom: 0; left: 0; right: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  :global(.piede) { visibility: hidden; }
  .gioco { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s2); min-height: calc(100vh - 140px); }
  .gioco button, .gioco a, .preso, .fine, .striscia { pointer-events: auto; }
  .testa > * { max-width: 440px; margin: 0 0 var(--s1); }
  h1 { font-size: 33px; font-weight: 400; line-height: 1.1; }
  .sotto { color: var(--muted); }
  .stato { color: var(--fg); font-size: 13px; }

  /* Le schede sono quelle della AI timeline (src/pages/learn/timeline.astro): bordo sottile, riga con data e tipo, titolo */
  .gioco { --c-idea: var(--azzurro); --c-model: var(--verde); --c-world: var(--arancio); }
  .gioco :global([data-kind="idea"]) { --k: var(--c-idea); }
  .gioco :global([data-kind="model"]) { --k: var(--c-model); }
  .gioco :global([data-kind="world"]) { --k: var(--c-world); }
  .gioco :global(.corpo) { position: relative; box-sizing: border-box; padding: 11px 14px; border: 1px solid var(--line); background: var(--bg); transition: border-color .35s; }
  .gioco :global(.riga) { display: flex; justify-content: space-between; gap: 8px; margin: 0 0 6px; font-size: 11px; color: var(--muted); }
  .gioco :global(.tipo-k) { color: var(--muted); }
  .gioco :global(.tipo-k)::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--k); vertical-align: 1px; }
  .gioco :global(.corpo h2) { margin: 0; font-size: 16px; font-weight: 400; line-height: 1.3; color: var(--fg); }
  .perche { margin: 8px 0 10px; font-size: 14px; line-height: 1.4; color: var(--fg); }
  .chi { margin: 0 0 4px; font-size: 12px; color: var(--muted); }
  .aiuto { margin: 10px 0 0; font-size: 11px; color: var(--muted); }
  /* Il pesce della scheda, nel colore del tipo di evento: appeso all'amo sulla scheda presa, piccolo accanto alla data sulla linea */
  .gioco :global(.pesce) { display: inline-block; width: 22px; height: 12px; fill: var(--k, var(--muted)); vertical-align: -1px; }
  .gioco :global(.pesce circle) { fill: var(--bg); }
  .gioco :global(.riga .pesce) { margin-right: 6px; }
  /* Sulla linea il pesce prende il posto del pallino del tipo; data e tipo restano su una riga */
  .linea :global(.riga span) { white-space: nowrap; }
  .linea :global(.tipo-k)::before { display: none; }
  .gioco :global(.nuova .riga .pesce) { animation: nuota .9s ease-out; }
  .amo { position: absolute; top: -78px; right: 46px; width: 1px; pointer-events: none; }
  .lenza { display: block; width: 1px; height: 26px; background: var(--muted); }
  /* La bocca del pesce sta in fondo alla lenza; il corpo pende in giù e si dimena */
  .amo .pesce { position: absolute; left: -4px; top: 12px; width: 52px; height: 28px; transform-origin: 4px 14px; transform: rotate(90deg); animation: dimena 1.1s ease-in-out infinite; }
  .preso { margin-top: 30px; }
  @keyframes dimena { 0%, 100% { transform: rotate(78deg); } 50% { transform: rotate(102deg); } }
  @keyframes nuota { 0% { transform: translateX(-16px) scaleX(1); opacity: 0; } 60% { transform: translateX(3px); opacity: 1; } }

  /* Il pesce all'amo: la scheda aperta a destra; su telefono sopra la linea */
  .preso { position: fixed; top: 96px; right: 24px; z-index: 2; width: min(420px, 40vw); animation: entra .45s cubic-bezier(.3, 1.4, .5, 1); }
  .preso .corpo { border-color: var(--muted); cursor: grab; touch-action: none; user-select: none; }
  .preso.in-volo .corpo { opacity: .35; }
  .preso[hidden] { display: none; }
  /* La scheda mentre la trascini: segue il dito, un po' inclinata */
  .gioco :global(.corpo.fantasma) { position: fixed; z-index: 9; width: 220px; pointer-events: none; transform: translate(-50%, -60%) rotate(-3deg); box-shadow: 0 12px 30px rgb(0 0 0 / .35); }

  /* Il punteggio come in AI terms: riquadri a bordo doppio, etichetta piccola sopra e numero grande sotto */
  .punteggio { display: flex; flex-wrap: wrap; gap: 8px; max-width: 440px; }
  .punteggio:empty { display: none; }
  .punteggio :global(.hud) { display: flex; flex-direction: column; gap: 2px; min-width: 76px; padding: 6px 10px 8px; border: 2px solid var(--fg); box-shadow: inset 0 0 0 2px var(--bg), inset 0 0 0 3px var(--line); background: color-mix(in srgb, var(--bg) 80%, transparent); }
  .punteggio :global(.hud small) { font-size: 9px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .punteggio :global(.hud b) { font-weight: 400; font-size: 26px; line-height: 1; color: var(--fg); }
  .punteggio :global(.hud-giuste b) { color: #ffd84a; text-shadow: 3px 3px 0 #a3561a; }
  .punteggio :global(.hud-serie.attiva) { border-color: #6fe3ff; }
  .punteggio :global(.hud-serie.attiva b) { color: #6fe3ff; }

  /* La fine partita e la pausa: una carta arcade al centro, sopra la scena */
  .fine[hidden], .pausa-menu[hidden] { display: none !important; }
  .fine:not([hidden]), .pausa-menu:not([hidden]) { position: fixed; inset: 0; z-index: 7; display: grid; place-items: center; padding: 20px; background: color-mix(in srgb, var(--bg) 55%, transparent); backdrop-filter: blur(3px); animation: appare .35s ease-out; }
  @keyframes appare { from { opacity: 0; } }
  .fine-carta { position: relative; width: min(360px, 100%); display: grid; gap: 12px; padding: 22px 20px; border: 2px solid var(--fg); box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 4px var(--line), 6px 6px 0 color-mix(in srgb, var(--fg) 25%, transparent); background: var(--bg); text-align: center; }
  .fine-carta > * { margin: 0; }
  .fine-carta button { width: 100%; padding: 8px 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg); color: var(--fg); font: 13px var(--mono); cursor: pointer; }
  .fine-carta button:hover { border-color: var(--fg); }
  .fine-carta button.grande { padding: 14px; border: 0; background: var(--fg); color: var(--bg); font-size: 18px; }
  .fine-carta .fine-chiudi { position: absolute; top: 8px; right: 8px; width: 34px; height: 34px; padding: 0; font-size: 16px; }
  .fine-titolo { font-size: 26px; letter-spacing: .08em; text-transform: uppercase; color: #ff5a6e; }
  .pausa-titolo { color: var(--fg); }
  .fine-punti { display: grid; gap: 2px; }
  .fine-punti small { font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); }
  .fine-punti b { font-weight: 400; font-size: 64px; line-height: 1; color: #ffd84a; text-shadow: 4px 4px 0 #a3561a; }
  .fine-dati { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; }
  .fine-dati div { padding: 6px 4px; border: 1px solid var(--line); }
  .fine-dati dt { font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .fine-dati dd { margin: 2px 0 0; font-size: 22px; }
  .commento { font-size: 13px; line-height: 1.4; color: var(--muted); }
  :global(.tasto-pausa) { padding: 0 8px; border: 1px solid var(--line); background: none; color: var(--fg); font: inherit; cursor: pointer; margin-right: 8px; }
  :global(.tasto-pausa[hidden]) { display: none; }
  .vedi { color: var(--fg); font-size: 12px; }

  /* La linea in basso: le carte degli eventi in fila, dalla più vecchia alla più nuova; scorre di lato se non entra */
  .striscia { position: fixed; left: 0; right: 0; bottom: 0; z-index: 2; padding: 12px 24px calc(62px + env(safe-area-inset-bottom)); background: linear-gradient(transparent, var(--bg) 30%); overflow-x: auto; overscroll-behavior-x: contain; }
  .linea { display: flex; align-items: stretch; gap: 6px; width: max-content; min-width: 100%; justify-content: center; margin: 0; padding: 0; list-style: none; }
  .linea > :global(li) { display: flex; }
  .linea :global(.corpo) { width: 168px; }
  .linea :global(.giusta .corpo) { border-color: var(--verde); }
  .linea :global(.sbagliata .corpo) { border-color: var(--arancio); }
  .linea :global(.nuova) { animation: entra .5s cubic-bezier(.3, 1.4, .5, 1); }
  .linea :global(.nuova.sbagliata) { animation: entra .5s cubic-bezier(.3, 1.4, .5, 1), scuoti .5s .5s; }
  .linea :global(.nota) { font-family: var(--mono); font-size: 10px; color: var(--arancio); }
  /* Il posto dove mettere il pesce: una fessura sottile fra le schede. Trascinando la scheda le fessure si vedono meglio, e
     quella sotto il dito si apre larga quanto una scheda: lì il pesce può andare */
  .linea :global(.posto) { width: 12px; padding: 0; border: 1px dashed color-mix(in srgb, var(--muted) 70%, transparent); background: none; cursor: pointer; transition: width .22s cubic-bezier(.3, 1.3, .5, 1), background .15s, border-color .15s; }
  .linea :global(.posto:hover), .linea :global(.posto:focus-visible) { width: 22px; border-color: var(--fg); outline: none; }
  .linea.trascino :global(.posto) { width: 18px; border-color: var(--fg); }
  .linea :global(.posto.sopra), .linea.trascino :global(.posto.sopra) { width: 150px; border-style: solid; border-color: var(--fg); background: color-mix(in srgb, var(--fg) 10%, transparent); }
  @keyframes entra { from { transform: translateY(14px) scale(.9); opacity: 0; } }
  @keyframes scuoti { 25% { transform: translateX(-5px); } 50% { transform: translateX(5px); } 75% { transform: translateX(-3px); } }
  @media (prefers-reduced-motion: reduce) { .preso, .fine, .pausa-menu, .linea :global(.nuova), .gioco :global(.pesce) { animation: none !important; } }

  @media (max-width: 640px) {
    .fondo3d { top: 200px; }
    .gioco { min-height: 0; }
    h1 { font-size: 26px; }
    .preso { top: auto; left: 12px; right: 12px; bottom: calc(196px + env(safe-area-inset-bottom)); width: auto; }
    .punteggio :global(.hud) { min-width: 64px; padding: 4px 8px 6px; }
    .punteggio :global(.hud b) { font-size: 20px; }
    .perche { font-size: 13px; margin: 6px 0; }
    .striscia { padding: 10px 12px calc(58px + env(safe-area-inset-bottom)); }
    .linea { justify-content: flex-start; }
    .linea :global(.corpo) { width: 150px; padding: 9px 11px; }
    .linea :global(.corpo h2) { font-size: 14px; }
    .linea :global(.posto) { width: 16px; }
    .linea :global(.posto.sopra), .linea.trascino :global(.posto.sopra) { width: 120px; }
  }
</style>
