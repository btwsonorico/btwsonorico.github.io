---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { simbolo } from '../../lib/simboliTimeline';

// AI timeline: la storia dell'AI su una linea del tempo, nello stile di Knowledge. Su computer lo scroll verso il basso fa
// scorrere la linea verso destra; ogni punto ha la sua scheda (e, se è un evento essenziale, il suo simbolo a filo) che segue
// lo scroll con un po' di ritardo. Su telefono la linea diventa verticale. Gli eventi sono note in src/content/timeline;
// il movimento e i controlli sono in src/scripts/timelineVista.ts.
const MESI = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const TIPI: Record<string, string> = { research: 'research', system: 'systems', company: 'companies', society: 'society' };
const eventi = (await getCollection('timeline', e => !e.data.draft))
  .sort((a, b) => a.data.year - b.data.year || (a.data.month ?? 6.5) - (b.data.month ?? 6.5))
  .map(e => ({
    id: e.id, ...e.data, testo: (e.body ?? '').trim(),
    data: e.data.month ? `${MESI[e.data.month - 1]} ${e.data.year}` : String(e.data.year),
    // Posizione nel tempo: l'anno più la metà del mese (o metà anno se il mese non c'è)
    t: e.data.year + ((e.data.month ?? 6.5) - 0.5) / 12,
    svg: simbolo(e.data.simbolo),
  }));
const daControllare = eventi.filter(e => !e.checked).length;
const datiJs = eventi.map(e => ({ t: e.t, k: e.kind, p: e.peso, s: !!e.svg }));
const ora = new Date(), oggi = ora.getFullYear() + ora.getMonth() / 12;
---
<Base title="AI timeline · Riccardo Mondi" description="The history of artificial intelligence on one line, from the first artificial neuron to today. Filter by kind, choose the level of detail, zoom from decades to months." tono="neutro" largo>
  <main class="tl" data-eventi={JSON.stringify(datiJs)} data-oggi={oggi}>
    <header class="testa">
      <h1>AI timeline</h1>
      <p>From the first artificial neuron to today, in {eventi.length} events. <span class="solo-pc">Scroll to travel in time.</span></p>
      <p class="mono bozza">{daControllare ? `${daControllare} of ${eventi.length} events are drafts: dates and facts are being checked.` : 'All events checked.'}</p>
    </header>

    <!-- Computer: la linea orizzontale. La pista è alta quanto la linea è lunga; dentro, il palco resta fermo sullo schermo -->
    <div class="pista" aria-label="AI timeline, horizontal">
      <div class="palco">
        <div class="mondo">
          <svg class="asse" aria-hidden="true"></svg>
          {eventi.map((e, i) => <button type="button" class="punto" data-i={i} data-peso={e.peso} aria-label={`${e.data}: ${e.title}`}></button>)}
        </div>
        <div class="cursore" aria-hidden="true"><span class="mono quando"></span></div>
        {eventi.map((e, i) => (
          <article class="scheda" data-i={i} data-peso={e.peso}>
            <p class="mono riga"><span>{e.data}</span><span>{TIPI[e.kind]}</span></p>
            <h2>{e.title}</h2>
            <p class="chi">{e.who}</p>
            <p class="testo">{e.testo}</p>
            <a class="mono fonte" href={e.source} target="_blank" rel="noopener">source ↗</a>
          </article>
        ))}
        {eventi.map((e, i) => e.svg && <figure class="scheda-simbolo" data-i={i} set:html={e.svg} />)}
        <span class="stelo" aria-hidden="true"></span>
      </div>
    </div>

    <!-- Telefono: la stessa storia su una linea verticale -->
    <ol class="verticale">
      {eventi.map((e, i) => (
        <li data-i={i} data-peso={e.peso} data-kind={e.kind}>
          <span class="punto-v" aria-hidden="true"></span>
          <article class="scheda-v">
            <p class="mono riga"><span>{e.data}</span><span>{TIPI[e.kind]}</span></p>
            <h2>{e.title}</h2>
            <p class="chi">{e.who}</p>
            <p class="testo">{e.testo}</p>
            <a class="mono fonte" href={e.source} target="_blank" rel="noopener">source ↗</a>
            {e.svg && <figure class="simbolo-v" set:html={e.svg} />}
          </article>
        </li>
      ))}
    </ol>

    <section class="fine">
      <p>Each event is a short note with its source. The essential view keeps twelve turning points; the full view adds companies, smaller steps and debates. Most notes are still drafts: if you spot a wrong date or name, <a href="mailto:rmondi99@gmail.com">tell me</a>.</p>
    </section>

    <!-- La barra in basso: tipi, livello di dettaglio, scala del tempo, e la minimappa con la densità degli eventi -->
    <nav class="controlli mono" aria-label="Timeline controls">
      <canvas class="densita" aria-label="Events per year. Click to jump to a year"></canvas>
      <div class="righe">
        <div class="gruppo" role="group" aria-label="Kinds of event">
          {Object.entries(TIPI).map(([k, nome]) => <button type="button" class="tipo" data-kind={k} aria-pressed="true">{nome}</button>)}
        </div>
        <div class="gruppo" role="group" aria-label="Level of detail">
          <button type="button" data-livello="1" aria-pressed="false">essential</button>
          <button type="button" data-livello="2" aria-pressed="true">standard</button>
          <button type="button" data-livello="3" aria-pressed="false">all</button>
        </div>
        <div class="gruppo solo-pc" role="group" aria-label="Time scale">
          <button type="button" data-scala="decades" aria-pressed="false">decades</button>
          <button type="button" data-scala="years" aria-pressed="true">years</button>
          <button type="button" data-scala="months" aria-pressed="false">months</button>
        </div>
      </div>
    </nav>
  </main>
</Base>

<script>
  import { monta } from '../../scripts/timelineVista';
  monta(document.querySelector<HTMLElement>('.tl')!);
</script>

<style>
  .tl { padding: 4px 24px 0; }
  .testa { max-width: 620px; padding-bottom: var(--s2); }
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); }
  .bozza { margin-top: 6px !important; font-size: 11px; }

  /* --- Computer: la pista e il palco fermo */
  .pista { position: relative; }
  .palco { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .mondo { position: absolute; left: 0; top: 0; height: 100%; will-change: transform; }
  .asse { position: absolute; left: 0; top: 0; height: 100%; overflow: visible; pointer-events: none; }
  .asse :global(.linea) { stroke: var(--fg); stroke-width: 1; }
  .asse :global(.tacca) { stroke: var(--line); stroke-width: 1; }
  .asse :global(.tacca.decennio) { stroke: var(--muted); }
  .asse :global(text) { fill: var(--muted); font-family: var(--mono); font-size: 11px; }
  .asse :global(text.decennio) { fill: var(--fg); }
  .asse :global(.oggi) { stroke: var(--fg); stroke-dasharray: 2 3; }
  .punto { position: absolute; top: 0; width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; padding: 0; border: 1px solid var(--fg); border-radius: 50%; background: var(--bg); cursor: pointer; transition: background .2s, transform .2s; }
  .punto[data-peso="1"] { width: 13px; height: 13px; margin: -6.5px 0 0 -6.5px; }
  .punto:hover, .punto.attivo { background: var(--fg); transform: scale(1.25); }
  .punto[hidden] { display: none; }
  .cursore { position: absolute; left: 50%; top: 0; bottom: 0; width: 0; border-left: 1px dashed var(--line); pointer-events: none; }
  .quando { position: absolute; left: 8px; font-size: 11px; color: var(--fg); white-space: nowrap; }
  .scheda, .scheda-simbolo { position: absolute; left: 0; top: 0; margin: 0; transform-origin: 50% 100%; will-change: transform, opacity; visibility: hidden; }
  .scheda { width: 260px; padding: 12px 14px; border: 1px solid var(--line); background: var(--bg); }
  .scheda.attiva { border-color: var(--fg); }
  .scheda-simbolo { width: 150px; padding: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--fg); transform-origin: 50% 0; }
  .riga { display: flex; justify-content: space-between; gap: 8px; margin: 0 0 6px; font-size: 11px; color: var(--muted); }
  .scheda h2, .scheda-v h2 { margin: 0 0 4px; font-size: 15px; font-weight: 400; line-height: 1.3; color: var(--fg); }
  .chi { margin: 0 0 6px; font-size: 12px; color: var(--muted); }
  .testo { margin: 0 0 8px; font-size: 13px; line-height: 1.5; color: var(--fg); }
  .fonte { font-size: 11px; color: var(--muted); }
  .fonte:hover { color: var(--fg); }
  .stelo { position: absolute; left: 0; top: 0; width: 0; border-left: 1px solid var(--line); pointer-events: none; }

  /* I simboli si disegnano: ogni linea ha lunghezza 1, il trattino scorre da 1 a 0 */
  .tl :global(.simbolo) { display: block; width: 100%; height: auto; }
  .tl :global(.simbolo *) { stroke-dasharray: 1 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s ease-out; }
  .tl :global(.disegnato .simbolo *) { stroke-dashoffset: 0; }
  .tl :global(.simbolo .tenue) { opacity: .45; }
  .tl :global(.simbolo .pieno) { fill: currentColor; }
  .tl :global(.simbolo .pieno-tenue) { fill: currentColor; fill-opacity: .22; }
  .tl :global(.disegnato .simbolo .tratteggio) { stroke-dasharray: .04 .035; }

  /* --- Telefono: la linea verticale, nascosta su computer */
  .verticale { display: none; }

  .fine { max-width: 620px; padding: var(--s3) 0 160px; color: var(--muted); font-size: 13px; line-height: 1.6; }

  /* --- La barra in basso */
  .controlli { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; padding: 6px 24px 10px; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(6px); font-size: 12px; }
  .densita { display: block; width: 100%; height: 26px; cursor: pointer; }
  .righe { display: flex; flex-wrap: wrap; gap: 6px 24px; margin-top: 6px; }
  .gruppo { display: flex; flex-wrap: wrap; gap: 4px; }
  .gruppo button { padding: 3px 9px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; }
  .gruppo button:hover { border-color: var(--fg); color: var(--fg); }
  .gruppo button[aria-pressed="true"] { border-color: var(--fg); color: var(--fg); }

  @media (max-width: 700px) {
    .tl { padding: 0 16px; }
    h1 { font-size: 26px; }
    .solo-pc { display: none !important; }
    .pista { display: none; }
    .verticale { display: block; position: relative; margin: var(--s2) 0 0; padding: 0 0 0 22px; list-style: none; border-left: 1px solid var(--fg); margin-left: 6px; }
    .verticale li { position: relative; margin: 0 0 var(--s3); }
    .verticale li[hidden] { display: none; }
    .punto-v { position: absolute; left: -28.5px; top: 4px; width: 11px; height: 11px; border: 1px solid var(--fg); border-radius: 50%; background: var(--bg); }
    .verticale li[data-peso="1"] .punto-v { background: var(--fg); }
    .scheda-v { padding: 10px 12px; border: 1px solid var(--line); opacity: .35; transform: translateX(10px) scale(.97); transition: opacity .5s, transform .5s; }
    .scheda-v.vista { opacity: 1; transform: none; }
    .simbolo-v { width: 150px; margin: 8px 0 0; color: var(--fg); }
    .controlli { padding: 4px 16px 8px; }
    .densita { height: 18px; }
    .gruppo button { padding: 6px 8px; }
  }
</style>
