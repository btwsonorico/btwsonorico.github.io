---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { simbolo } from '../../lib/simboliTimeline';

// AI timeline: la storia dell'AI su una linea del tempo. Su computer lo scroll verso il basso fa scorrere la linea verso
// destra. La scheda al centro è aperta e mostra tutto; quelle ai lati, al massimo due per lato, mostrano data e titolo.
// Durante lo scroll le schede si piegano come un foglio di carta. Su telefono la linea diventa una lista verticale, con una
// striscia in basso che dice anno e posizione. Gli eventi sono note in src/content/timeline; il movimento e i controlli
// sono in src/scripts/timelineVista.ts.
const MESI = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const TIPI: Record<string, string> = { idea: 'ideas', model: 'models', world: 'world' };
const eventi = (await getCollection('timeline', e => !e.data.draft))
  .sort((a, b) => a.data.year - b.data.year || (a.data.month ?? 6.5) - (b.data.month ?? 6.5))
  .map(e => ({
    id: e.id, ...e.data, testo: (e.body ?? '').trim(),
    data: e.data.month ? `${MESI[e.data.month - 1]} ${e.data.year}` : String(e.data.year),
    // Posizione nel tempo: l'anno più la metà del mese (o metà anno se il mese non c'è)
    t: e.data.year + ((e.data.month ?? 6.5) - 0.5) / 12,
    svg: simbolo(e.data.simbolo),
  }));
const daControllare = eventi.filter(e => !e.checked).length;
const datiJs = eventi.map(e => ({ t: e.t, k: e.kind, p: e.peso, s: !!e.svg }));
const ora = new Date(), oggi = ora.getFullYear() + ora.getMonth() / 12;
---
<Base title="AI timeline · Riccardo Mondi" description="The history of artificial intelligence on one line, from the first artificial neuron to today, and why each step matters." tono="neutro" largo>
  <main class="tl" data-eventi={JSON.stringify(datiJs)} data-oggi={oggi}>
    <header class="testa">
      <h1>AI timeline</h1>
      <p>From the first artificial neuron to today, in {eventi.length} events. <span class="solo-pc">Scroll to travel in time.</span></p>
      <div class="filtri filtri-testa" role="group" aria-label="Kinds of event">
        {Object.entries(TIPI).map(([k, nome]) => <button type="button" class="tipo mono" data-kind={k} aria-pressed="true">{nome}</button>)}
      </div>
    </header>

    <!-- Computer: la linea orizzontale. La pista è alta quanto la linea è lunga; dentro, il palco resta fermo sullo schermo -->
    <div class="pista" aria-label="AI timeline, horizontal">
      <div class="palco">
        <div class="mondo">
          <svg class="asse" aria-hidden="true"></svg>
          {eventi.map((e, i) => <button type="button" class="punto" data-i={i} data-peso={e.peso} data-kind={e.kind} aria-label={`${e.data}: ${e.title}`}></button>)}
        </div>
        <div class="anno-grande mono" aria-hidden="true"></div>
        {eventi.map((e, i) => (
          <article class="scheda" data-i={i} data-peso={e.peso} data-kind={e.kind}>
            <div class="corpo">
              <p class="mono riga"><span>{e.data}</span><span class="tipo-k">{TIPI[e.kind]}</span></p>
              <h2>{e.title}</h2>
              <div class="apri"><div class="apri-dentro">
                <p class="perche">{e.perche}</p>
                <p class="chi">{e.who}</p>
                <p class="testo">{e.testo}</p>
                <a class="mono fonte" href={e.source} target="_blank" rel="noopener">source ↗</a>
              </div></div>
            </div>
          </article>
        ))}
        {eventi.map((e, i) => e.svg && <figure class="scheda-simbolo" data-i={i} data-kind={e.kind} set:html={e.svg} />)}
        <span class="stelo" aria-hidden="true"></span>
      </div>
    </div>

    <!-- Telefono: la stessa storia su una lista verticale; il dettaglio si apre a richiesta, così la lista non salta mentre scorre -->
    <ol class="verticale">
      {eventi.map((e, i) => (
        <li data-i={i} data-peso={e.peso} data-kind={e.kind}>
          <span class="punto-v" aria-hidden="true"></span>
          <p class="mono riga"><span>{e.data}</span><span class="tipo-k">{TIPI[e.kind]}</span></p>
          <h2>{e.title}</h2>
          <p class="perche">{e.perche}</p>
          {e.svg && <figure class="simbolo-v" set:html={e.svg} />}
          <details class="piu">
            <summary class="mono">more</summary>
            <p class="chi">{e.who}</p>
            <p class="testo">{e.testo}</p>
            <a class="mono fonte" href={e.source} target="_blank" rel="noopener">source ↗</a>
          </details>
        </li>
      ))}
    </ol>

    <section class="fine">
      <p>Each event is a short note with its source. The larger points are the twelve turning points. {daControllare > 0 && <>{daControllare} of {eventi.length} notes are still drafts: if you spot a wrong date or name, <a href="mailto:rmondi99@gmail.com">tell me</a>.</>}</p>
    </section>

    <!-- La barra in basso: la minimappa con gli eventi per anno e, su computer, il bottone dei filtri. Su telefono anche l'anno -->
    <nav class="controlli mono" aria-label="Timeline controls">
      <span class="anno-v" aria-hidden="true"></span>
      <canvas class="densita" aria-label="Events per year. Click or drag to move to a year"></canvas>
      <div class="menu solo-pc">
        <button type="button" class="apri-filtri" aria-expanded="false">filters</button>
        <div class="filtri pop" role="group" aria-label="Kinds of event" hidden>
          {Object.entries(TIPI).map(([k, nome]) => <button type="button" class="tipo" data-kind={k} aria-pressed="true">{nome}</button>)}
        </div>
      </div>
    </nav>
  </main>
</Base>

<script>
  import { monta } from '../../scripts/timelineVista';
  monta(document.querySelector<HTMLElement>('.tl')!);
</script>

<style>
  /* I colori delle categorie: i toni del sito. Sulla pagina compaiono solo come piccoli segni */
  .tl { padding: 4px 24px 0; --c-idea: var(--azzurro); --c-model: var(--verde); --c-world: var(--arancio); }
  .tl [data-kind="idea"] { --k: var(--c-idea); }
  .tl [data-kind="model"] { --k: var(--c-model); }
  .tl [data-kind="world"] { --k: var(--c-world); }
  .testa { max-width: 620px; padding-bottom: var(--s2); }
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); }
  .filtri-testa { display: none; }

  /* --- Computer: la pista e il palco fermo */
  /* La pista va da bordo a bordo: il centro del palco è il centro dello schermo */
  .pista { position: relative; margin: 0 -24px; }
  .palco { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .mondo { position: absolute; left: 0; top: 0; height: 100%; will-change: transform; }
  .asse { position: absolute; left: 0; top: 0; height: 100%; overflow: visible; pointer-events: none; }
  .asse :global(.linea) { stroke: var(--muted); stroke-width: 1; }
  .asse :global(.tacca) { stroke: var(--line); stroke-width: 1; }
  .asse :global(.tacca.decennio) { stroke: var(--muted); }
  .asse :global(text) { fill: var(--muted); font-family: var(--mono); font-size: 11px; }
  .asse :global(text.decennio) { fill: var(--fg); }
  .asse :global(.oggi) { stroke: var(--fg); stroke-dasharray: 2 3; }

  /* I punti: i 12 essenziali sono più grandi e pieni, gli altri piccoli e vuoti */
  .punto { position: absolute; top: 0; width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px; padding: 0; border: 1.5px solid var(--k, var(--fg)); border-radius: 50%; background: var(--bg); cursor: pointer; transition: background .2s, transform .2s; }
  .punto[data-peso="1"] { width: 15px; height: 15px; margin: -7.5px 0 0 -7.5px; background: color-mix(in srgb, var(--k) 45%, var(--bg)); }
  .punto:hover, .punto.attivo { background: var(--k, var(--fg)); transform: scale(1.3); }
  .punto[hidden] { display: none; }

  /* L'anno grande: resta fermo in alto a sinistra e cambia con lo scroll */
  .anno-grande { position: absolute; left: 24px; top: 14px; z-index: 110; font-size: clamp(44px, 6vw, 76px); line-height: 1; color: var(--fg); white-space: nowrap; pointer-events: none; }

  .scheda, .scheda-simbolo { position: absolute; left: 0; top: 0; margin: 0; transform-origin: 50% 100%; will-change: transform, opacity; visibility: hidden; }
  .scheda { width: 380px; cursor: pointer; }
  .scheda.attiva { cursor: default; }
  .corpo { position: relative; box-sizing: border-box; padding: 11px 14px; border: 1px solid var(--line); background: var(--bg); }
  .scheda.attiva .corpo { border-color: var(--muted); }
  /* Durante la piega si vede il foglio a strisce; da ferma torna la scheda vera, con il testo nitido */
  .scheda.piega > .corpo { opacity: 0; }

  /* La scheda aperta: la riga del dettaglio si allarga da 0 alla sua altezza */
  .apri { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .24s ease-out; }
  .apri-dentro { min-height: 0; overflow: hidden; visibility: hidden; opacity: 0; transition: opacity .24s, visibility .24s; }
  .attiva .apri { grid-template-rows: 1fr; }
  .attiva .apri-dentro { visibility: visible; opacity: 1; max-height: var(--alt-dettaglio, 400px); overflow-y: auto; scrollbar-width: thin; }

  /* Il foglio: le strisce della scheda, disposte su una curva in 3D */
  .tl :global(.foglio) { position: absolute; inset: 0; display: none; perspective: 800px; perspective-origin: 50% 50%; }
  .tl :global(.scheda.piega > .foglio) { display: block; }
  .tl :global(.striscia) { position: absolute; left: 0; top: 0; height: 100%; overflow: hidden; transform-origin: 0 50%; }
  .tl :global(.striscia > .corpo) { position: absolute; top: 0; }
  .tl :global(.ombra) { position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }

  .tipo-k { color: var(--muted); }
  .tipo-k::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--k); vertical-align: 1px; }
  /* Il simbolo non sta in un riquadro: fluttua accanto alla scheda aperta, nel colore della categoria */
  .scheda-simbolo { width: 130px; padding: 0; color: var(--k, var(--fg)); transform-origin: 0 50%; pointer-events: none; }
  .riga { display: flex; justify-content: space-between; gap: 8px; margin: 0 0 6px; font-size: 11px; color: var(--muted); }
  .scheda h2, .verticale h2 { margin: 0; font-size: 16px; font-weight: 400; line-height: 1.3; color: var(--fg); }
  .perche { margin: 8px 0 10px; font-size: 14px; line-height: 1.4; color: var(--fg); }
  .chi { margin: 0 0 4px; font-size: 12px; color: var(--muted); }
  .testo { margin: 0 0 6px; font-size: 12.5px; line-height: 1.45; color: var(--muted); }
  .fonte { font-size: 11px; color: var(--muted); }
  .fonte:hover { color: var(--fg); }
  .stelo { position: absolute; left: 0; top: 0; width: 0; border-left: 1px solid var(--line); pointer-events: none; }

  /* I simboli si disegnano: ogni linea ha lunghezza 1, il trattino scorre da 1 a 0 */
  .tl :global(.simbolo) { display: block; width: 100%; height: auto; }
  .tl :global(.simbolo *) { stroke-dasharray: 1 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s ease-out; }
  .tl :global(.disegnato .simbolo *) { stroke-dashoffset: 0; }
  .tl :global(.simbolo .tenue) { opacity: .45; }
  .tl :global(.simbolo .pieno) { fill: currentColor; }
  .tl :global(.simbolo .pieno-tenue) { fill: currentColor; fill-opacity: .22; }
  .tl :global(.disegnato .simbolo .tratteggio) { stroke-dasharray: .04 .035; }

  /* --- Telefono: la lista verticale, nascosta su computer */
  .verticale { display: none; }

  .fine { max-width: 620px; padding: var(--s3) 0 96px; color: var(--muted); font-size: 13px; line-height: 1.6; }

  /* --- La barra in basso: la minimappa e i filtri */
  .controlli { position: fixed; left: 0; right: 0; bottom: 0; z-index: 120; display: flex; align-items: center; gap: 16px; padding: 6px 24px 8px; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(6px); font-size: 12px; }
  .anno-v { display: none; }
  .densita { display: block; flex: 1; min-width: 0; height: 38px; cursor: pointer; touch-action: none; }
  .menu { position: relative; flex: none; }
  .apri-filtri, .filtri button { padding: 4px 10px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; }
  .apri-filtri:hover, .apri-filtri[aria-expanded="true"], .filtri button:hover { border-color: var(--fg); color: var(--fg); }
  .pop { position: absolute; right: 0; bottom: calc(100% + 6px); display: flex; flex-direction: column; gap: 4px; }
  .pop[hidden] { display: none; }
  .filtri button { text-align: left; white-space: nowrap; }
  .filtri button[aria-pressed="true"] { color: var(--fg); }
  .filtri button.tipo::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--k); vertical-align: 1px; }
  .filtri button.tipo[aria-pressed="false"]::before { background: transparent; box-shadow: inset 0 0 0 1px var(--k); }

  @media (max-width: 700px) {
    .tl { padding: 0 16px; }
    h1 { font-size: 26px; }
    .solo-pc { display: none !important; }
    .filtri-testa { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--s1); font-size: 12px; }
    .filtri-testa button { padding: 6px 10px; }
    .pista { display: none; }
    .verticale { display: block; margin: var(--s2) 0 0 6px; padding: 0 0 0 20px; list-style: none; border-left: 1px solid var(--line); }
    .verticale li { position: relative; margin: 0 0 var(--s3); }
    .verticale li[hidden] { display: none; }
    .punto-v { position: absolute; left: -24.5px; top: 3px; width: 9px; height: 9px; border: 1.5px solid var(--k); border-radius: 50%; background: var(--bg); }
    .verticale li[data-peso="1"] .punto-v { left: -27px; top: 0; width: 14px; height: 14px; background: color-mix(in srgb, var(--k) 45%, var(--bg)); }
    .verticale h2 { font-size: 17px; }
    .verticale li[data-peso="1"] h2 { font-size: 20px; }
    .perche { font-size: 15px; margin: 6px 0; }
    .simbolo-v { width: 120px; margin: 10px 0; color: var(--k); }
    .piu summary { display: inline-block; padding: 6px 12px 6px 0; font-size: 12px; color: var(--muted); cursor: pointer; list-style: none; }
    .piu summary::-webkit-details-marker { display: none; }
    .piu summary::after { content: " +"; }
    .piu[open] summary::after { content: " −"; }
    .testo { font-size: 14px; }
    .fine { padding-bottom: 90px; }
    .controlli { gap: 10px; padding: 6px 16px 8px; }
    .anno-v { display: block; flex: none; min-width: 3.4em; font-size: 20px; color: var(--fg); }
    .densita { height: 34px; }
  }
</style>
