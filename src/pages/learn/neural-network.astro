---
import Base from '../../layouts/Base.astro';

// Rete neurale: una griglia a tutta pagina e quattro passi, con pochi comandi. La rete è vera e si allena nel browser (src/lib/rete.ts)
---
<Base title="Neural network · Riccardo Mondi" description="A simplified but real neural network, running in your browser. Add neurons and layers and teach it to draw." largo>
  <main class="rn" data-rete>
    <header class="testa">
      <p class="mono via"><a href="/">~</a>/<a href="/learn/">learn</a>/neural-network</p>
      <h1>Teach a neural network to draw</h1>
      <p class="sotto">A simplified but real neural network, running in your browser. Its answer is the height of the grid.</p>
    </header>

    <section class="banco">
      <canvas class="tela-terreno" role="img" aria-label="A wire grid. Its height is the answer of the network, and the blue outline is the shape to reach."></canvas>
      <canvas class="tela-rete" role="img" aria-label="The network: inputs on the left, output on the right. Each line is a weight."></canvas>
      <div class="mono andamento">
        <span class="lettura"></span>
        <span class="errore" hidden></span>
        <canvas class="curva" role="img" aria-label="How well the shape matches, over time"></canvas>
      </div>
      <p class="mono dettaglio"></p>
    </section>

    <section class="guida" aria-label="Steps">
      <nav class="mono passi" aria-label="Step">
        {['Neurons', 'Layers', 'Learning', 'Your turn'].map(n => <button type="button">{n}</button>)}
      </nav>
      <p class="frase" aria-live="polite"></p>
      <div class="mono comandi">
        <button type="button" class="gioca primo">play</button>
        <button type="button" class="un-passo">one correction</button>
        <span class="fasi" aria-hidden="true" hidden><span>try</span><span>error</span><span>backpropagation</span></span>
        <div class="gruppo" data-comandi="4">
          <button type="button" data-sagoma="fish">fish</button>
          <button type="button" data-sagoma="bird">bird</button>
          <button type="button" class="matita">draw</button>
          <button type="button" class="pulisci" hidden>clear</button>
        </div>
        <div class="contatore" data-conta="neuroni">
          <span>neurons</span>
          <button type="button" class="neuroni-meno" aria-label="Remove a neuron">−</button><b class="neuroni-n"></b><button type="button" class="neuroni-piu" aria-label="Add a neuron">+</button>
        </div>
        <div class="contatore" data-conta="strati">
          <span>layers</span>
          <button type="button" class="strati-meno" aria-label="Remove a layer">−</button><b class="strati-n"></b><button type="button" class="strati-piu" aria-label="Add a layer">+</button>
        </div>
        <button type="button" class="azzera">restart</button>
      </div>
      <button type="button" class="mono dopo primo">next →</button>
    </section>
  </main>
</Base>

<script>
  import { monta } from '../../scripts/reteVista';
  monta(document.querySelector<HTMLElement>('[data-rete]')!);
</script>

<style>
  /* La pagina è lo strumento: griglia e rete riempiono tutta la finestra, sotto restano la frase e i comandi */
  .rn { display: flex; flex-direction: column; flex: 1; gap: var(--s1); padding: 0 24px 12px; min-height: 0; }
  :global(.piede) { display: none; }
  .via { margin: 0; }
  .via a { color: inherit; }
  h1 { margin: 2px 0 2px; font-size: 24px; font-weight: 400; line-height: 1.15; }
  .sotto { margin: 0; color: var(--muted); font-size: 14px; }
  .banco { position: relative; flex: 1 1 0; min-height: 300px; }
  .tela-terreno { position: absolute; inset: 0; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; }
  .tela-terreno:active { cursor: grabbing; }
  .tela-rete { position: absolute; left: 0; top: 0; bottom: 84px; width: min(30%, 420px); height: calc(100% - 84px); touch-action: pan-y; }
  .andamento { position: absolute; left: 0; bottom: 0; width: min(30%, 420px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 var(--s1); }
  .lettura { font-size: 20px; color: var(--fg); white-space: nowrap; }
  .errore { color: var(--muted); white-space: nowrap; }
  .errore[hidden] { display: none; }
  .curva { display: block; flex: 1 0 100%; width: 100%; height: 44px; border-bottom: 1px solid var(--line); }
  .dettaglio { position: absolute; right: 0; bottom: 0; max-width: 62%; margin: 0; padding: 3px 8px; background: var(--bg); border: 1px solid var(--line); color: var(--fg); font-size: 12px; overflow-wrap: anywhere; }
  .dettaglio:empty { display: none; }
  button { padding: 3px 10px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; }
  button:hover:not(:disabled) { color: var(--fg); border-color: var(--muted); }
  button:disabled { opacity: .35; cursor: default; }
  button[hidden] { display: none; }
  button[aria-pressed="true"] { border-color: var(--fg); color: var(--fg); }
  .primo { border-color: var(--fg); color: var(--fg); }
  .primo:hover:not(:disabled) { background: var(--fg); color: var(--bg); }
  /* Riga dei comandi: dove sei, cosa fare, con cosa, e il passo dopo */
  .guida { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s1) var(--s3); padding-top: var(--s1); border-top: 1px solid var(--line); }
  .passi { display: flex; gap: 4px; }
  .passi button { padding: 3px 8px; border-color: transparent; }
  .passi button[aria-current="step"] { background: var(--fg); color: var(--bg); }
  .frase { flex: 1 1 280px; margin: 0; font-size: 15px; line-height: 1.4; }
  .comandi { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 13px; color: var(--fg); }
  .comandi > [hidden], .gruppo[hidden], .contatore[hidden], .fasi[hidden] { display: none; }
  .gruppo { display: flex; gap: 6px; }
  .contatore { display: inline-flex; align-items: center; gap: 6px; }
  .contatore span { color: var(--muted); }
  .contatore b { min-width: 2ch; font-weight: 400; text-align: center; }
  .fasi { display: inline-flex; gap: 4px; }
  .fasi span { padding: 3px 8px; border: 1px solid transparent; color: var(--muted); opacity: .6; }
  .fasi span.accesa { opacity: 1; border-color: var(--fg); color: var(--fg); }
  .dopo { padding: 3px 14px; font-size: 13px; }
  .dopo[hidden] { display: none; }
  /* Telefono: prima la griglia e subito sotto i comandi; la rete dopo, scorrendo */
  @media (max-width: 760px) {
    .rn { padding: 0 16px 16px; }
    h1 { font-size: 20px; }
    .banco { display: contents; }
    .testa { order: 0; }
    .tela-terreno { position: static; display: block; order: 1; height: 300px; }
    .dettaglio { position: static; order: 2; max-width: none; }
    .guida { order: 3; }
    .andamento { position: static; order: 4; width: 100%; }
    .tela-rete { position: static; display: block; order: 5; width: 100%; height: 240px; }
    .frase { flex-basis: 100%; order: -1; }
    button { padding: 6px 12px; }
    .passi button { padding: 6px 11px; }
  }
</style>
