---
import Base from '../../layouts/Base.astro';

// Rete neurale: la facciata è lo strumento (a sinistra costruisci, alleni e leggi; a destra la griglia), le spiegazioni brevi
// sono tag che appaiono sul punto, e scorrendo sotto c'è la spiegazione completa. La rete si allena nel browser (src/lib/rete.ts)
const COME: [string, string[]][] = [
  ['What is this?', [
    'A small neural network that runs in your browser. It takes the position of a point on the grid and returns one number, the height of the grid at that point. During training it sees the correct height of 1,024 points, and the blue outline shows the shape they form.',
    'It is simpler than a real model in two ways. First, the match is measured on the same points the network trained on, so it only tells you how well it learned those points. A real model is judged on new data it has never seen. Second, the learning rate and the other settings are fixed for you, while in practice they take a lot of trial and error.',
  ]],
  ['What does one neuron do?', [
    'It multiplies each input by a weight, adds the results and squashes the total between two limits. On this grid that gives one straight cut, high on one side and low on the other. With no layers you can set the weights yourself by dragging the white squares, and you will see that one cut cannot cover the fish.',
  ]],
  ['What do more neurons and layers add?', [
    'Each neuron in a layer makes its own cut, and the next layer adds them up, so straight cuts turn into rounded shapes. A neuron in a second layer reads those cuts instead of the position, which lets it combine them into corners and strips.',
    'On the fish, one layer of 6 neurons stops near 70%, two reach about 90% and three go past 95%. Hover over a square to see what that neuron responds to and which neurons it reads from.',
  ]],
  ['How does it learn?', [
    'Training repeats the same loop hundreds of times a second. The network answers for a group of points, and the difference from the correct heights is the error. Backpropagation works out how much each weight contributed to that error, and gradient descent moves each weight slightly to reduce it.',
    'A single correction changes very little, so it takes thousands of them. Press one step to see one round slowly.',
  ]],
  ['What do the colours mean?', [
    'In a square, orange is where that neuron answers high and dark is where it answers low. On the lines, orange weights push up, blue weights push down, and thicker lines count more. The blue outline is the shape to reach.',
  ]],
];
const GRANDI: [string, string[]][] = [
  ['The same training loop', [
    'Models that write text or generate images are trained in much the same way: they answer, measure the error, send it back and adjust the weights. They have billions of weights instead of about 150. Language models also use attention, which lets each word weigh the other words, but it is made of weights too and trained with the same loop.',
  ]],
  ['More weights cost more', [
    'Here, adding neurons costs a few extra seconds. In a large model each weight also uses computing power, memory and energy, so training can take weeks on very large machines, and making a model bigger is an expensive decision.',
  ]],
  ['Why large models are hard to read', [
    'A large model does not take x and y as input. It turns words or pixels into long lists of numbers, so its cuts happen in thousands of dimensions. There is no grid to look at, and a single neuron rarely has one clear meaning, which is a large part of why these models are called black boxes.',
  ]],
];
---
<Base title="Neural network · Riccardo Mondi" description="A simplified but real neural network, running in your browser. Add neurons and layers and teach it to draw." tono="neutro" largo>
  <main class="rn" data-rete>
    <div class="schermo">
      <header class="testa">
        <p class="mono via"><a href="/">~</a>/<a href="/learn/">learn</a>/neural-network</p>
        <h1>Teach a neural network to draw</h1>
        <p class="sotto">A simplified but real neural network, in your browser. <a href="#how-it-works" class="mono">how it works ↓</a></p>
      </header>

      <section class="banco">
        <canvas class="tela-terreno" role="img" aria-label="A wire grid. Its height is the answer of the network, and the blue outline is the shape to reach."></canvas>

        <div class="mono forme">
          <span class="titolino">shape</span>
          <button type="button" data-sagoma="fish" data-spiega="Teach the network to draw a fish.">fish</button>
          <button type="button" data-sagoma="tree" data-spiega="Teach the network to draw a fir tree.">tree</button>
          <button type="button" class="matita" data-spiega="Stops the network and lets you paint your own shape on the base of the grid.">draw</button>
          <button type="button" class="pulisci" hidden data-spiega="Erases everything you painted.">clear</button>
        </div>

        <div class="pannello">
          <div class="mono costruisci">
            <span class="titolino">build</span>
            <div class="contatore strati" data-spiega="Layers. Each one reads the layer before it, and combines its cuts into corners and shapes.">
              <span>layers</span>
              <button type="button" class="strati-meno" aria-label="Remove a layer">−</button><b class="strati-n"></b><button type="button" class="strati-piu" aria-label="Add a layer">+</button>
            </div>
          </div>
          <div class="rete-box">
            <div class="mono colonne"></div>
            <canvas class="tela-rete" role="img" aria-label="The network: inputs on the left, output on the right. Each square shows what that neuron sees, and each line is a weight."></canvas>
          </div>
          <div class="mono azioni">
            <span class="titolino">train</span>
            <button type="button" class="gioca" data-spiega="Training: the network tries points, measures the error, and corrects its weights with backpropagation."></button>
            <button type="button" class="azzera" data-spiega="Sets the weights back to random. This run stays in the chart.">restart</button>
            <button type="button" class="un-passo" data-spiega="Slows down and shows one correction: try, error, backpropagation.">one step</button>
            <span class="nota-solo">add a layer to start training</span>
          </div>
          <div class="mono andamento">
            <span class="titolino">result</span>
            <div class="numeri"><span class="lettura" data-spiega="Match: how much of the blue shape the network covers."></span><span class="errore" data-spiega="Error: how wrong the answers are. Training makes it smaller."></span></div>
            <canvas class="curva" role="img" aria-label="Chart of the match over training, for this run and the last ones" data-spiega="Your last runs, on the same scale. Orange is this one, grey the ones before. Higher is better."></canvas>
          </div>
        </div>
      </section>
    </div>

    <section class="spiegone" id="how-it-works">
      <h2 class="mono">how it works</h2>
      {COME.map(([domanda, testi]) => <article><h3>{domanda}</h3>{testi.map(t => <p>{t}</p>)}</article>)}
      <h2 class="mono secondo">what this means for large models</h2>
      {GRANDI.map(([domanda, testi]) => <article><h3>{domanda}</h3>{testi.map(t => <p>{t}</p>)}</article>)}
    </section>
  </main>
  <div class="mono tag-punto" hidden></div>
  <div class="mono tag-consiglio" hidden></div>
</Base>

<script>
  import { monta } from '../../scripts/reteVista';
  monta(document.querySelector<HTMLElement>('[data-rete]')!);
</script>

<style>
  /* La facciata occupa tutta la finestra: griglia a tutto spazio; a sinistra si lavora dall'alto in basso */
  :global(html) { scroll-behavior: smooth; }
  .rn { padding: 4px 24px 0; }
  .schermo { display: flex; flex-direction: column; gap: var(--s2); height: calc(100vh - 62px); min-height: 600px; padding-bottom: var(--s2); }
  .via { margin: 0 0 12px; }
  .via a { color: inherit; }
  h1 { margin: 0 0 4px; font-size: 24px; font-weight: 400; line-height: 1.15; }
  .sotto { margin: 0; color: var(--muted); font-size: 14px; }
  .sotto a { margin-left: 6px; color: var(--fg); font-size: 12px; white-space: nowrap; }
  button { padding: 5px 12px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; transition: color .12s, border-color .12s; }
  button:hover:not(:disabled) { border-color: var(--fg); color: var(--fg); }
  button:disabled { border-color: var(--line); color: var(--line); opacity: .6; cursor: default; }
  button[hidden] { display: none; }
  /* Selezionato: contorno chiaro. Il pieno resta solo all'azione principale */
  button[aria-pressed="true"] { border-color: var(--fg); color: var(--fg); }
  button[aria-pressed="true"]::before { content: '> '; color: var(--muted); }
  /* Done è l'azione principale mentre si disegna */
  .matita[aria-pressed="true"] { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  .matita[aria-pressed="true"]::before { content: none; }
  /* Il comando consigliato ha lo stesso colore del suo tag */
  :global(.consigliato) { border-color: var(--arancio) !important; box-shadow: 0 0 0 1px var(--arancio); }
  /* Titoli di sezione: come nel resto del sito */
  .titolino { color: var(--fg); font-size: 14px; }
  .titolino::before { content: '// '; color: var(--muted); }
  .banco { position: relative; flex: 1 1 0; min-height: 0; }
  .tela-terreno { position: absolute; inset: 0; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; }
  .tela-terreno:active { cursor: grabbing; }
  .tela-terreno.pennello { cursor: crosshair; }
  .forme { position: absolute; top: 94px; right: 2px; z-index: 1; display: flex; flex-direction: column; gap: 6px; width: 84px; font-size: 13px; }
  .forme button { padding: 5px 4px; }
  /* A sinistra, dall'alto in basso */
  .pannello { position: absolute; left: 0; top: 0; bottom: 0; z-index: 1; display: flex; flex-direction: column; gap: 10px; width: clamp(390px, 34%, 460px); transition: opacity .2s; }
  .pannello.spento { opacity: .35; pointer-events: none; }
  .costruisci { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; font-size: 13px; }
  .contatore { display: inline-flex; align-items: center; gap: 6px; color: var(--fg); }
  .contatore > span { width: 56px; color: var(--muted); font-size: 12px; }
  .contatore b { min-width: 2ch; font-weight: 400; font-size: 15px; text-align: center; }
  .contatore button { width: 28px; height: 28px; padding: 0; font-size: 15px; }
  .rete-box { position: relative; flex: 1 1 0; min-height: 170px; }
  .tela-rete { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
  .azioni, .andamento { padding-top: 10px; border-top: 1px solid var(--line); }
  /* I neuroni si cambiano sopra ogni strato */
  .colonne { position: absolute; inset: 0 0 auto; height: 28px; z-index: 1; font-size: 13px; color: var(--fg); }
  .colonne :global(.colonna) { position: absolute; top: 0; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 2px; white-space: nowrap; }
  .colonne :global(.nome-colonna) { position: absolute; top: 5px; left: 0; color: var(--muted); font-size: 12px; }
  .colonne :global(button) { width: 22px; height: 24px; padding: 0; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; }
  .colonne :global(button:hover:not(:disabled)) { border-color: var(--fg); color: var(--fg); }
  .colonne :global(button:disabled) { opacity: .4; cursor: default; }
  .colonne :global(b) { min-width: 1.4ch; font-weight: 400; text-align: center; }
  .azioni { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 36px; font-size: 13px; }
  .azioni .titolino { width: 100%; }
  .azioni > [hidden] { display: none; }
  .gioca { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 112px; padding: 7px 16px; background: var(--fg); border-color: var(--fg); color: var(--bg); font-size: 15px; }
  .gioca:hover:not(:disabled) { background: var(--bg); border-color: var(--fg); color: var(--fg); }
  .gioca::before { content: ''; width: 0; height: 0; border-style: solid; border-width: 5px 0 5px 9px; border-color: transparent transparent transparent currentColor; }
  .gioca[data-stato="pausa"] { background: var(--bg); color: var(--fg); }
  .gioca[data-stato="pausa"]:hover:not(:disabled) { background: var(--bg); border-color: var(--muted); color: var(--muted); }
  .gioca[data-stato="pausa"]::before { width: 8px; height: 10px; border-width: 0 2px; border-style: solid; border-color: currentColor; background: none; }
  .nota-solo { color: var(--muted); }
  .nota-solo[hidden] { display: none; }
  .andamento .titolino { display: block; margin-bottom: 4px; }
  .numeri { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s1); }
  .lettura { font-size: 20px; color: var(--fg); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .errore { color: var(--muted); white-space: nowrap; }
  .curva { display: block; width: 100%; height: 124px; margin-top: 2px; }
  /* Tag sul punto: stesso stile delle etichette delle scene */
  .tag-punto, .tag-consiglio { position: fixed; left: 0; top: 0; z-index: 5; max-width: 300px; padding: 4px 8px; background: var(--bg); border: 1px solid var(--fg); color: var(--fg); font-size: 12px; line-height: 1.45; white-space: pre-line; pointer-events: none; }
  .tag-consiglio { border-color: var(--arancio); color: var(--arancio); }
  .tag-punto[hidden], .tag-consiglio[hidden] { display: none; }
  /* Sotto la facciata: la spiegazione completa */
  .spiegone { max-width: 720px; margin: 0 auto; padding: var(--s4) 0; border-top: 1px solid var(--line); scroll-margin-top: var(--s2); }
  .spiegone h2 { margin: 0 0 var(--s3); font-size: 14px; font-weight: 400; color: var(--fg); }
  .spiegone h2::before { content: '// '; color: var(--muted); }
  .spiegone h2.secondo { margin-top: var(--s4); padding-top: var(--s3); border-top: 1px solid var(--line); }
  .spiegone article { margin-bottom: var(--s3); }
  .spiegone h3 { margin: 0 0 4px; font-size: 16px; font-weight: 400; color: var(--fg); }
  .spiegone p { margin: 0 0 var(--s1); color: var(--muted); font-size: 14px; line-height: 1.7; }
  /* Telefono: griglia e forme subito visibili, poi costruisci, allena e leggi */
  @media (max-width: 760px) {
    .rn { padding: 0 16px; }
    .schermo { height: auto; min-height: 0; gap: var(--s1); }
    h1 { font-size: 20px; }
    .via { margin-bottom: 8px; }
    .banco { display: contents; }
    .testa { order: 0; }
    .tela-terreno { position: static; display: block; order: 1; height: 280px; }
    .forme { position: static; order: 2; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 6px 8px; width: auto; }
    .forme button { padding: 7px 14px; }
    .pannello { position: static; order: 3; width: 100%; gap: var(--s2); }
    .rete-box { flex: none; height: 260px; }
    .contatore button { width: 36px; height: 36px; }
    .colonne { height: 32px; }
    .colonne :global(button) { width: 22px; height: 30px; }
    .colonne :global(.colonna) { gap: 0; }
    .gioca { flex: 1 1 100%; padding: 10px; }
    .azioni button:not(.gioca) { flex: 1 1 40%; padding: 9px; }
    .curva { height: 140px; }
    .tag-punto, .tag-consiglio { max-width: calc(100vw - 24px); }
  }
</style>
