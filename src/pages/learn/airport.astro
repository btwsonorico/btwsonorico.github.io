---
import Base from '../../layouts/Base.astro';

// AI terms: il gioco del giorno. Sei aerei, uno per sezione del glossario; indovina il termine e l'aereo parte.
// Ogni giorno i termini cambiano, uguali per tutti. Logica in src/lib/voloDelGiorno.ts, scena in src/scripts/aeroporto.ts
---
<Base title="AI terms · Riccardo Mondi" description="A daily AI terms trivia: six planes, six boarding passes, the same flights for everyone each day." tono="neutro" largo>
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="aeroporto">
    <h1>AI terms</h1>
    <p class="sotto">Six planes, one for each section of the glossary, wait over the sea. Pick a flight: its plane lands with a question. Answer right and it flies around the island with its term. New flights every day, the same for everyone.</p>
    <p class="mono giorno"></p>
    <ol class="mono tabellone" aria-label="departures"></ol>
    <section class="riepilogo" hidden aria-live="polite">
      <p class="mono titolo-riepilogo"></p>
      <p class="quadri" aria-hidden="true"></p>
      <p class="mono numeri"></p>
      <button type="button" class="mono condividi">copy result</button>
      <p class="mono domani"></p>
    </section>
  </main>
</Base>

<script>
  import { monta, type Fase } from '../../scripts/aeroporto';
  import { nuovoImbarco } from '../../scripts/bigliettoImbarco';
  import { chiudiGiorno, oggi, partita, quadro, serieOra, testoDaCondividere, voliDel } from '../../lib/voloDelGiorno';

  const adesso = new Date(), { chiave, n } = oggi(adesso), voli = voliDel(chiave), p = partita(chiave, voli.length);
  const giorno = document.querySelector<HTMLElement>('.giorno')!, tabellone = document.querySelector<HTMLOListElement>('.tabellone')!;
  const riepilogo = document.querySelector<HTMLElement>('.riepilogo')!;
  const data = adesso.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
  let fasi: Fase[] = voli.map((_, i) => (p.fatto[i] ? 'in the air' : 'holding'));

  const scriviGiorno = () => { giorno.textContent = `Daily flights #${n} · ${data} · streak ${serieOra(n).serie}`; };
  // Il tabellone delle partenze: una riga per volo, si clicca per aprire il biglietto
  const righe = voli.map((v, i) => {
    const li = document.createElement('li'), b = document.createElement('button'), pallino = document.createElement('i'), codice = document.createElement('span'), nome = document.createElement('span'), stato = document.createElement('span');
    b.type = 'button';
    pallino.style.background = v.tinta;
    codice.className = 'codice-volo'; codice.textContent = v.codice;
    nome.className = 'nome-volo'; nome.textContent = v.nome;
    stato.className = 'stato-volo';
    b.append(pallino, codice, nome, stato);
    b.addEventListener('click', () => apri(i));
    li.append(b);
    tabellone.append(li);
    return { b, stato };
  });
  const scriviTabellone = () => righe.forEach((r, i) => {
    const t = p.tentativi[i]!;
    r.stato.textContent = p.fatto[i] ? `${quadro(t)} ${fasi[i]}` : t ? `delayed · ${fasi[i]}` : fasi[i]!;
    r.b.classList.toggle('partito', p.fatto[i]!);
    r.b.classList.toggle('aperto', imbarco.aperto === i);
  });

  const scriviRiepilogo = () => {
    const finito = p.fatto.every(Boolean);
    riepilogo.hidden = !finito;
    if (!finito) return;
    const s = serieOra(n), primi = p.tentativi.filter(t => t === 1).length;
    riepilogo.querySelector('.titolo-riepilogo')!.textContent = `All six flights cleared · #${n}`;
    riepilogo.querySelector('.quadri')!.textContent = p.tentativi.map(quadro).join(' ');
    riepilogo.querySelector('.numeri')!.textContent = `${primi}/6 first try · streak ${s.serie} · best ${s.migliore}`;
    const domani = new Date(adesso.getFullYear(), adesso.getMonth(), adesso.getDate() + 1), ore = Math.max(0, (domani.getTime() - Date.now()) / 36e5);
    riepilogo.querySelector('.domani')!.textContent = `New flights in ${Math.floor(ore)}h ${Math.floor((ore % 1) * 60)}m`;
  };
  const condividi = riepilogo.querySelector<HTMLButtonElement>('.condividi')!;
  condividi.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(testoDaCondividere(n, p, serieOra(n).serie)); condividi.textContent = 'copied ✓'; }
    catch { condividi.textContent = 'copy failed'; }
    setTimeout(() => { condividi.textContent = 'copy result'; }, 1800);
  });

  const scena = monta(document.querySelector<HTMLElement>('.scena3d')!, {
    tinte: voli.map(v => v.tinta), termini: voli.map(v => v.voce.termine), partiti: [...p.fatto],
    alClic: i => apri(i),
    alCambio: f => { fasi = f; scriviTabellone(); },
  });
  const imbarco = nuovoImbarco(document.body, {
    giorno: n, data: adesso, voli, partita: p,
    dopo: (i, giusto) => {
      if (giusto) {
        scena.decolla(i);
        if (p.fatto.every(Boolean)) chiudiGiorno(n);
      }
      scriviTabellone(); scriviGiorno(); scriviRiepilogo();
    },
    prossimo: () => {
      const k = voli.findIndex((_, i) => !p.fatto[i]);
      if (k >= 0) apri(k); else chiudi();
    },
    chiudi: () => chiudi(),
  });
  function apri(i: number) { imbarco.mostra(i); if (!p.fatto[i]) scena.chiama(i); scriviTabellone(); }
  function chiudi() { imbarco.nascondi(); scriviTabellone(); scriviRiepilogo(); righe[0]?.b.focus({ preventScroll: true }); }
  scriviGiorno(); scriviTabellone(); scriviRiepilogo();
</script>

<style>
  .fondo3d { position: fixed; top: 64px; bottom: 0; left: 0; right: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; }
  .aeroporto { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s2); }
  .aeroporto > * { max-width: 400px; margin: 0 0 var(--s1); }
  h1 { font-size: 33px; font-weight: 400; line-height: 1.1; }
  .sotto { color: var(--muted); }
  .giorno { font-size: 12px; color: var(--muted); }
  .tabellone { padding: 0; list-style: none; font-size: 12px; }
  .tabellone :global(button) {
    pointer-events: auto; display: grid; grid-template-columns: 10px 4.5ch 1fr auto; gap: 10px; align-items: center; width: 100%; padding: 5px 8px;
    border: 1px solid transparent; border-radius: 6px; background: color-mix(in srgb, var(--bg) 70%, transparent); color: var(--fg); font: inherit; text-align: left; cursor: pointer;
  }
  .tabellone :global(button:hover), .tabellone :global(button.aperto) { border-color: var(--line); }
  .tabellone :global(i) { width: 10px; height: 10px; border-radius: 50%; box-shadow: 0 0 0 1px color-mix(in srgb, var(--fg) 25%, transparent); }
  .tabellone :global(.codice-volo) { color: var(--muted); }
  .tabellone :global(.stato-volo) { color: var(--muted); white-space: nowrap; }
  .tabellone :global(.partito .stato-volo) { color: var(--fg); }
  .riepilogo { pointer-events: auto; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; background: color-mix(in srgb, var(--bg) 85%, transparent); }
  .riepilogo p { margin: 0 0 6px; font-size: 12px; }
  .riepilogo .quadri { font-size: 20px; letter-spacing: 2px; }
  .riepilogo .domani { color: var(--muted); margin: 8px 0 0; }
  .condividi { padding: 4px 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg); color: var(--fg); cursor: pointer; }
  .condividi:hover { border-color: var(--muted); }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }

  /* La carta d'imbarco olografica: in basso al centro, sopra la scena */
  :global(.imbarco) { position: fixed; left: 50%; bottom: 22px; z-index: 3; width: min(880px, calc(100vw - 40px)); transform: translateX(-50%); }
  :global(.imbarco[hidden]) { display: none; }
  :global(body:has(.imbarco:not([hidden])) .piede) { visibility: hidden; }
  :global(.imbarco .biglietto) { perspective: 1600px; }
  :global(.imbarco .carta) {
    --rx: 0deg; --ry: 0deg; --lx: 50%; --ly: 50%; --tinta: #f7cf4f; --inchiostro: #121417; --stub: 138px;
    position: relative; display: grid; transform-style: preserve-3d; transition: transform .8s cubic-bezier(.3, 1.3, .5, 1);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
  }
  :global(.imbarco .carta.subito) { transition: none; }
  :global(.imbarco .carta.girata) { transform: rotateX(var(--rx)) rotateY(calc(var(--ry) + 180deg)); }
  :global(.imbarco .carta.scossa) { animation: scossa .35s ease-out; }
  @keyframes scossa { 20% { translate: -7px 0; } 45% { translate: 6px 0; } 70% { translate: -3px 0; } }
  :global(.imbarco .faccia) {
    grid-area: 1 / 1; position: relative; display: flex; min-height: 300px; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    color: var(--inchiostro); border-radius: 14px; overflow: hidden; box-shadow: 0 16px 44px rgb(0 0 0 / .38);
    /* La trama di sicurezza: onde sottili ripetute e una rosetta a cerchi, come sulle banconote */
    background-color: var(--tinta);
    background-image: repeating-radial-gradient(circle at 62% 58%, transparent 0 7px, rgb(0 0 0 / .045) 7px 8px), url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='96' height='22'><path d='M0 11 Q12 1 24 11 T48 11 T72 11 T96 11' fill='none' stroke='rgba(0,0,0,.085)'/><path d='M0 17 Q12 7 24 17 T48 17 T72 17 T96 17' fill='none' stroke='rgba(255,255,255,.2)'/></svg>");
    -webkit-mask: radial-gradient(circle 11px at calc(100% - var(--stub)) 0, #0000 98%, #000) top / 100% 51% no-repeat, radial-gradient(circle 11px at calc(100% - var(--stub)) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
    mask: radial-gradient(circle 11px at calc(100% - var(--stub)) 0, #0000 98%, #000) top / 100% 51% no-repeat, radial-gradient(circle 11px at calc(100% - var(--stub)) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
  }
  :global(.imbarco .mono) { font-family: var(--mono); }
  :global(.imbarco .faccia *) { color: inherit; }
  /* Il microtesto sui bordi: da lontano una riga, da vicino le frasi nascoste */
  :global(.imbarco .micro) { position: absolute; left: 0; right: 0; z-index: 1; margin: 0; overflow: hidden; font-size: 5.5px; line-height: 8px; letter-spacing: .16em; white-space: nowrap; opacity: .5; pointer-events: none; }
  :global(.imbarco .micro.su) { top: 3px; }
  :global(.imbarco .micro.giu) { bottom: 3px; }
  /* La foglia olografica: arcobaleno che scorre con il puntatore, righe sottili e brillantini. Senza puntatore luccica da sola */
  :global(.imbarco .foglia) {
    position: absolute; inset: 0; z-index: 2; pointer-events: none; mix-blend-mode: color-dodge; opacity: .4;
    background-image: repeating-linear-gradient(115deg, #ff7eb3 0%, #ffd56a 6%, #7ef0c8 12%, #7fb7ff 18%, #c39bff 24%, #ff7eb3 30%), repeating-linear-gradient(28deg, transparent 0 3px, rgb(255 255 255 / .3) 3px 4px);
    background-size: 320% 320%, 100% 100%; background-position: var(--lx) var(--ly), 0 0;
  }
  :global(.imbarco .foglia)::after {
    content: ''; position: absolute; inset: 0; opacity: .7; mix-blend-mode: overlay;
    background-image: radial-gradient(circle, #fff 0 .8px, transparent 1.4px), radial-gradient(circle, #fff 0 .6px, transparent 1.2px);
    background-size: 23px 19px, 37px 29px; background-position: 0 0, 11px 7px;
  }
  :global(.imbarco .carta:not(.puntato) .foglia) { animation: luccica 7s ease-in-out infinite alternate; }
  @keyframes luccica { from { background-position: 0% 20%, 0 0; } to { background-position: 100% 80%, 0 0; } }
  :global(.imbarco .foglia.velo) { opacity: .16; }
  /* Il riflesso: una luce morbida dove punta il mouse */
  :global(.imbarco .riflesso) { position: absolute; inset: 0; z-index: 3; pointer-events: none; mix-blend-mode: soft-light; background: radial-gradient(circle at var(--lx) var(--ly), rgb(255 255 255 / .55), transparent 42%); opacity: 0; transition: opacity .3s; }
  :global(.imbarco .carta.puntato .riflesso) { opacity: 1; }
  /* Il francobollo dentellato, con il timbro postale a onde sull'angolo */
  :global(.imbarco .francobollo) {
    position: relative; flex: none; align-self: center; width: 150px; height: 188px; margin: 0 6px 0 22px; padding: 7px; background: #fffaf0; rotate: -3deg;
    -webkit-mask: radial-gradient(circle 4px, #0000 96%, #000) -5px -5px / 10px 10px round, linear-gradient(#000 0 0) 5px 5px / calc(100% - 10px) calc(100% - 10px) no-repeat;
    mask: radial-gradient(circle 4px, #0000 96%, #000) -5px -5px / 10px 10px round, linear-gradient(#000 0 0) 5px 5px / calc(100% - 10px) calc(100% - 10px) no-repeat;
  }
  :global(.imbarco .francobollo)::before { content: ''; position: absolute; right: -26px; top: 10px; z-index: 3; width: 90px; height: 40px; background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='90' height='40'><g fill='none' stroke='rgba(20,15,12,.55)' stroke-width='1.6'><path d='M0 8 q11 -6 22 0 t22 0 t22 0 t22 0'/><path d='M0 18 q11 -6 22 0 t22 0 t22 0 t22 0'/><path d='M0 28 q11 -6 22 0 t22 0 t22 0 t22 0'/></g></svg>"); rotate: -12deg; pointer-events: none; }
  :global(.imbarco .scena-f) { position: absolute; inset: 7px; overflow: hidden; }
  :global(.imbarco .scena-f svg) { display: block; width: 100%; height: 100%; }
  :global(.imbarco .francobollo .foglia) { inset: 7px; opacity: .45; }
  :global(.imbarco .corpo-biglietto) { position: relative; z-index: 1; flex: 1; min-width: 0; padding: 22px 20px 16px; }
  :global(.imbarco .testa) { margin: 0; font-size: 10px; letter-spacing: .22em; text-transform: uppercase; opacity: .75; }
  :global(.imbarco .rotta) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin: 6px 0 2px; text-transform: uppercase; }
  :global(.imbarco .rotta small) { font-size: 8px; letter-spacing: .14em; opacity: .65; }
  :global(.imbarco .rotta .aeroporto) { font-size: 26px; line-height: 1; letter-spacing: .04em; }
  :global(.imbarco .rotta .aereoplanino) { font-style: normal; font-size: 16px; }
  :global(.imbarco .rotta .gruppo) { flex-basis: 100%; font-size: 10px; letter-spacing: .06em; opacity: .7; }
  :global(.imbarco .termine) { margin: 10px 0 4px; font-family: var(--mono); font-size: 22px; font-weight: 400; line-height: 1.05; text-transform: uppercase; overflow-wrap: anywhere; }
  :global(.imbarco .domanda) { margin: 0 0 10px; font-size: 14px; line-height: 1.4; }
  :global(.imbarco .opzioni) { position: relative; z-index: 1; display: grid; gap: 6px; }
  :global(.imbarco .opzione) {
    display: flex; gap: 10px; align-items: baseline; width: 100%; min-height: 38px; padding: 7px 11px; border: 1.5px solid var(--inchiostro); border-radius: 6px;
    background: color-mix(in srgb, var(--tinta) 70%, #fff); color: var(--inchiostro); font-size: 13px; line-height: 1.3; text-align: left; cursor: pointer; transition: background .15s, transform .15s;
  }
  :global(.imbarco .opzione span) { flex: none; opacity: .6; }
  :global(.imbarco .opzione:hover:not(:disabled)) { background: color-mix(in srgb, var(--inchiostro) 12%, var(--tinta)); transform: translateX(2px); }
  :global(.imbarco .opzione:disabled) { cursor: default; opacity: .5; }
  :global(.imbarco .opzione.giusta) { opacity: 1; background: var(--inchiostro); color: var(--tinta); }
  :global(.imbarco .opzione.sbagliata) { text-decoration: line-through; }
  :global(.imbarco .nota) { margin: 8px 0 0; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; opacity: .8; }
  /* I timbri: solo inchiostro, sopra la domanda, non prendono i clic */
  :global(.imbarco .timbri) { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  :global(.imbarco .timbro) { position: absolute; width: 124px; height: 124px; transform: rotate(var(--a)); opacity: 1; mix-blend-mode: multiply; }
  :global(.imbarco .timbro svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  :global(.imbarco .timbro.cade) { animation: cade .5s cubic-bezier(.2, 1.5, .4, 1) both; }
  @keyframes cade { 0% { transform: rotate(calc(var(--a) - 14deg)) scale(1.9); opacity: 0; } 45% { transform: rotate(var(--a)) scale(.94); opacity: .95; } 70% { transform: rotate(var(--a)) scale(1.03); } 100% { transform: rotate(var(--a)) scale(1); opacity: 1; } }
  /* La banda olografica: argento iridescente, con il nome in verticale e il numero */
  :global(.imbarco .olo) {
    position: relative; z-index: 1; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: space-between; width: 62px; padding: 16px 0 14px; overflow: hidden; color: #1a1d24;
    background: linear-gradient(180deg, #e7ebf1, #c9d0da 50%, #eef1f5);
  }
  :global(.imbarco .olo .foglia) { opacity: .95; mix-blend-mode: multiply; background-size: 100% 500%, 100% 100%; background-position: 0 var(--lx), 0 0; }
  :global(.imbarco .carta:not(.puntato) .olo .foglia) { animation: luccicaOlo 5s ease-in-out infinite alternate; }
  @keyframes luccicaOlo { from { background-position: 0 0%, 0 0; } to { background-position: 0 100%, 0 0; } }
  :global(.imbarco .olo p) { position: relative; z-index: 3; margin: 0; }
  :global(.imbarco .olo .numero) { font-size: 13px; letter-spacing: .04em; }
  :global(.imbarco .olo-titolo) { writing-mode: vertical-rl; rotate: 180deg; font-size: 24px; letter-spacing: .3em; -webkit-text-stroke: 1px #1a1d24; color: transparent; }
  :global(.imbarco .olo-micro) { writing-mode: vertical-rl; rotate: 180deg; font-size: 6px; letter-spacing: .25em; opacity: .7; }
  /* Il tagliando: volo, data, posto, codice quadrato e codice a barre */
  :global(.imbarco .tagliando) {
    position: relative; z-index: 1; flex: none; display: flex; flex-direction: column; gap: 8px; width: var(--stub); padding: 18px 14px 14px;
    border-left: 2px dashed color-mix(in srgb, var(--inchiostro) 45%, transparent); background: color-mix(in srgb, var(--tinta) 68%, #fff);
  }
  :global(.imbarco .tag-codice) { margin: 0; font-size: 26px; line-height: 1; letter-spacing: .04em; }
  :global(.imbarco .griglia) { display: grid; grid-template-columns: auto 1fr; gap: 2px 8px; margin: 0; font-size: 9px; text-transform: uppercase; }
  :global(.imbarco .griglia dt) { opacity: .6; letter-spacing: .1em; }
  :global(.imbarco .griglia dd) { margin: 0; font-size: 11px; text-align: right; }
  :global(.imbarco .qr) { display: grid; grid-template-columns: repeat(7, 1fr); width: 42px; height: 42px; margin-top: auto; }
  :global(.imbarco .qr i.pieno) { background: var(--inchiostro); }
  :global(.imbarco .codice) { display: flex; height: 30px; }
  :global(.imbarco .codice span) { display: block; height: 100%; background: var(--inchiostro); }
  :global(.imbarco .tag-piede) { margin: 0; font-size: 7px; letter-spacing: .2em; text-transform: uppercase; opacity: .6; }
  /* Dietro: il premio. L'illustrazione occupa tutto il biglietto; la foglia olografica la fa brillare come una carta rara */
  :global(.imbarco .retro) { transform: rotateY(180deg); -webkit-mask: none; mask: none; background: #12151b; }
  :global(.imbarco .grafica) { position: absolute; inset: 0; }
  :global(.imbarco .grafica svg) { display: block; width: 100%; height: 100%; }
  :global(.imbarco .foglia.premio) { opacity: .22; }
  :global(.imbarco .retro-testa) { position: absolute; left: 14px; right: 14px; top: 12px; z-index: 4; display: flex; justify-content: space-between; gap: 10px; pointer-events: none; }
  :global(.imbarco .retro-testa p) { margin: 0; padding: 4px 10px; border-radius: 999px; background: rgb(255 250 240 / .9); color: #121417; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
  :global(.imbarco .retro-piede) { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; padding: 40px 18px 14px; background: linear-gradient(transparent, rgb(10 12 16 / .55)); }
  :global(.imbarco .retro .termine) { margin: 0; color: #fffaf0; font-size: 26px; text-shadow: 0 2px 0 rgb(0 0 0 / .45); }
  :global(.imbarco .leggi), :global(.imbarco .chiudi-pannello) { flex: none; padding: 6px 12px; border: 1px solid #121417; border-radius: 999px; background: #fffaf0; color: #121417; font-size: 11px; cursor: pointer; }
  :global(.imbarco .pannello) {
    position: absolute; inset: 0; z-index: 5; display: flex; flex-direction: column; padding: 20px 24px 14px; background: rgb(255 250 240 / .97); color: #121417;
    transform: translateY(102%); transition: transform .45s cubic-bezier(.3, 1.1, .5, 1);
  }
  :global(.imbarco .retro.legge .pannello) { transform: none; }
  :global(.imbarco .pannello .chiudi-pannello) { align-self: flex-end; margin-top: 10px; }
  :global(.imbarco .definizione) { flex: 1; overflow-y: auto; font-size: 13px; line-height: 1.6; touch-action: pan-y; }
  :global(.imbarco .definizione h3) { margin: 0 0 8px; font-size: 12px; font-weight: 400; letter-spacing: .12em; text-transform: uppercase; }
  :global(.imbarco .definizione p) { margin: 0 0 8px; color: inherit; }
  :global(.imbarco .definizione ul) { margin: 0 0 8px; padding-left: 18px; }
  :global(.imbarco .definizione li) { margin-bottom: 5px; }
