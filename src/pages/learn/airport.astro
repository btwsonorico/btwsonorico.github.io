---
import Base from '../../layouts/Base.astro';

// AI terms: sei aerei girano intorno all'isola, uno per sezione del glossario. Il gioco è una partita a punti senza fine,
// con tre vite: ogni risposta giusta vale punti, e le giuste di fila al primo colpo fanno la combo, che moltiplica i punti.
// All'inizio un aereo a caso è già sulla pista; altri due aspettano in fila sui cerchi di attesa, così la domanda
// dopo è sempre pronta. Quando l'aereo in pista riparte, il primo della fila atterra e un aereo nuovo si mette in fila.
// Logica in src/lib/voli.ts, scena in src/scripts/aeroporto.ts, biglietto in src/scripts/bigliettoImbarco.ts
---
<Base title="AI terms · Riccardo Mondi" description="A trivia game about the AI lexicon." tono="neutro" largo>
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="aeroporto">
    <h1>AI terms</h1>
    <p class="sotto">A trivia game about the AI lexicon.</p>
    <section class="pannello-gioco" aria-live="polite">
      <div class="stato-gioco inizio">
        <button type="button" class="mono grande avvia">Take off ✈</button>
        <div class="mono punteggio"></div>
      </div>
      <div class="stato-gioco in-gioco" hidden>
        <p class="mono titolo-stato"></p>
        <p class="mono piccolo dettaglio"></p>
        <button type="button" class="mono piccolo esci">stop</button>
      </div>
      <div class="pausa-menu" hidden>
        <div class="fine-carta" role="dialog" aria-labelledby="pausa-titolo">
          <p class="mono fine-titolo pausa-titolo" id="pausa-titolo">Paused</p>
          <button type="button" class="mono grande riprendi">Resume ✈</button>
          <button type="button" class="mono esci-partita">quit the game</button>
        </div>
      </div>
      <div class="stato-gioco fine" hidden>
        <div class="fine-carta" role="dialog" aria-labelledby="fine-titolo">
          <p class="mono fine-titolo" id="fine-titolo">Game over</p>
          <p class="mono fine-record" hidden>new record ★</p>
          <p class="mono fine-punti"><small>score</small><b class="fine-numero">00</b></p>
          <dl class="mono fine-dati">
            <div><dt>cleared</dt><dd class="fine-giuste">0</dd></div>
            <div><dt>best combo</dt><dd class="fine-combo">0</dd></div>
            <div><dt>best</dt><dd class="fine-best">0</dd></div>
          </dl>
          <button type="button" class="mono grande avvia">Fly again ✈</button>
          <button type="button" class="mono copia">copy result</button>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import '@fontsource/instrument-serif/400-italic.css';
  import '@fontsource/anton/latin-400.css';
  import { monta } from '../../scripts/aeroporto';
  import { nuovoImbarco } from '../../scripts/bigliettoImbarco';
  import { anteprima, campionario } from '../../scripts/anteprimaBiglietti';
  // Solo per lo sviluppo: ?anteprima mostra una galleria di biglietti
  { const q = new URLSearchParams(location.search).get('anteprima'); if (q === 'tinte') campionario(); else if (q !== null) anteprima(); }
  import { aCaso, aCasoFuori, azzera, nuovaPartita, nuovoVolo, primati, segnaPrimato, segnaRisposta, serie, SEZIONI, voloDa, type Voce } from '../../lib/voli';

  type Modo = 'inizio' | 'in-gioco' | 'fine';
  const adesso = new Date(), recenti: string[] = [];
  const voli = SEZIONI.map((_, i) => { const v = nuovoVolo(i, recenti); recenti.push(v.voce.id); return v; });
  const p = nuovaPartita(voli.length);
  const $ = <T extends HTMLElement>(s: string, d: ParentNode = document) => d.querySelector<T>(s)!;
  const punteggio = $('.punteggio');
  const stati = Object.fromEntries([...document.querySelectorAll<HTMLElement>('.stato-gioco')].map(e => [e.classList[1], e])) as Record<Modo, HTMLElement>;

  // Lo stato della partita: vite, punti, combo (giuste di fila al primo colpo), la domanda in pista e quella in fila
  const VITE = 5;
  let modo: Modo = 'inizio', vite = VITE, punti = 0, combo = 0, migliorCombo = 0, giuste = 0, ultimiPunti = '';
  // La fila: le due domande dopo, ognuna con il suo aereo sui cerchi di attesa
  let corrente = -1, fila: Voce[] = [], domandeFatte = 0;
  // Gli aiuti: il pilota automatico (risponde giusto da solo), i punti doppi per qualche domanda; il premio della carta Holo
  let pilota = 0, doppi = 0, premioDa = false;

  // I punti stanno in due cifre: una giusta al primo colpo vale quanto la combo (1, 2, 3, 4, poi 5 al massimo);
  // una giusta dopo un errore vale 1
  const valore = (primo: boolean, c: number) => (primo ? Math.min(5, Math.max(1, c)) : 1);
  const record = () => primati().punti ?? 0;
  const riassunto = () => `score ${punti} · combo ${combo} · best ${record()}`;
  // Il punteggio come in un gioco: badge separati per punti, vite, combo e record
  // Il punteggio come in un cabinato arcade: quattro riquadri, etichetta piccola sopra e numero grande sotto
  const badge = (classe: string, etichetta: string, valore: string) => { const b = document.createElement('div'); b.className = `hud ${classe}`; const sm = document.createElement('small'); sm.textContent = etichetta; const v = document.createElement('b'); v.textContent = valore; b.append(sm, v); return b; };
  const scriviPunteggio = () => {
    // Il contatore della partita sta sul tagliando del biglietto; qui resta solo il record, sotto il bottone per partire
    // Prima di partire solo il bottone «Take off»: niente record qui
    if (modo !== 'fine') { punteggio.replaceChildren(); return; }
    punteggio.replaceChildren(
      badge('hud-punti', 'score', String(punti).padStart(2, '0')),
      badge('hud-vite', 'lives', cuori()),
      badge(`hud-combo${combo > 1 ? ' attiva' : ''}`, 'combo', `x${combo}`),
      badge('hud-best', 'best', String(Math.max(record(), punti)).padStart(2, '0')),
    );
  };
  const cuori = () => '♥'.repeat(Math.max(0, vite)) + '♡'.repeat(Math.max(0, VITE - vite));
  const scriviStato = () => {
    scriviPunteggio();
    tastoPausa.hidden = modo !== 'in-gioco';
    for (const [m, e] of Object.entries(stati)) e.hidden = m !== modo;
    const e = stati[modo];
    if (modo === 'inizio') { /* solo il bottone per partire */ }
    else if (modo === 'in-gioco') {
      $('.titolo-stato', e).textContent = `${punti} pts · ${cuori()}${combo > 1 ? ` · combo ${combo}` : ''}${doppi ? ` · 2× pts (${doppi})` : ''}${pilota ? ` · autopilot ${pilota}` : ''}`;
      $('.dettaglio', e).textContent = ultimiPunti || 'answer at the first try to start a combo';
    } else {
      // La schermata di fine: il punteggio grande, i numeri della partita, il bottone per ripartire subito
      $('.fine-numero', e).textContent = String(punti).padStart(2, '0');
      $('.fine-giuste', e).textContent = String(giuste);
      $('.fine-combo', e).textContent = String(migliorCombo);
      $('.fine-best', e).textContent = String(record());
      $('.fine-record', e).hidden = !nuovoRecord;
      $('.fine-titolo', e).textContent = vite <= 0 ? 'Out of fuel' : 'Game over';
    }
  };

  const scena = monta($('.scena3d'), {
    tinte: voli.map(v => v.tinta), termini: voli.map(v => v.voce.termine), partiti: voli.map(() => false),
    // Prima di partire, un clic su un aereo apre una domanda della sua sezione, fuori partita
    alClic: i => { if (modo === 'in-gioco') return; prova(i); },
    alCambio: () => {},
  });
  // Una domanda va all'aereo della sua sezione: l'aereo atterra (o è già in pista), il biglietto si apre subito
  function metti(voce: Voce, giaInPista = false) {
    const v = voloDa(voce), i = v.indice;
    recenti.push(voce.id); if (recenti.length > 24) recenti.shift();
    voli[i] = v;
    azzera(p, i);
    scena.riposa(i, voce.termine);
    if (giaInPista) scena.posa(i); else scena.atterra(i);
    corrente = i;
    if (modo === 'in-gioco') domandeFatte++;
    imbarco.mostra(i);
  }
  // La fila: sempre due domande di sezioni diverse da quella in pista e fra loro, così ogni aereo è un altro
  function riempiFila() {
    while (fila.length < 2) {
      const usate = [voli[corrente]?.sezione ?? -1, ...fila.map(v => v.indiceSezione)];
      const v = aCasoFuori([...recenti, ...fila.map(x => x.id)], usate);
      fila.push(v);
      scena.riposa(SEZIONI.indexOf(v.indiceSezione), v.termine);
    }
    fila.forEach((v, posto) => scena.inAttesa(SEZIONI.indexOf(v.indiceSezione), posto));
  }
  function prova(i: number) { modo = 'inizio'; metti(nuovoVolo(i, recenti).voce); }
  const avvia = () => {
    vite = VITE; punti = 0; combo = 0; migliorCombo = 0; giuste = 0; domandeFatte = 0; pilota = 0; doppi = 0; premioDa = false; ultimiPunti = ''; modo = 'in-gioco';
    fila = []; metti(aCaso(recenti), true); riempiFila(); scena.serie(0, 0);
    scriviPunteggio(); scriviStato();
  };
  let nuovoRecord = false;
  const fine = () => {
    imbarco.nascondi(); scena.liberaTutti(); fila = []; modo = 'fine';
    nuovoRecord = segnaPrimato('punti', punti) && punti > 0;
    if (nuovoRecord) scena.fuochi();
    scriviPunteggio(); scriviStato();
    (stati.fine.querySelector('.avvia') as HTMLButtonElement | null)?.focus({ preventScroll: true });
  };
  document.querySelectorAll('.avvia').forEach(b => b.addEventListener('click', avvia));
  document.querySelectorAll('.esci').forEach(b => b.addEventListener('click', fine));
  // La pausa: un tasto ⏸ nella barra in alto, solo in partita. Apre il menu con «resume» e «quit the game»
  const tastoPausa = document.createElement('button');
  tastoPausa.type = 'button'; tastoPausa.className = 'mono tasto-pausa'; tastoPausa.textContent = '⏸'; tastoPausa.setAttribute('aria-label', 'pause the game'); tastoPausa.hidden = true;
  document.querySelector('.barra nav')?.prepend(tastoPausa);
  // Il menu sta nel body: su telefono, in partita, il pannello del gioco è nascosto
  const menuPausa = $('.pausa-menu'); document.body.append(menuPausa);
  tastoPausa.addEventListener('click', () => { menuPausa.hidden = false; $<HTMLButtonElement>('.riprendi', menuPausa).focus(); });
  $('.riprendi').addEventListener('click', () => { menuPausa.hidden = true; });
  $('.esci-partita').addEventListener('click', () => { menuPausa.hidden = true; fine(); });
  $('.copia').addEventListener('click', async e => {
    const b = e.currentTarget as HTMLButtonElement, testo = `AI terms ✈ ${punti} pts · ${giuste} cleared · best combo ${migliorCombo}\nhttps://btwsonorico.github.io/learn/airport/`;
    try { await navigator.clipboard.writeText(testo); b.textContent = 'copied ✓'; } catch { b.textContent = 'copy failed'; }
    setTimeout(() => { b.textContent = 'copy result'; }, 1800);
  });

  const imbarco = nuovoImbarco(document.body, {
    data: adesso, voli, partita: p, riassunto,
    // La combo decide la lamina del biglietto: niente a 0, argento a 1, oro a 2, arcobaleno da 3
    serie: () => combo,
    senzaChiudi: () => modo === 'in-gioco',
    arcade: () => (modo === 'in-gioco' ? { vite, viteMax: VITE, combo, punti } : null),
    // Sotto il biglietto: il pilota automatico prima di rispondere; dopo la carta Holo, i tre premi da scegliere
    extra: fatto => {
      if (modo !== 'in-gioco') return [];
      if (!fatto && pilota > 0) return [{ testo: `autopilot ✈ (${pilota})`, classe: 'aiuto', fai: () => { pilota--; imbarco.risolvi(); scriviStato(); } }];
      return [];
    },
    testoProssimo: () => (modo === 'in-gioco' ? (vite > 0 ? 'next flight →' : 'see your score →') : 'close'),
    dopo: (i, giusto) => {
      const primo = p.tentativi[i] === 1, prima = serie().migliore;
      if (!giusto) {
        segnaRisposta(false, false);
        if (modo === 'in-gioco') { vite--; combo = 0; ultimiPunti = `wrong · ${cuori()}`; }
      } else {
        const dopo = segnaRisposta(true, primo);
        if (dopo.migliore > prima && dopo.migliore >= 2) scena.fuochi();
        scena.decolla(i);
        if (modo === 'in-gioco') {
          combo = primo ? combo + 1 : 0; migliorCombo = Math.max(migliorCombo, combo); giuste++;
          const vinti = valore(primo, combo) * (doppi > 0 ? 2 : 1);
          punti += vinti;
          ultimiPunti = `+${vinti}${combo > 1 ? ` · combo ${combo}` : ''}${doppi > 0 ? ' · 2× pts' : ''}`;
          if (doppi > 0) doppi--;
          // La carta Holo, se indovinata, fa scegliere un premio
          if (domandeFatte % 10 === 0 && vite > 0) premioDa = true;
        }
      }
      scena.serie(punti, combo);
      scriviPunteggio(); scriviStato();
      if (modo === 'in-gioco' && vite <= 0) window.setTimeout(fine, 1300);
    },
    prossimo: () => {
      if (modo !== 'in-gioco') { imbarco.nascondi(); return; }
      if (vite <= 0) { fine(); return; }
      // Il primo della fila atterra, il secondo scende al suo posto, e un aereo nuovo si mette in fila
      const avanti = () => { const v = fila.shift() ?? aCaso(recenti); metti(v); riempiFila(); scriviStato(); };
      // Ogni 10 domande la carta bonus: si sceglie un premio, la carta si gira e mostra la lamina, poi si riparte
      if (premioDa) {
        premioDa = false;
        const prendi = (f: () => void) => () => { f(); scriviPunteggio(); scriviStato(); };
        imbarco.mostraBonus([
          { testo: '+1 life ♥', fai: prendi(() => { vite++; }) },
          { testo: 'Autopilot ✈ · answers one for you', fai: prendi(() => { pilota++; }) },
          { testo: 'Double points for 3 questions', fai: prendi(() => { doppi = 3; }) },
        ], avanti);
        return;
      }
      avanti();
    },
    chiudi: () => { if (modo === 'in-gioco') fine(); else imbarco.nascondi(); },
  });
  void corrente;
  scriviPunteggio(); scriviStato();
  scena.serie(0, 0);
</script>

<style>
  .fondo3d { position: fixed; top: 64px; bottom: 0; left: 0; right: 0; z-index: 0; }
  /* Sul computer, con il biglietto aperto, la scena resta grande e sale di metà biglietto: l'isola sta al centro dello
     spazio libero sopra il biglietto, alla stessa grandezza, con gli aerei intorno */
  .fondo3d { transition: transform .6s cubic-bezier(.3, .9, .3, 1); }
  /* Il bordo in basso della scena sfuma nel fondo della pagina: niente taglio netto dove la scena finisce */
  .fondo3d { -webkit-mask: linear-gradient(#000 0 82%, transparent); mask: linear-gradient(#000 0 82%, transparent); }
  /* La scena si allunga di 190 px in basso (niente fascia vuota ai lati del biglietto) e sale di 285: il centro finisce
     a metà dello spazio sopra il biglietto */
  @media (min-width: 641px) and (min-height: 501px) { :global(body:has(.imbarco:not([hidden]))) .fondo3d { bottom: -190px; transform: translateY(-285px); } }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; }
  .aeroporto { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s2); }
  .aeroporto > * { max-width: 400px; margin: 0 0 var(--s1); }
  h1 { font-size: 33px; font-weight: 400; line-height: 1.1; }
  .sotto { color: var(--muted); }
  /* Il pannello arcade: riquadri a bordo doppio, etichette maiuscole piccole, numeri grandi nel font a pixel del sito */
  .punteggio { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; max-width: 360px; font-family: var(--mono); }
  .punteggio :global(.hud) { display: flex; flex-direction: column; gap: 2px; padding: 8px 12px 10px; border: 2px solid var(--fg); box-shadow: inset 0 0 0 2px var(--bg), inset 0 0 0 3px var(--line); background: color-mix(in srgb, var(--bg) 80%, transparent); image-rendering: pixelated; }
  .punteggio :global(.hud small) { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .punteggio :global(.hud b) { font-weight: 400; font-size: 34px; line-height: 1; color: var(--fg); letter-spacing: .04em; }
  .punteggio :global(.hud-punti b) { color: #ffd84a; text-shadow: 3px 3px 0 #a3561a; }
  .punteggio :global(.hud-vite b) { color: #ff5a6e; font-size: 24px; letter-spacing: .12em; line-height: 34px; }
  .punteggio :global(.hud-combo.attiva) { border-color: #6fe3ff; }
  .punteggio :global(.hud-combo.attiva b) { color: #6fe3ff; }
  .pannello-gioco { pointer-events: auto; max-width: 360px; }
  .pannello-gioco .in-gioco { display: none; }
  .pannello-gioco .punteggio { margin-top: 10px; grid-template-columns: 1fr; }
  /* Il tagliando: nome; categoria e difficoltà in una riga; poi score, vite e moltiplicatore grandi; in fondo il numero della
     definizione accanto al codice a barre */
  :global(.imbarco .tagliando .metadati) { display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: baseline; justify-content: flex-start; margin-top: 0; }
  :global(.imbarco .fondo-coda) { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; }
  :global(.imbarco .fondo-coda .citazione) { margin: 0; font-size: 13px; font-weight: 700; }
  :global(.imbarco .arcade) { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 8px; margin: 6px 0; padding: 8px 0; border-top: 2px solid var(--inchiostro); border-bottom: 2px solid var(--inchiostro); }
  :global(.imbarco .arcade[hidden]) { display: none; }
  :global(.imbarco .arcade .ar) { display: flex; flex-direction: column; gap: 1px; }
  :global(.imbarco .arcade small) { font-size: 8px; letter-spacing: .2em; text-transform: uppercase; opacity: .65; }
  :global(.imbarco .arcade b) { font-weight: 400; line-height: 1; }
  :global(.imbarco .arcade .ar-punti b) { font-size: 34px; }
  :global(.imbarco .arcade .ar-vite b) { font-size: 20px; color: #e0364c; letter-spacing: .06em; }
  :global(.imbarco .arcade .ar-combo b) { font-size: 34px; text-shadow: 2px 2px 0 color-mix(in srgb, currentColor 30%, transparent); }
  :global(.imbarco .arcade .ar-combo.c0 b) { color: var(--inchiostro); }
  :global(.imbarco .arcade .ar-combo.c1 b) { color: #17a34a; }
  :global(.imbarco .arcade .ar-combo.c2 b) { color: #d9a400; }
  :global(.imbarco .arcade .ar-combo.c3 b) { color: #ea6a12; }
  :global(.imbarco .arcade .ar-combo.c4 b) { color: #e0307a; }
  /* La fine partita: una carta arcade al centro dello schermo, sopra la scena */
  :global(.pausa-menu[hidden]) { display: none !important; }
  :global(.pausa-menu:not([hidden])) { position: fixed; inset: 0; z-index: 7; display: grid; place-items: center; padding: 20px; background: color-mix(in srgb, var(--bg) 55%, transparent); backdrop-filter: blur(3px); }
  .pausa-titolo { color: var(--fg) !important; }
  :global(.pausa-menu button) { width: 100%; padding: 8px 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg); color: var(--fg); font: 13px var(--mono); cursor: pointer; }
  :global(.pausa-menu button.grande) { padding: 14px; border: 0; background: var(--fg); color: var(--bg); font-size: 18px; }
  :global(.tasto-pausa) { padding: 0 8px; border: 1px solid var(--line); background: none; color: var(--fg); font: inherit; cursor: pointer; margin-right: 8px; }
  :global(.tasto-pausa[hidden]) { display: none; }
  .pannello-gioco .fine:not([hidden]) { position: fixed; inset: 0; z-index: 6; display: grid; place-items: center; padding: 20px; background: color-mix(in srgb, var(--bg) 55%, transparent); backdrop-filter: blur(3px); animation: appare .35s ease-out; }
  @keyframes appare { from { opacity: 0; } }
  .fine-carta { width: min(360px, 100%); display: grid; gap: 12px; padding: 22px 20px; border: 2px solid var(--fg); box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 4px var(--line), 6px 6px 0 color-mix(in srgb, var(--fg) 25%, transparent); background: var(--bg); text-align: center; }
  .fine-carta > * { margin: 0; }
  .fine-titolo { font-size: 30px; letter-spacing: .08em; text-transform: uppercase; color: #ff5a6e; }
  .fine-record { font-size: 13px; letter-spacing: .2em; text-transform: uppercase; color: #ffd84a; }
  .fine-punti { display: grid; gap: 2px; }
  .fine-punti small { font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); }
  .fine-punti b { font-weight: 400; font-size: 72px; line-height: 1; color: #ffd84a; text-shadow: 4px 4px 0 #a3561a; }
  .fine-dati { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .fine-dati div { padding: 6px 4px; border: 1px solid var(--line); }
  .fine-dati dt { font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .fine-dati dd { margin: 2px 0 0; font-size: 22px; }
  .fine-carta button.grande { font-size: 18px !important; padding: 14px !important; }
  .stato-gioco > * { margin: 0 0 8px; }
  .stato-gioco > *:last-child { margin-bottom: 0; }
  .pannello-gioco button { padding: 6px 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg); color: var(--fg); font-size: 12px; cursor: pointer; }
  .pannello-gioco button:hover { border-color: var(--fg); }
  .pannello-gioco button.grande { width: 100%; padding: 12px 14px; border: 0; background: var(--fg); color: var(--bg); font-size: 15px; letter-spacing: .04em; }
  .pannello-gioco button.grande:hover { opacity: .88; }
  .pannello-gioco button.piccolo { padding: 3px 10px; color: var(--muted); }
  .piccolo { font-size: 11px; color: var(--muted); }
