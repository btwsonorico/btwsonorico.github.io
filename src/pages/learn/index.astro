---
import Base from '../../layouts/Base.astro';

// Learn: la valle è il menu. Reef è tolto per ora (la pagina resta in /learn/ai-terms/). Ogni mongolfiera porta a una risorsa, la stessa lista sta anche nel testo. L'ordine è un crescendo di difficoltà; il tono lega ogni pagina al suo pallone
// Tre sezioni, divise per cosa fa chi visita: play (giochi con un punteggio), try (modelli veri da toccare), read (da consultare)
// I colori seguono l'arcobaleno lungo tutta la lista: rosso, arancio, giallo, verde, azzurro, lilla, rosa. Il tono è anche
// il colore della mongolfiera
const RISORSE = [
  { nome: 'neural network', href: '/learn/neural-network/', nota: 'teach it to draw', tono: 'rosso', sezione: 'try' },
  { nome: 'reinforcement learning', href: '/learn/reinforcement/', nota: 'a dog learns to herd', tono: 'arancio', sezione: 'try' },
  { nome: 'diffusion model', href: '/learn/diffusion/', nota: 'from noise to a shape', tono: 'giallo', sezione: 'try' },
  { nome: 'decision model', href: '/learn/decision/', nota: 'a smart home in plain words', tono: 'verde', sezione: 'try' },
  { nome: 'text-to-speech model', href: '/learn/t2s/', nota: 'a voice in your browser', tono: 'azzurro', sezione: 'try' },
  { nome: 'AI terms', href: '/learn/airport/', nota: 'trivia on the AI lexicon', tono: 'lilla', sezione: 'play' },
  { nome: 'AI timeline', href: '/learn/timeline/', nota: 'AI history, 1943 to today', tono: 'rosa', sezione: 'read' },
];
const SEZIONI = ['try', 'play', 'read'] as const;
---
<Base title="Learn · Riccardo Mondi" description="AI concepts you can touch: interactive resources by Riccardo Mondi." tono="neutro" largo>
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="learn" data-risorse={JSON.stringify(RISORSE.map(({ nome, href, tono }) => ({ nome, href, tono })))}>
    <h1>Learn</h1>
    <p class="sotto">AI concepts you can touch. Pick a balloon.</p>
    <!-- Ogni voce è una riga: il nome nel colore della sua mongolfiera, la nota subito dopo -->
    <ul class="lista">
      {SEZIONI.map(sz => <>
        <li class="mono titolo-sezione">/{sz}</li>
        {RISORSE.filter(r => r.sezione === sz).map(r => <li data-colore={r.tono}><a href={r.href} data-risorsa={r.nome}>{r.nome}</a><span class="mono">{r.nota}</span></li>)}
      </>)}
    </ul>
  </main>
</Base>

<script>
  const pagina = document.querySelector<HTMLElement>('[data-risorse]')!;
  const risorse = (JSON.parse(pagina.dataset.risorse!) as { nome: string; href: string; tono: string }[]).map(r => ({
    ...r, lista: pagina.querySelector<HTMLElement>(`[data-risorsa="${r.nome}"]`),
  }));
  import('../../scripts/nuvole').then(m => m.monta(document.querySelector<HTMLElement>('.scena3d')!, risorse));
</script>

<style>
  /* La valle copre lo schermo, dietro al testo; il testo lascia passare il puntatore tranne sui link */
  .fondo3d { position: fixed; inset: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; }
  .learn { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s4); }
  .learn a { pointer-events: auto; }
  .learn > * { width: fit-content; max-width: 420px; }
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .sotto { margin: 0 0 var(--s3); color: var(--muted); }
  .lista { margin: 0 0 var(--s2); padding: 0; list-style: none; }
  .lista .titolo-sezione:first-child { margin-top: 0; }
  .lista .titolo-sezione { display: block; margin: var(--s3) 0 var(--s1); font-size: 13px; color: var(--muted); }
  .lista li { display: flex; align-items: baseline; gap: var(--s1); margin-bottom: 4px; }
  /* I colori delle mongolfiere (uguali a src/scripts/nuvole.ts), in tema scuro e chiaro */
  .lista li { --c: var(--fg); }
  .lista li[data-colore='rosso'] { --c: #ff4a3d; } .lista li[data-colore='arancio'] { --c: #e08a3a; } .lista li[data-colore='giallo'] { --c: #e6c229; }
  .lista li[data-colore='verde'] { --c: #6fa646; } .lista li[data-colore='azzurro'] { --c: #5fb6d9; } .lista li[data-colore='lilla'] { --c: #b79ce6; } .lista li[data-colore='rosa'] { --c: #ff7ab8; }
  :global(:root[data-theme='light']) .lista li[data-colore='rosso'] { --c: #e0352a; } :global(:root[data-theme='light']) .lista li[data-colore='giallo'] { --c: #a8880f; } :global(:root[data-theme='light']) .lista li[data-colore='rosa'] { --c: #b3155c; }
  .lista a { padding: 0 5px; margin-left: -5px; font-size: 13px; line-height: 1.6; color: var(--fg); text-decoration-color: var(--c); }
  .lista a:hover { color: var(--bg); background: var(--c); text-decoration: none; }
  .lista span { font-size: 12px; line-height: 1.4; color: var(--muted); width: fit-content; }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  /* Il piede non deve coprire i tasti della scena in basso */
  :global(.piede) { pointer-events: none; }
  /* Etichette come nella home, ognuna nel colore del suo pallone. Il nome di una mongolfiera è un link */
  .scena3d :global(.etichetta) {
    position: absolute; left: 0; top: 0; pointer-events: none; white-space: nowrap;
    padding: 1px 5px; font-family: var(--mono); font-size: 11px; color: var(--accent);
    transition: opacity .15s;
  }
  .scena3d :global(.nome-pallone) { pointer-events: auto; text-decoration: none; will-change: transform; }
  .scena3d :global(.nome-pallone[data-tono="lilla"]) { --accent: #b79ce6; }
  :global([data-theme="light"]) .scena3d :global(.nome-pallone[data-tono="lilla"]) { --accent: #6a4bb0; }
  .scena3d :global(.nome-pallone[data-tono="giallo"]) { --accent: #e6c229; }
  :global([data-theme="light"]) .scena3d :global(.nome-pallone[data-tono="giallo"]) { --accent: #8f7300; }
  .scena3d :global(.nome-pallone[data-tono="grigio"]) { --accent: var(--fg); }
  .scena3d :global(.nome-pallone[data-tono="rosso"]) { --accent: #ff4a3d; }
  :global([data-theme="light"]) .scena3d :global(.nome-pallone[data-tono="rosso"]) { --accent: #e0352a; }
  .scena3d :global(.nome-pallone[data-tono="rosa"]) { --accent: #ff7ab8; }
  :global([data-theme="light"]) .scena3d :global(.nome-pallone[data-tono="rosa"]) { --accent: #b3155c; }
  /* Col dito si tocca un'area più grande dell'etichetta */
  .scena3d :global(.nome-pallone)::before { content: ''; position: absolute; inset: -9px -6px; }
  .scena3d :global(.nome-pallone:hover), .scena3d :global(.nome-pallone.attiva) { color: var(--bg); background: var(--accent); padding: 2px 7px; z-index: 2; }
  .scena3d :global(.nome-pallone.attiva)::after { content: ' · open →'; }
  /* Telefono: la valle sta in una fascia in alto, il testo sotto */
  @media (max-width: 640px) {
    .fondo3d { position: absolute; top: 0; left: 0; right: 0; bottom: auto; height: min(50vh, 105vw); }
    .learn { padding-top: calc(min(50vh, 105vw) - 66px); }
    .lista a { display: inline-flex; align-items: center; min-height: 32px; }
  }
</style>
