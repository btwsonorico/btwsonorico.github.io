---
import Base from '../../layouts/Base.astro';

// Learn: la valle è il menu. Ogni mongolfiera porta a una risorsa, la stessa lista sta anche nel testo
const RISORSE = [
  { nome: 'neural network', href: '/learn/neural-network/', nota: 'add neurons and watch a network learn to draw' },
  { nome: 'glossary', href: '/learn/glossary/', nota: 'fish the terms of AI out of a reef, one at a time' },
];
---
<Base title="Learn · Riccardo Mondi" description="AI concepts you can touch: interactive resources by Riccardo Mondi." largo>
  <div class="fondo3d"><div class="scena3d" aria-hidden="true"></div></div>
  <main class="learn" data-risorse={JSON.stringify(RISORSE.map(({ nome, href }) => ({ nome, href })))}>
    <h1>Learn</h1>
    <p class="sotto">AI concepts you can touch. Pick a balloon.</p>
    <ul class="lista">
      {RISORSE.map(r => <li><a href={r.href} data-risorsa={r.nome}>{r.nome}</a><span class="mono">{r.nota}</span></li>)}
    </ul>
  </main>
</Base>

<script>
  const pagina = document.querySelector<HTMLElement>('[data-risorse]')!;
  const risorse = (JSON.parse(pagina.dataset.risorse!) as { nome: string; href: string }[]).map(r => ({
    ...r, lista: pagina.querySelector<HTMLElement>(`[data-risorsa="${r.nome}"]`),
  }));
  import('../../scripts/nuvole').then(m => m.monta(document.querySelector<HTMLElement>('.scena3d')!, risorse));
</script>

<style>
  /* La valle copre lo schermo, dietro al testo; il testo lascia passare il puntatore tranne sui link */
  .fondo3d { position: fixed; inset: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: pan-y; }
  .learn { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s4); }
  .learn a { pointer-events: auto; }
  .learn > * { width: fit-content; max-width: 420px; }
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .sotto { margin: 0 0 var(--s3); color: var(--muted); background: color-mix(in srgb, var(--bg) 78%, transparent); }
  .lista { margin: 0; padding: 0; list-style: none; }
  .lista li { margin-bottom: var(--s1); font-size: 13px; line-height: 1.5; }
  .lista a { display: inline-block; padding: 0 5px; margin-left: -5px; color: var(--fg); }
  .lista a:hover { color: var(--bg); background: var(--fg); text-decoration: none; }
  .lista span { display: block; width: fit-content; background: color-mix(in srgb, var(--bg) 78%, transparent); }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  /* Etichette delle scene 3D, come nelle altre pagine. Il nome di una mongolfiera è un link */
  .scena3d :global(.etichetta) {
    position: absolute; left: 0; top: 0; pointer-events: none; white-space: nowrap;
    padding: 1px 5px; font-family: var(--mono); font-size: 11px; color: var(--fg);
    background: color-mix(in srgb, var(--bg) 78%, transparent); transition: opacity .15s;
  }
  .scena3d :global(.nome-pallone) { padding: 2px 8px; border: 1px solid var(--fg); background: var(--bg); color: var(--fg); font-size: 13px; pointer-events: auto; text-decoration: none; }
  .scena3d :global(.nome-pallone:hover), .scena3d :global(.nome-pallone.attiva) { color: var(--bg); background: var(--fg); }
  .scena3d :global(.nome-pallone.attiva)::after { content: ' · open →'; }
  /* Telefono: la valle sta in una fascia in alto, il testo sotto */
  @media (max-width: 640px) {
    .fondo3d { position: absolute; top: 0; left: 0; right: 0; bottom: auto; height: min(50vh, 105vw); }
    .learn { padding-top: calc(min(50vh, 105vw) - 66px); }
    .lista a { display: inline-flex; align-items: center; min-height: 32px; }
    .scena3d :global(.nome-pallone) { padding: 5px 8px; font-size: 12px; }
  }
</style>
