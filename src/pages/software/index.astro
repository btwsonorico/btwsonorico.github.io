---
import Base from '../../layouts/Base.astro';
import Attivita from '../../components/Attivita.astro';
import Competenze from '../../components/Competenze.astro';
import Grafo from '../../components/Grafo.astro';
import { datiCompetenze } from '../../lib/grafi';

const dati = await datiCompetenze('projects');
---
<Base title="SW engineering · Riccardo Mondi" description="Key programming skills, learned building tools." tono="verde" largo>
  <main class="affianca">
    <header class="testa testa-pagina a-testa">
      <h1>SW engineering</h1>
      <p>What I build, grouped by skill or by the project where I learned it.</p>
    </header>

    <div class="a-grafo"><Grafo dati={dati} legenda={['skill', 'area']} motore="bosco" modi={[{ id: 'competenza', nome: 'by skill' }, { id: 'progetto', nome: 'by project' }]} nomi={{ skill: 'big tree: skill or project', area: 'tree: area' }} aiuto="taller tree, more technologies · click a tree to see its topic · click the grass to drop an apple · drag to rotate" /></div>

    <div class="a-resto">
      <section class="sezione">
        <h2 class="mono">Commits</h2>
        <Attivita />
      </section>
      <Competenze sezione="projects" />
    </div>
  </main>
</Base>

<style>
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); max-width: 560px; }
</style>
