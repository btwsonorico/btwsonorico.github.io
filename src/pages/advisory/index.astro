---
import Base from '../../layouts/Base.astro';
import Competenze from '../../components/Competenze.astro';
import Grafo from '../../components/Grafo.astro';
import { grafoCompetenze } from '../../lib/grafi';

const dati = await grafoCompetenze('advisory');
---
<Base title="Advisory · Riccardo Mondi" description="Key advisory skills: AI strategy, value analysis, adoption and engagement management." tono="lilla" largo>
  <main class="affianca">
    <header class="testa testa-pagina a-testa">
      <h1>Advisory</h1>
      <p>Four key skills from AI advisory work with organisations: where to start, where AI creates value, how people adopt it, and how to run the project. In the map, each violet point is a skill and each white point is an area of it. Open a skill below to see what it means in practice.</p>
    </header>

    <div class="a-grafo"><Grafo dati={dati} legenda={['skill', 'area']} /></div>

    <div class="a-resto">
      <Competenze sezione="advisory" />
    </div>
  </main>
</Base>

<style>
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); max-width: 560px; }
</style>
