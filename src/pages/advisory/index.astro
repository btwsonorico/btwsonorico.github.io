---
import Base from '../../layouts/Base.astro';
import Competenze from '../../components/Competenze.astro';
import Grafo from '../../components/Grafo.astro';
import { datiCompetenze } from '../../lib/grafi';

const dati = await datiCompetenze('advisory');
---
<Base title="Advisory · Riccardo Mondi" description="Key advisory skills: AI strategy, opportunity mapping, business design, people and adoption, engagement management." tono="arancio" largo>
  <main class="affianca">
    <header class="testa testa-pagina a-testa">
      <h1>Advisory</h1>
      <p>Five key skills from AI advisory work with organisations: where to start, where AI creates value, how the business changes, how people adopt it, and how to run the project. In the orbital system, each planet is a skill and each moon is an area of it. Open a skill below to see what it means in practice.</p>
    </header>

    <div class="a-grafo"><Grafo dati={dati} legenda={['skill', 'area']} motore="orbite" nomi={{ skill: 'planet: key skill', area: 'moon: area' }} aiuto="click a planet or a moon to see its topic · drag to rotate" /></div>

    <div class="a-resto">
      <Competenze sezione="advisory" />
    </div>
  </main>
</Base>

<style>
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); max-width: 560px; }
</style>
