---
import Base from '../../layouts/Base.astro';
import Competenze from '../../components/Competenze.astro';
import Grafo from '../../components/Grafo.astro';
import { datiCompetenze } from '../../lib/grafi';

const dati = await datiCompetenze('advisory');
---
<Base title="Advisory · Riccardo Mondi" description="Key advisory skills: AI strategy, opportunity mapping, business design, people and adoption, engagement management." tono="azzurro" largo>
  <main class="affianca sfondo">
    <header class="testa testa-pagina a-testa">
      <h1>Advisory</h1>
      <p>How I help organisations adopt AI, grouped by skill.</p>
    </header>

    <div class="a-grafo"><Grafo dati={dati} motore="laghetto" /></div>

    <div class="a-resto">
      <Competenze sezione="advisory" />
    </div>
  </main>
</Base>

<style>
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); max-width: 560px; }
</style>
