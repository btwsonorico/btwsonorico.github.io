---
import Base from '../../layouts/Base.astro';

// Esperimenti: due sfondi a pixel e tre diorami 3D per rilassarsi (barriera, sottobosco con i formicai, nuvole)
---
<Base title="Misc · Riccardo Mondi" description="Small experiments." largo>
  <canvas class="scena" aria-hidden="true"></canvas>
  <!-- Scene 3D: ognuna nel suo contenitore, montata la prima volta che si apre -->
  <div class="fondo3d" data-fondo="barriera" hidden><div class="scena3d" aria-hidden="true"></div></div>
  <div class="fondo3d" data-fondo="formicaio" hidden><div class="scena3d" aria-hidden="true"></div></div>
  <div class="fondo3d" data-fondo="nuvole" hidden><div class="scena3d" aria-hidden="true"></div></div>
  <main class="misc">
    <p class="mono"><a href="/">~</a>/misc</p>
    <h1>Misc</h1>
    <p class="mono">Small experiments.</p>
    <p class="mono scelte" role="group" aria-label="Experiment">
      <button type="button" data-scena="barriera">reef</button>
      <button type="button" data-scena="formicaio">ants</button>
      <button type="button" data-scena="nuvole">clouds</button>
      <button type="button" data-scena="vita">life</button>
      <button type="button" data-scena="onde">waves</button>
    </p>
  </main>
</Base>

<script>
  import type { Scena } from '../../scripts/pixel';

  const tela = document.querySelector<HTMLCanvasElement>('.scena')!;
  const bottoni = document.querySelectorAll<HTMLButtonElement>('[data-scena]');

  // Scene 3D: si montano una volta sola; fermarle vuol dire nasconderle (la vista 3D non disegna quando è nascosta)
  const montate = new Set<string>();
  const scena3d = (nome: string, monta: (el: HTMLElement) => Promise<unknown>) => async (): Promise<Scena> => {
    const fondo = document.querySelector<HTMLElement>(`[data-fondo="${nome}"]`)!;
    tela.hidden = true;
    fondo.hidden = false;
    if (!montate.has(nome)) { montate.add(nome); await monta(fondo.querySelector<HTMLElement>('.scena3d')!); }
    return { ferma() { fondo.hidden = true; tela.hidden = false; } };
  };

  // Ogni esperimento si carica solo quando serve
  const SCENE: Record<string, () => Promise<Scena>> = {
    barriera: scena3d('barriera', async el => (await import('../../scripts/barriera')).monta(el)),
    formicaio: scena3d('formicaio', async el => (await import('../../scripts/formicaio')).monta(el)),
    nuvole: scena3d('nuvole', async el => (await import('../../scripts/nuvole')).monta(el)),
    vita: async () => (await import('../../scripts/vita')).monta(tela),
    onde: async () => (await import('../../scripts/onde')).monta(tela),
  };

  let attuale: Scena | null = null, richiesta = 0;
  const mostra = async (nome: string) => {
    if (!SCENE[nome]) nome = 'barriera';
    const mia = ++richiesta;
    attuale?.ferma();
    attuale = null;
    bottoni.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.scena === nome)));
    try { localStorage.setItem('misc-scena', nome); } catch {}
    const scena = await SCENE[nome]!();
    // Se nel frattempo è stato scelto un altro esperimento, questo si ferma subito
    if (mia !== richiesta) scena.ferma(); else attuale = scena;
  };
  bottoni.forEach(b => b.addEventListener('click', () => mostra(b.dataset.scena!)));
  let ricordata = 'barriera';
  try { ricordata = localStorage.getItem('misc-scena') ?? 'barriera'; } catch {}
  mostra(ricordata);
</script>

<style>
  /* Gli esperimenti coprono la pagina dietro al testo; il testo lascia passare il puntatore tranne su link e bottoni */
  .scena { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; touch-action: manipulation; }
  .fondo3d { position: fixed; top: 64px; bottom: 64px; left: 0; right: 0; z-index: 0; }
  .scena[hidden], .fondo3d[hidden] { display: none; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: none; }
  .misc a, .misc button { pointer-events: auto; }
  .misc { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s4); }
  .misc > * { max-width: 520px; margin: 0 0 var(--s2); }
  .misc > p:first-child a { color: inherit; }
  h1 { font-size: 33px; font-weight: 400; line-height: 1.1; }
  .scelte { display: flex; flex-wrap: wrap; gap: 6px var(--s2); align-items: center; }
  .scelte button { padding: 0 6px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; }
  .scelte button:hover { color: var(--fg); }
  .scelte button[aria-pressed="true"] { border-color: var(--fg); color: var(--fg); }
  /* Etichette delle scene 3D, come nelle altre pagine */
  .scena3d :global(.etichetta) {
    position: absolute; left: 0; top: 0; pointer-events: none; white-space: nowrap;
    padding: 1px 5px; font-family: var(--mono); font-size: 11px; color: var(--muted);
    background: color-mix(in srgb, var(--bg) 78%, transparent); transition: opacity .15s;
  }
  .scena3d :global(.etichetta.skill) { color: var(--fg); }
  .scena3d :global(.etichetta.attiva) { color: var(--bg); background: var(--fg); padding: 2px 7px; z-index: 2; }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  @media (max-width: 640px) {
    .fondo3d { top: 220px; bottom: 0; }
  }
</style>
