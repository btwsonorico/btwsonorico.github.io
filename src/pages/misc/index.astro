---
import Base from '../../layouts/Base.astro';

// Esperimenti: scene 3D per rilassarsi (valle, barriera)
---
<Base title="Misc · Riccardo Mondi" description="Small experiments." largo>
  <!-- Scene 3D: ognuna nel suo contenitore, montata la prima volta che si apre -->
  <div class="fondo3d" data-fondo="barriera" hidden><div class="scena3d" aria-hidden="true"></div></div>
  <div class="fondo3d" data-fondo="nuvole" hidden><div class="scena3d" aria-hidden="true"></div></div>
  <main class="misc">
    <p class="mono"><a href="/">~</a>/misc</p>
    <h1>Misc</h1>
    <p class="mono">Small experiments.</p>
    <p class="mono scelte" role="group" aria-label="Experiment">
      <button type="button" data-scena="nuvole">valley</button>
      <button type="button" data-scena="barriera">reef</button>
      <a class="pagina" href="/misc/glossary/">glossary</a>
    </p>
    <!-- Color editor: i tre toni chiave della scena 3D aperta; la scelta resta in questo browser -->
    <p class="mono toni" hidden>
      <label><input type="color" data-tono="0" /><span></span></label>
      <label><input type="color" data-tono="1" /><span></span></label>
      <label><input type="color" data-tono="2" /><span></span></label>
      <button type="button" class="ripristina">reset</button>
    </p>
  </main>
</Base>

<script>
  import type { Palco } from '../../scripts/natura';

  type Scena = { ferma(): void };
  const bottoni = document.querySelectorAll<HTMLButtonElement>('[data-scena]');

  // Scene 3D: si montano una volta sola; fermarle vuol dire nasconderle (la vista 3D non disegna quando è nascosta)
  const montate = new Map<string, Palco>();
  const montatori: Record<string, (el: HTMLElement) => Promise<Palco>> = {};
  // Nomi dei tre toni chiave di ogni scena, per il color editor
  const NOMI: Record<string, string[]> = { barriera: ['water', 'earth', 'coral'], nuvole: ['hills', 'sky', 'accent'] };
  const editor = document.querySelector<HTMLElement>('.toni')!;
  const selettori = editor.querySelectorAll<HTMLInputElement>('input[type="color"]');
  const mostraEditor = (nome: string | null) => {
    const palco = nome ? montate.get(nome) : undefined;
    editor.hidden = !palco;
    if (!palco || !nome) return;
    selettori.forEach((s, i) => { s.value = `#${palco.toni[i]!.getHexString()}`; s.nextElementSibling!.textContent = NOMI[nome]![i]!; });
  };
  const scena3d = (nome: string, monta: (el: HTMLElement) => Promise<Palco>) => async (): Promise<Scena> => {
    const fondo = document.querySelector<HTMLElement>(`[data-fondo="${nome}"]`)!;
    montatori[nome] = monta;
    fondo.hidden = false;
    if (!montate.has(nome)) montate.set(nome, await monta(fondo.querySelector<HTMLElement>('.scena3d')!));
    mostraEditor(nome);
    return { ferma() { fondo.hidden = true; editor.hidden = true; } };
  };
  // Nuovi toni: la scena si smonta e si ridisegna con i colori scelti
  const ridisegna = async (toni: string[] | null) => {
    const nome = [...bottoni].find(b => b.getAttribute('aria-pressed') === 'true')?.dataset.scena;
    const vecchia = nome ? montate.get(nome) : undefined;
    if (!nome || !vecchia) return;
    const { salvaToni } = await import('../../scripts/natura');
    salvaToni(nome, toni);
    vecchia.distruggi();
    montate.set(nome, await montatori[nome]!(document.querySelector<HTMLElement>(`[data-fondo="${nome}"] .scena3d`)!));
    mostraEditor(nome);
  };
  let attesa = 0;
  selettori.forEach(s => s.addEventListener('input', () => {
    clearTimeout(attesa);
    attesa = window.setTimeout(() => ridisegna([...selettori].map(x => x.value)), 250);
  }));
  editor.querySelector('.ripristina')!.addEventListener('click', () => ridisegna(null));

  // Ogni esperimento si carica solo quando serve
  const SCENE: Record<string, () => Promise<Scena>> = {
    barriera: scena3d('barriera', async el => (await import('../../scripts/barriera')).monta(el)),
    nuvole: scena3d('nuvole', async el => (await import('../../scripts/nuvole')).monta(el)),
  };

  let attuale: Scena | null = null, richiesta = 0;
  const mostra = async (nome: string) => {
    const mia = ++richiesta;
    attuale?.ferma();
    attuale = null;
    bottoni.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.scena === nome)));
    const scena = await SCENE[nome]!();
    // Se nel frattempo è stato scelto un altro esperimento, questo si ferma subito
    if (mia !== richiesta) scena.ferma(); else attuale = scena;
  };
  bottoni.forEach(b => b.addEventListener('click', () => mostra(b.dataset.scena!)));
  // Si parte sempre dalla valle
  mostra('nuvole');
</script>

<style>
  /* Gli esperimenti coprono la pagina dietro al testo; il testo lascia passare il puntatore tranne su link e bottoni */
  .fondo3d { position: fixed; top: 64px; bottom: 0; left: 0; right: 0; z-index: 0; }
  .fondo3d[hidden] { display: none; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: none; }
  .misc a, .misc button { pointer-events: auto; }
  .misc { position: relative; z-index: 1; pointer-events: none; padding-top: var(--s4); }
  .misc > * { max-width: 520px; margin: 0 0 var(--s2); }
  .misc > p:first-child a { color: inherit; }
  h1 { font-size: 33px; font-weight: 400; line-height: 1.1; }
  .scelte { display: flex; flex-wrap: wrap; gap: 6px var(--s2); align-items: center; }
  .scelte button { padding: 0 6px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; }
  .scelte button:hover { color: var(--fg); }
  /* Il glossario è una pagina, non una scena: stesso aspetto dei bottoni */
  .scelte .pagina { padding: 0 6px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); text-decoration: none; }
  .scelte .pagina:hover { color: var(--fg); }
  .scelte button[aria-pressed="true"] { border-color: var(--fg); color: var(--fg); }
  /* Color editor: tre quadratini di colore col loro nome, e il bottone per tornare ai colori di partenza */
  .toni { display: flex; flex-wrap: wrap; gap: 6px var(--s2); align-items: center; color: var(--muted); }
  .toni[hidden] { display: none; }
  .toni label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; pointer-events: auto; }
  .toni input { width: 18px; height: 18px; padding: 0; border: 1px solid var(--line); background: none; cursor: pointer; }
  .toni input::-webkit-color-swatch-wrapper { padding: 0; }
  .toni input::-webkit-color-swatch { border: none; }
  .toni button { padding: 0 6px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; }
  .toni button:hover { color: var(--fg); }
  /* Etichette delle scene 3D, come nelle altre pagine */
  .scena3d :global(.etichetta) {
    position: absolute; left: 0; top: 0; pointer-events: none; white-space: nowrap;
    padding: 1px 5px; font-family: var(--mono); font-size: 11px; color: var(--muted);
    background: color-mix(in srgb, var(--bg) 78%, transparent); transition: opacity .15s;
  }
  .scena3d :global(.etichetta.skill) { color: var(--fg); }
  .scena3d :global(.etichetta.attiva) { color: var(--bg); background: var(--fg); padding: 2px 7px; z-index: 2; }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  @media (max-width: 640px) {
    .fondo3d { top: 220px; bottom: 0; }
    .scelte button, .scelte .pagina, .toni button { padding: 6px 12px; }
    .toni input { width: 28px; height: 28px; }
  }
</style>
