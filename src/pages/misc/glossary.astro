---
import Base from '../../layouts/Base.astro';
import dati from '../../data/glossario.json';

// Glossario: prima versione, una semplice lista. I dati stanno in src/data/glossario.json: la visualizzazione si decide dopo
// e può cambiare senza toccare i testi.
// Una voce di elenco "Nome: testo" o "Nome – testo" mostra il nome in evidenza
const dividi = (punto: string) => {
  const m = punto.match(/^([^:–]{2,70}?)(?::| –) (.+)$/);
  return m ? { nome: m[1]!, testo: m[2]! } : { nome: '', testo: punto };
};
---
<Base title="Glossary · Riccardo Mondi" description="AI terms and definitions." tono="neutro">
  <main class="glossario">
    <p class="mono"><a href="/">~</a>/<a href="/misc/">misc</a>/glossary</p>
    <h1>Glossary</h1>
    <p class="intro">Terms that define the current AI landscape. Definitions synthesized from IBM, Google, Microsoft, Anthropic and OpenAI.</p>
    <nav class="mono indice" aria-label="Sections">
      {dati.sezioni.map(s => <a href={`#${s.titolo.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{s.titolo}</a>)}
    </nav>
    {dati.sezioni.map(s => <section class="sezione" id={s.titolo.toLowerCase().replace(/[^a-z]+/g, '-')}>
      <h2 class="mono">{s.titolo}</h2>
      <dl>
        {s.voci.map(v => <div class="voce" id={v.id}>
          <dt>{v.termine}</dt>
          <dd>
            {v.definizione.map(t => <p>{t}</p>)}
            {v.punti.length > 0 && <ul>
              {v.punti.map(dividi).map(q => <li>{q.nome && <strong>{q.nome}: </strong>}{q.testo}</li>)}
            </ul>}
          </dd>
        </div>)}
      </dl>
    </section>)}
    <section class="sezione" id="to-be-defined">
      <h2 class="mono">To be defined</h2>
      <ul class="da-definire mono">
        {dati.daDefinire.map(t => <li>{t}</li>)}
      </ul>
    </section>
  </main>
</Base>

<style>
  .glossario > p:first-child a { color: inherit; }
  h1 { font-size: 33px; font-weight: 400; line-height: 1.1; margin: var(--s2) 0; }
  .intro { color: var(--muted); }
  .indice { display: flex; flex-wrap: wrap; gap: 4px var(--s2); margin: var(--s3) 0; }
  .indice a { color: var(--accent); }
  html { scroll-behavior: smooth; }
  dl { margin: 0; }
  .voce { padding: var(--s2) 0; scroll-margin-top: var(--s2); }
  .voce + .voce { border-top: 1px dashed var(--line); }
  dt { font-size: 17px; }
  dd { margin: var(--s1) 0 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
  dd p { margin: 0 0 var(--s1); }
  dd ul { margin: 0; padding-left: 18px; }
  dd li { margin-bottom: 6px; }
  dd strong { font-weight: 400; color: var(--fg); }
  .da-definire { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .da-definire li { padding: 2px 8px; border: 1px solid var(--line); }
  @media (max-width: 640px) {
    .indice a { display: inline-flex; align-items: center; min-height: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
