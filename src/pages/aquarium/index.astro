---
import Base from '../../layouts/Base.astro';
---
<Base title="Aquarium · Riccardo Mondi" description="A pixel aquarium: click anywhere to feed the fish." largo>
  <canvas class="acqua" aria-label="Pixel aquarium: fish swim across the screen; click to drop food"></canvas>
  <main class="testo">
    <p class="mono"><a href="/about/">about</a> · aquarium</p>
    <h1>Aquarium</h1>
    <p>Click anywhere to drop some food. The fish come to eat it.</p>
    <p class="mono">eaten <span class="mangiate">0</span></p>
  </main>
</Base>

<script>
  import { monta } from '../../scripts/acquario';
  const tela = document.querySelector<HTMLCanvasElement>('.acqua');
  if (tela) monta(tela, document.querySelector<HTMLElement>('.mangiate'));
</script>

<style>
  /* Lo schermo è l'acquario: il canvas copre tutto e riceve i clic per il cibo */
  .acqua { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; cursor: crosshair; touch-action: manipulation; }
  /* Il testo sta sopra ma lascia passare i clic, tranne sui link */
  .testo { position: relative; z-index: 1; padding-top: var(--s4); pointer-events: none; }
  .testo a { pointer-events: auto; text-decoration: none; }
  .testo > * { max-width: 520px; margin: 0 0 var(--s1); text-shadow: 0 0 6px var(--bg), 0 0 12px var(--bg); }
  h1 { font-size: 33px; font-weight: 400; }
  .testo p:nth-of-type(2) { color: var(--muted); }
  .mangiate { color: var(--accent); }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
</style>
