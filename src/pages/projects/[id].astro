---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { areePubbliche, scrittiPubblici } from '../../lib/grafi';
import { COMPETENZE } from '../../content.config';

export async function getStaticPaths() {
  return (await areePubbliche()).map(a => ({ params: { id: a.id }, props: { a } }));
}

const { a } = Astro.props;
const { Content } = await render(a);
const competenza = COMPETENZE[a.data.skill];
const scritti = (await scrittiPubblici()).filter(s => a.data.related.includes(s.id));
---
<Base title={`${a.data.title} · Riccardo Mondi`} description={a.data.summary} tono="verde">
  <main>
    <article>
      <p class="mono testa"><a href="/projects/">projects</a> · <a href={`/projects/#${a.data.skill}`}>{competenza.title}</a></p>
      <h1>{a.data.title}</h1>
      <p class="sommario">{a.data.summary}</p>
      <p class="mono stack">{a.data.stack.map(t => <span>{t}</span>)}</p>
      <div class="prosa"><Content /></div>
      {a.data.contexts.length ? <p class="mono contesti">learned in {a.data.contexts.join(' · ')}</p> : null}
      {scritti.length ? <section class="collegati sezione">
        <h2 class="mono">Related writing</h2>
        <ul>{scritti.map(s => <li><a href={`/knowledge/${s.id}/`}>{s.data.title}</a></li>)}</ul>
      </section> : null}
    </article>
  </main>
</Base>

<style>
  article { max-width: 640px; padding: var(--s4) 0 var(--s3); }
  .testa { margin: 0; }
  .testa a { text-decoration: none; }
  h1 { margin: var(--s1) 0 var(--s2); font-size: 33px; font-weight: 400; line-height: 1.2; }
  .sommario { margin: 0 0 var(--s2); color: var(--muted); }
  @media (max-width: 640px) { h1 { font-size: 26px; } }
  .stack { display: flex; flex-wrap: wrap; gap: var(--s1); margin: 0 0 var(--s3); }
  .stack span { border: 1px solid var(--line); padding: 0 6px; color: var(--accent); }
  .prosa :global(li) { margin-bottom: var(--s1); }
  .contesti { margin-top: var(--s3); }
  .collegati { margin-top: var(--s4); }
  ul { margin: 0; padding-left: 18px; }
</style>
