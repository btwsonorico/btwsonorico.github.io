---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Attivita from '../../components/Attivita.astro';
import Grafo from '../../components/Grafo.astro';
import { areePubbliche, grafoCompetenze } from '../../lib/grafi';
import { COMPETENZE } from '../../content.config';

// Una voce per competenza chiave; dentro, le aree con i punti del loro file Markdown.
const aree = await Promise.all((await areePubbliche()).map(async a => ({ a, Content: (await render(a)).Content })));
const competenze = Object.entries(COMPETENZE)
  .map(([id, c]) => {
    const sue = aree.filter(x => x.a.data.skill === id);
    return { id, ...c, aree: sue, stack: [...new Set(sue.flatMap(x => x.a.data.stack))] };
  })
  .filter(c => c.aree.length);
const dati = await grafoCompetenze();
---
<Base title="Projects · Riccardo Mondi" description="Key programming skills, learned building tools." tono="arancio" largo>
  <main class="affianca">
    <header class="testa testa-pagina a-testa">
      <h1>Projects</h1>
      <p>Four key skills, learned building tools for interview analysis, event reports and feedback collection. In the map, each orange point is a skill and each white point is an area of it. Open a skill below to see what it means in practice.</p>
    </header>

    <div class="a-grafo"><Grafo dati={dati} legenda={['skill', 'area']} /></div>

    <div class="a-resto">
    <section class="sezione">
      <h2 class="mono">Commits</h2>
      <Attivita />
    </section>

    <section class="sezione competenze">
      <h2 class="mono">Key skills</h2>
      {competenze.map((c, i) => <details class="competenza" id={c.id} open={i === 0}>
        <summary data-id={`skill:${c.id}`}>
          <span class="mono numero">{String(i + 1).padStart(2, '0')}</span>
          <span class="titolo">
            <span class="nome">{c.title}</span>
            <span class="nota">{c.summary}</span>
            <span class="mono stack">{c.stack.map(t => <span>{t}</span>)}</span>
          </span>
          <span class="mono segno" aria-hidden="true"></span>
        </summary>
        <ul class="aree">
          {c.aree.map(({ a, Content }) => <li>
            <details class="area">
              <summary data-id={`area:${a.id}`}>
                <span class="titolo">
                  <span class="nome">{a.data.title}</span>
                  <span class="nota">{a.data.summary}</span>
                </span>
                <span class="mono segno" aria-hidden="true"></span>
              </summary>
              <div class="prosa"><Content /></div>
              <p class="mono piede-area">
                {a.data.contexts.length ? <span>learned in {a.data.contexts.join(' · ')}</span> : null}
                <a href={`/projects/${a.id}/`}>details →</a>
              </p>
            </details>
          </li>)}
        </ul>
      </details>)}
    </section>
    </div>
  </main>
</Base>

<script>
  // Passare sopra una voce evidenzia il suo nodo nel grafo
  document.querySelectorAll<HTMLElement>('summary[data-id]').forEach(s => {
    const invia = (id: string | null) => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: id }));
    s.addEventListener('mouseenter', () => invia(s.dataset.id!));
    s.addEventListener('mouseleave', () => invia(null));
  });
  // Un link a /projects/#competenza (dal grafo o dalla home) apre quella voce
  const apri = () => {
    const d = location.hash && document.getElementById(location.hash.slice(1));
    if (d instanceof HTMLDetailsElement) { d.open = true; d.scrollIntoView({ block: 'start' }); }
  };
  window.addEventListener('hashchange', apri);
  apri();
</script>

<style>
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); max-width: 560px; }
  .competenza { scroll-margin-top: var(--s2); }

  details { border-top: 1px solid var(--line); }
  .competenza:last-child { border-bottom: 1px solid var(--line); }
  summary { display: grid; gap: var(--s2); align-items: baseline; padding: var(--s2) 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .competenza > summary { grid-template-columns: 32px 1fr auto; }
  .area > summary { grid-template-columns: 1fr auto; padding: var(--s1) 0; }
  .titolo { display: flex; flex-direction: column; }
  .competenza > summary .nome { font-size: 22px; line-height: 1.3; }
  summary:hover .nome { color: var(--accent); }
  .nota { color: var(--muted); font-size: 13px; }
  .segno { color: var(--accent); }
  .segno::before { content: '[+]'; }
  details[open] > summary .segno::before { content: '[−]'; }
  .stack { display: flex; flex-wrap: wrap; gap: var(--s1); margin-top: var(--s1); }
  .stack span { border: 1px solid var(--line); padding: 0 6px; color: var(--accent); }

  .aree { list-style: none; margin: 0 0 var(--s2) 48px; padding: 0; }
  .area { border-top-style: dashed; }
  .prosa :global(ul) { margin: 0; padding-left: 18px; }
  .prosa :global(li) { margin-bottom: var(--s1); }
  .piede-area { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s1); margin: var(--s1) 0 var(--s2); }
  .piede-area a { color: var(--accent); text-decoration: none; }
  @media (max-width: 640px) {
    .competenza > summary { grid-template-columns: 1fr auto; gap: 4px 12px; }
    .numero { display: none; }
    .aree { margin-left: 0; }
  }
</style>
