---
import Base from '../../layouts/Base.astro';
import Attivita from '../../components/Attivita.astro';
import Competenze from '../../components/Competenze.astro';
import Grafo from '../../components/Grafo.astro';
import { datiCompetenze } from '../../lib/grafi';

const dati = await datiCompetenze('projects');
---
<Base title="Projects · Riccardo Mondi" description="Key programming skills, learned building tools." tono="arancio" largo>
  <main class="affianca">
    <header class="testa testa-pagina a-testa">
      <h1>Projects</h1>
      <p>Four key skills, learned building tools for interview analysis, event reports and feedback collection. In the forest, each tree is an area and each signpost marks the skill it belongs to: the taller the tree, the more technologies it uses. Open a skill below to see what it means in practice.</p>
    </header>

    <div class="a-grafo"><Grafo dati={dati} legenda={['skill', 'area']} motore="bosco" nomi={{ skill: 'signpost: key skill', area: 'tree: area' }} aiuto="taller tree, more technologies · click a tree to open · drag to rotate" /></div>

    <div class="a-resto">
      <section class="sezione">
        <h2 class="mono">Commits</h2>
        <Attivita />
      </section>
      <Competenze sezione="projects" />
    </div>
  </main>
</Base>

<style>
  h1 { margin: 0 0 var(--s1); font-size: 33px; font-weight: 400; }
  .testa p { margin: 0; color: var(--muted); max-width: 560px; }
</style>
