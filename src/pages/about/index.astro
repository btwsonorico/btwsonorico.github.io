---
import Base from '../../layouts/Base.astro';

// Tutte le pagine del sito, con una riga che dice cosa c'è
const PAGINE = [
  { nome: 'home', href: '/', nota: 'overview: forest, pond and latest writing' },
  { nome: 'software', href: '/software/', nota: 'what I build: skills, areas, commits' },
  { nome: 'advisory', href: '/advisory/', nota: 'how I help organisations adopt AI' },
  { nome: 'knowledge', href: '/knowledge/', nota: 'notes on papers, talks and books' },
  { nome: 'rss', href: '/rss.xml', nota: 'feed of the knowledge notes' },
];
const BIO = 'I help organisations adopt AI, and I build the tools that make it work: from research to code.';
---
<Base title="About · Riccardo Mondi" description="Riccardo Mondi: AI advisor and developer at Politecnico di Milano." largo>
  <canvas class="scena" aria-hidden="true"></canvas>
  <!-- Mondo 3D: il contenitore copre lo schermo; la scena sta dentro, così la vista 3D sa quando è visibile -->
  <div class="fondo3d" hidden><div class="scena3d" aria-hidden="true"></div></div>
  <main class="about">
    <p class="mono">~/about</p>
    <h1>Riccardo Mondi</h1>
    <p class="ruolo">AI Advisor & Developer</p>
    <p class="mono ente">Politecnico di Milano - Osservatorio Artificial Intelligence + R&amp;D Osservatori</p>
    <p class="bio">{BIO}</p>
    <p class="mono link">
      <a href="mailto:riccardo.mondi@polimi.it">email</a>
      <a href="https://github.com/btwsonorico" rel="me">github</a>
      <a href="https://www.linkedin.com/in/riccardo-mondi-7717181aa/" rel="me">linkedin</a>
    </p>
    <nav class="pagine" aria-label="All pages">
      <p class="mono titoletto">pages</p>
      <ul>
        {PAGINE.map(p => <li><a href={p.href} data-sezione={['software', 'advisory', 'knowledge'].includes(p.nome) ? `sezione:${p.nome}` : undefined}>{p.nome}</a><span class="mono">{p.nota}</span></li>)}
      </ul>
    </nav>
    <div class="mono aiuto">
      <p class="scelte" role="group" aria-label="Background">
        <span>background</span>
        <button type="button" data-scena="mondo">world</button>
        <button type="button" data-scena="vita">life</button>
        <button type="button" data-scena="onde">waves</button>
      </p>
      <p class="spiega"></p>
    </div>
  </main>
</Base>

<script>
  import type { Scena } from '../../scripts/pixel';

  const tela = document.querySelector<HTMLCanvasElement>('.scena')!;
  const spiega = document.querySelector<HTMLElement>('.spiega')!;
  const bottoni = document.querySelectorAll<HTMLButtonElement>('[data-scena]');

  // Mondo 3D: si monta una volta sola; fermarlo vuol dire nasconderlo (la vista 3D non disegna quando è nascosta)
  const fondo = document.querySelector<HTMLElement>('.fondo3d')!, mondo = document.querySelector<HTMLElement>('.scena3d')!;
  let mondoMontato = false;
  const montaMondo = async (): Promise<Scena> => {
    tela.hidden = true;
    fondo.hidden = false;
    if (!mondoMontato) { mondoMontato = true; (await import('../../scripts/mondo')).monta(mondo); }
    return { ferma() { fondo.hidden = true; tela.hidden = false; } };
  };

  // Ogni scena si carica solo quando serve
  const SCENE: Record<string, { aiuto: string; monta: () => Promise<Scena> }> = {
    vita: { aiuto: "Conway's game of life · move the mouse to seed cells · click for a burst", monta: async () => (await import('../../scripts/vita')).monta(tela) },
    onde: { aiuto: 'the shore seen from above · move the mouse to make ripples · click for a splash', monta: async () => (await import('../../scripts/onde')).monta(tela) },
    mondo: { aiuto: 'the forest is Software, the pond is Advisory, the orange flock is Knowledge · click one to open it · drag to rotate', monta: montaMondo },
  };

  let attuale: Scena | null = null, richiesta = 0;
  const mostra = async (nome: string) => {
    if (!SCENE[nome]) nome = 'mondo';
    const mia = ++richiesta;
    attuale?.ferma();
    attuale = null;
    bottoni.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.scena === nome)));
    spiega.textContent = SCENE[nome]!.aiuto;
    try { localStorage.setItem('about-scena', nome); } catch {}
    const scena = await SCENE[nome]!.monta();
    // Se nel frattempo è stata scelta un'altra scena, questa si ferma subito
    if (mia !== richiesta) scena.ferma(); else attuale = scena;
  };
  bottoni.forEach(b => b.addEventListener('click', () => mostra(b.dataset.scena!)));
  // Passare sopra una sezione nella lista accende la sua parte del mondo 3D, come nelle liste delle altre pagine
  document.querySelectorAll<HTMLElement>('[data-sezione]').forEach(a => {
    a.addEventListener('mouseenter', () => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: a.dataset.sezione })));
    a.addEventListener('mouseleave', () => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: null })));
  });
  let ricordata = 'mondo';
  try { ricordata = localStorage.getItem('about-scena') ?? 'mondo'; } catch {}
  mostra(ricordata);
</script>

<style>
  /* La scena copre tutto lo schermo, dietro al testo; il canvas riceve il puntatore, il testo lo lascia passare tranne su link e bottoni */
  .scena { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 0; touch-action: manipulation; }
  .about a, .about button { pointer-events: auto; }
  .about { position: relative; z-index: 1; pointer-events: none; display: flex; flex-direction: column; justify-content: flex-end; min-height: calc(100vh - 160px); padding-bottom: var(--s4); }
  .about > * { max-width: 520px; margin: 0 0 var(--s2); }
  h1 { margin-bottom: var(--s1); font-size: 44px; font-weight: 400; line-height: 1.1; }
  .ruolo { font-size: 22px; margin-bottom: var(--s1); }
  .ente { font-size: 13px; }
  .bio { color: var(--fg); }
  .link { display: flex; gap: var(--s2); }
  .link a, .aiuto a { color: var(--accent); }
  .aiuto { margin-top: var(--s2); }
  .pagine ul { margin: 0; padding: 0; list-style: none; }
  .pagine li { display: flex; gap: var(--s2); align-items: baseline; font-size: 13px; line-height: 1.7; }
  .pagine li a { min-width: 80px; color: var(--accent); }
  .titoletto { margin: 0 0 4px; }
  .aiuto p { margin: 0 0 6px; }
  .scelte { display: flex; flex-wrap: wrap; gap: 6px var(--s2); align-items: center; }
  .scelte button { padding: 0 6px; border: 1px solid var(--line); background: var(--bg); color: var(--muted); font: inherit; cursor: pointer; }
  .scelte button:hover { color: var(--fg); }
  .scelte button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
  /* Testo leggibile anche quando la scena ci passa sotto */
  .about > * { text-shadow: 0 0 6px var(--bg), 0 0 12px var(--bg); }
  :global(.barra), :global(.piede) { position: relative; z-index: 1; }
  .scena[hidden], .fondo3d[hidden] { display: none; }
  .fondo3d { position: fixed; inset: 0; z-index: 0; }
  .scena3d { position: absolute; inset: 0; overflow: hidden; touch-action: none; }
  /* Etichette del mondo: come nelle scene di bosco e laghetto, nel colore della loro sezione */
  .scena3d :global(.etichetta) {
    position: absolute; left: 0; top: 0; pointer-events: none; white-space: nowrap;
    padding: 1px 5px; font-family: var(--mono); font-size: 11px; color: var(--accent);
    background: color-mix(in srgb, var(--bg) 78%, transparent); transition: opacity .15s;
  }
  .scena3d :global(.etichetta.attiva) { color: var(--bg); background: var(--accent); padding: 2px 7px; z-index: 2; }
  /* Sezione sotto il puntatore: la sua etichetta dice che si apre */
  .scena3d :global(.etichetta.skill.attiva)::after { content: ' · open →'; }
  @media (max-width: 640px) {
    h1 { font-size: 33px; }
    /* Sul telefono la scena non sta dietro al testo: occupa una fascia in alto, che scorre via con la pagina.
       Così il testo resta leggibile e i link si toccano */
    .scena, .fondo3d { position: absolute; top: 0; left: 0; right: 0; bottom: auto; width: 100%; height: 46vh; }
    /* Il mondo 3D ha bisogno di più spazio: la sua fascia è più alta */
    .fondo3d { height: 50vh; }
    .fondo3d:not([hidden]) ~ .about { padding-top: 45vh; }
    .about { padding-top: 40vh; min-height: 0; justify-content: flex-start; }
    /* Sul telefono il trascinamento in verticale fa scorrere la pagina anche sopra il cielo */
    .scena3d { touch-action: pan-y; }
    .about > * { text-shadow: none; }
  }
</style>
