---
import '@/components/arc/foundation.css';
// tono: colore d'accento della pagina. Senza tono resta l'acquamarina del sito.
// largo: pagina a tutta larghezza su schermi grandi (home, Knowledge, Projects); i testi restano stretti.
interface Props { title: string; description?: string; lang?: 'it' | 'en'; tono?: 'arancio'; largo?: boolean }
const { title, description = 'Research, advisory, software.', lang = 'en', tono, largo = false } = Astro.props;
const build = new Date().toISOString().slice(0, 10);
---
<!doctype html>
<html lang={lang} data-theme="dark" data-cyber data-tono={tono}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
  </head>
  <body class:list={{ largo }}>
    <header class="barra">
      <a href="/" class="io">~/riccardomondi<span class="cursore" aria-hidden="true">_</span></a>
      <nav>
        <a href="/knowledge/">knowledge</a>
        <a href="/projects/">projects</a>
      </nav>
    </header>
    <slot />
    <footer class="piede">
      <span>build {build}</span>
      <span>static · github pages</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0a0b0d;
    --fg: #d9dde3;
    --muted: #7a828d;
    --line: #1c2026;
    --accent: #5ef0c0;
    --mono: 'Departure Mono', ui-monospace, monospace;
    --serif: 'Newsreader', Georgia, serif;
    color-scheme: dark;
  }
  /* I componenti Arc usano i colori del sito */
  :root[data-theme="dark"][data-cyber] {
    --accent: #5ef0c0;
    --accent-foreground: var(--bg);
    --background: var(--bg);
    --surface: #15181d;
    --surface-muted: var(--bg);
    --foreground: var(--fg);
    --text-muted: var(--muted);
    --text-secondary: var(--muted);
    --border: var(--line);
    --shadow-resting: none;
    --radius-control: 2px;
  }
  /* Arancio: complementare dell'acquamarina, con la stessa luminosità e saturazione */
  /* Vale per una pagina intera (Base con tono) o per una sola sezione (data-tono sull'elemento) */
  :root[data-theme="dark"][data-cyber][data-tono="arancio"], [data-tono="arancio"] { --accent: #ffa45e; }
  /* Departure Mono (SIL OFL, helenazhang.com): nitida a multipli di 11px */
  @font-face {
    font-family: 'Departure Mono';
    src: url('/fonts/DepartureMono-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--fg);
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.6;
    /* Griglia di punti appena visibile */
    background-image: radial-gradient(color-mix(in srgb, var(--fg) 7%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  ::selection { background: var(--accent); color: var(--bg); }
  a { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  :focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }

  .barra, .piede {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: var(--larghezza);
    margin: 0 auto;
    padding: 20px 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .barra a { text-decoration: none; }
  .barra nav { display: flex; gap: 18px; }
  .io { color: var(--fg); }
  .cursore { color: var(--accent); animation: lampeggia 1.1s steps(1) infinite; }
  @keyframes lampeggia { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursore { animation: none; } }
  .piede { margin-top: auto; border-top: 1px solid var(--line); padding-top: 18px; padding-bottom: 28px; }
  main { width: 100%; max-width: var(--larghezza); margin: 0 auto; padding: 0 16px; }
  body { --larghezza: 760px; }
  body.largo { --larghezza: 1320px; }

  /* Pagine con grafo: su schermi larghi il grafo sta a destra, fermo mentre la colonna sinistra scorre.
     Su schermi stretti l'ordine resta: testa, grafo, resto. */
  @media (min-width: 1080px) {
    body.largo main { padding: 0 32px; }
    .affianca {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: "testa grafo" "resto grafo";
      column-gap: 56px;
    }
    .a-testa { grid-area: testa; }
    .a-resto { grid-area: resto; }
    .a-grafo {
      grid-area: grafo;
      align-self: start;
      position: sticky;
      top: 16px;
      --altezza-grafo: min(calc(100vh - 120px), 820px);
    }
  }
  .mono { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  /* Tutto il sito è in Departure Mono; solo il testo da leggere (note e aree) è in Newsreader */
  .prosa { font-family: var(--serif); font-size: 19px; line-height: 1.6; }
</style>
