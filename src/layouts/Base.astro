---
import '@/components/arc/foundation.css';
import Cursore from '@/components/Cursore.astro';
import { INDICIZZABILE } from '@/lib/sito';
// tono: colore d'accento della pagina. Senza tono resta l'azzurro del sito.
// largo: pagina a tutta larghezza su schermi grandi (home, Knowledge, Projects); i testi restano stretti.
interface Props { title: string; description?: string; lang?: 'it' | 'en'; tono?: 'verde' | 'arancio' | 'azzurro'; largo?: boolean }
const { title, description = 'Riccardo Mondi: AI advisor and developer at Politecnico di Milano.', lang = 'en', tono, largo = false } = Astro.props;
// Indirizzo canonico della pagina, per i motori di ricerca e per le anteprime quando la pagina si condivide
const canonico = new URL(Astro.url.pathname, Astro.site).href;
const build = new Date().toISOString().slice(0, 10);
---
<!doctype html>
<html lang={lang} data-theme="dark" data-cyber data-tono={tono}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Finché il contenuto non è finale, motori di ricerca e AI non indicizzano il sito (interruttore in src/lib/sito.ts) -->
    {!INDICIZZABILE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonico} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Il font del sito arriva subito, insieme alla pagina: il testo non cambia aspetto dopo il caricamento -->
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0b0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <!-- Anteprima quando la pagina si condivide (LinkedIn, chat, social) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Riccardo Mondi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonico} />
    <meta name="twitter:card" content="summary" />
    <!-- Tema scelto (o quello del sistema) prima del primo disegno, così la pagina non lampeggia -->
    <script is:inline>
      (() => {
        let tema = null;
        try { tema = localStorage.getItem('tema'); } catch {}
        if (tema !== 'light' && tema !== 'dark') tema = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = tema;
      })();
    </script>
  </head>
  <body class:list={{ largo }}>
    <header class="barra">
      <span class="nome"><a href="/" class="io">~/riccardomondi<span class="cursore" aria-hidden="true">_</span></a><span class="wip" title="Work in progress: the site is still being built">wip</span></span>
      <nav>
        <a href="/software/">software</a>
        <a href="/advisory/">advisory</a>
        <a href="/knowledge/">knowledge</a>
        <button type="button" class="cambia-tema" aria-label="Switch between light and dark mode">light</button>
      </nav>
    </header>
    <slot />
    <footer class="piede">
      <span>build {build}</span>
      <span>static · github pages</span>
    </footer>
    <Cursore />
    <script>
      // Cambio di tema: le pagine senza scene cambiano subito; quelle con una scena (3D o a pixel) si ricaricano,
      // perché le scene leggono i colori una volta sola, quando partono
      const bottone = document.querySelector<HTMLButtonElement>('.cambia-tema')!;
      const radice = document.documentElement;
      const etichetta = () => { bottone.textContent = radice.dataset.theme === 'light' ? 'dark' : 'light'; };
      etichetta();
      bottone.addEventListener('click', () => {
        const tema = radice.dataset.theme === 'light' ? 'dark' : 'light';
        try { localStorage.setItem('tema', tema); } catch {}
        if (document.querySelector('canvas, [data-grafo]')) { location.reload(); return; }
        radice.dataset.theme = tema;
        etichetta();
      });
    </script>
  </body>
</html>

<style is:global>
  /* Tema scuro (base) e tema chiaro. I tre colori delle sezioni cambiano col tema, per restare leggibili sul fondo. */
  :root {
    --bg: #0a0b0d;
    --fg: #d9dde3;
    --muted: #7a828d;
    --line: #1c2026;
    --superficie: #15181d;
    --verde: #3fb950;
    --azzurro: #58a6ff;
    --arancio: #ffa45e;
    --accent: var(--azzurro);
    --mono: 'Departure Mono', ui-monospace, monospace;
    /* Spaziature: s1 dentro un blocco, s2 sotto un titolo, s3 fra sezioni, s4 in testa alla pagina */
    --s1: 8px;
    --s2: 16px;
    --s3: 24px;
    --s4: 48px;
    color-scheme: dark;
  }
  :root[data-theme="light"] {
    --bg: #f6f5f1;
    --fg: #1f2328;
    --muted: #656d76;
    --line: #dcd9d0;
    --superficie: #ebe9e2;
    --verde: #1a7f37;
    --azzurro: #0969da;
    --arancio: #bc4c00;
    color-scheme: light;
  }
  /* I componenti Arc usano i colori del sito */
  :root[data-theme][data-cyber] {
    --accent: var(--azzurro);
    --accent-foreground: var(--bg);
    --background: var(--bg);
    --surface: var(--superficie);
    --surface-muted: var(--bg);
    --foreground: var(--fg);
    --text-muted: var(--muted);
    --text-secondary: var(--muted);
    --border: var(--line);
    --shadow-resting: none;
    --radius-control: 2px;
  }
  /* Tre sezioni, tre colori: verde GitHub (Software), arancio (Knowledge), azzurro (Advisory, anche il colore base) */
  :root[data-theme][data-cyber][data-tono="azzurro"], [data-tono="azzurro"] { --accent: var(--azzurro); }
  :root[data-theme][data-cyber][data-tono="verde"], [data-tono="verde"] { --accent: var(--verde); }
  /* Vale per una pagina intera (Base con tono) o per una sola sezione (data-tono sull'elemento) */
  :root[data-theme][data-cyber][data-tono="arancio"], [data-tono="arancio"] { --accent: var(--arancio); }
  /* Departure Mono (SIL OFL, helenazhang.com): nitida a multipli di 11px */
  @font-face {
    font-family: 'Departure Mono';
    src: url('/fonts/DepartureMono-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--fg);
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.6;
    /* Griglia di punti appena visibile */
    background-image: radial-gradient(color-mix(in srgb, var(--fg) 7%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  ::selection { background: var(--accent); color: var(--bg); }
  a { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  :focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }

  .barra, .piede {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: var(--larghezza);
    margin: 0 auto;
    padding: 20px 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .barra a { text-decoration: none; }
  .barra nav { display: flex; gap: 18px; align-items: center; }
  .cambia-tema { padding: 0 5px; border: 1px solid var(--line); background: none; color: var(--muted); font: inherit; cursor: pointer; }
  .cambia-tema:hover { color: var(--fg); border-color: var(--muted); }
  /* Su schermi stretti nome e link vanno su due righe, così nessun link esce dallo schermo */
  @media (max-width: 640px) { .barra { flex-wrap: wrap; row-gap: 10px; } .barra nav { gap: 14px; } }
  .io { color: var(--fg); }
  /* Sito in costruzione: un'etichetta piccola accanto al nome */
  .nome { display: inline-flex; align-items: center; gap: 10px; }
  .wip { padding: 0 5px; border: 1px solid var(--accent); color: var(--accent); font-size: 10px; line-height: 15px; text-transform: uppercase; letter-spacing: 0.06em; }
  .cursore { color: var(--accent); animation: lampeggia 1.1s steps(1) infinite; }
  @keyframes lampeggia { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursore { animation: none; } }
  .piede { margin-top: auto; border-top: 1px solid var(--line); padding-top: var(--s2); padding-bottom: var(--s3); }
  /* Sezione: linea sopra, titolo // in mono, stessa distanza ovunque */
  .sezione { padding: var(--s3) 0; border-top: 1px solid var(--line); }
  .sezione > h2 { margin: 0 0 var(--s2); font-weight: 400; color: var(--accent); }
  .sezione > h2::before { content: '// '; color: var(--muted); }
  .testa-pagina { padding: var(--s4) 0 var(--s3); }
  main { width: 100%; max-width: var(--larghezza); margin: 0 auto; padding: 0 16px var(--s4); }
  body { --larghezza: 760px; }
  body.largo { --larghezza: 1320px; }

  /* Pagine con grafo: su schermi larghi il grafo sta a destra, fermo mentre la colonna sinistra scorre.
     Su schermi stretti l'ordine resta: testa, grafo, resto. */
  @media (min-width: 1080px) {
    body.largo main { padding: 0 32px var(--s4); }
    .affianca {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: "testa grafo" "resto grafo";
      column-gap: 56px;
    }
    .a-testa { grid-area: testa; }
    .a-resto { grid-area: resto; }
    .a-grafo {
      grid-area: grafo;
      align-self: start;
      position: sticky;
      top: 16px;
      --altezza-grafo: min(calc(100vh - 120px), 820px);
    }
  }
  .mono { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  /* Tutto il sito è in Departure Mono. Il testo da leggere ha più interlinea. */
  .prosa { line-height: 1.75; }
  /* Departure Mono non ha il grassetto: l'enfasi è nel colore */
  .prosa strong, .prosa b { font-weight: 400; color: var(--accent); }
</style>
