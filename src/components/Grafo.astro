---
import type { DatiGrafo, TipoNodo } from '../lib/grafi';

// Una o più viste dello stesso grafo. Con due viste compaiono i pulsanti per passare dall'una all'altra.
interface Vista { nome: string; dati: DatiGrafo; legenda: TipoNodo[] }
type Props = { viste: Vista[] } | { dati: DatiGrafo; legenda: TipoNodo[] };
const props = Astro.props;
const viste: Vista[] = 'viste' in props ? props.viste : [{ nome: '', dati: props.dati, legenda: props.legenda }];
const NOMI: Record<TipoNodo, string> = { testo: 'writing', tema: 'topic', fonte: 'source', area: 'area', tech: 'technology', skill: 'key skill' };
---
<figure class="grafo">
  {viste.map((v, i) => <div class="scena" data-vista={i} data-grafo={JSON.stringify(v.dati)} hidden={i > 0} aria-hidden="true"></div>)}
  <figcaption class="mono">
    {viste.length > 1 && <span class="viste" role="group" aria-label="View">
      {viste.map((v, i) => <button type="button" data-mostra={i} aria-pressed={i === 0 ? 'true' : 'false'}>{v.nome}</button>)}
    </span>}
    {viste.map((v, i) => <span class="legenda" data-vista={i} hidden={i > 0}>
      {v.legenda.map(t => <span><i class={`punto ${t}`}></i>{NOMI[t]}</span>)}
      {v.dati.stelle?.length ? <span><i class="punto stella"></i>older writing</span> : null}
    </span>)}
    <span class="aiuto">drag a node · click to open · drag the space to rotate</span>
  </figcaption>
</figure>

<script>
  import { monta } from '../scripts/grafo';
  document.querySelectorAll<HTMLElement>('[data-grafo]').forEach(monta);
  document.querySelectorAll<HTMLElement>('.grafo').forEach(fig => {
    fig.querySelectorAll<HTMLButtonElement>('[data-mostra]').forEach(b => b.addEventListener('click', () => {
      fig.querySelectorAll<HTMLElement>('[data-vista]').forEach(el => { el.hidden = el.dataset.vista !== b.dataset.mostra; });
      fig.querySelectorAll('[data-mostra]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    }));
  });
</script>

<style>
  .grafo { margin: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .scena { position: relative; height: 440px; touch-action: none; cursor: grab; overflow: hidden; }
  .scena[hidden] { display: none; }
  .scena:active { cursor: grabbing; }
  figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; padding: 10px 0; }
  .legenda { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .legenda[hidden] { display: none; }
  .viste { display: inline-flex; border: 1px solid var(--line); }
  .viste button { font: inherit; color: var(--muted); background: none; border: 0; padding: 2px 10px; cursor: pointer; }
  .viste button[aria-pressed="true"] { color: var(--bg); background: var(--accent); }
  .viste button:hover:not([aria-pressed="true"]) { color: var(--accent); }
  .aiuto { margin-left: auto; }
  .punto { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; vertical-align: 1px; }
  .punto.testo, .punto.area { background: var(--fg); }
  .punto.tema, .punto.tech, .punto.skill { background: var(--accent); }
  .punto.tech { border-radius: 0; }
  .punto.fonte { border: 1px solid var(--muted); border-radius: 0; transform: rotate(45deg); }
  .punto.stella { width: 3px; height: 3px; margin: 0 8px 0 2px; background: var(--fg); opacity: .7; }
  .scena :global(.etichetta) {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    transition: opacity .15s;
  }
  .scena :global(.etichetta.tema), .scena :global(.etichetta.tech), .scena :global(.etichetta.skill) { color: var(--accent); }
  .scena :global(.anello) {
    position: absolute;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border: 1px solid var(--fg);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }
  .scena :global(.anello.tema), .scena :global(.anello.skill) { border-color: var(--accent); }
  .scena :global(.anello.via) { animation: anello 1.8s cubic-bezier(.2, .7, .3, 1) both; }
  @keyframes anello { from { transform: scale(.35); opacity: .7; } to { transform: scale(2.4); opacity: 0; } }
  .scena :global(.etichetta.attiva) { color: var(--bg); background: var(--fg); padding: 2px 7px; font-size: 11px; z-index: 2; }
  @media (max-width: 640px) {
    .scena { height: 360px; }
    .aiuto { margin-left: 0; }
  }
</style>
