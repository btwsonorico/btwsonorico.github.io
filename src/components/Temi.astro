---
import { hrefTema } from '../lib/grafi';

// Riga di hashtag con il numero di testi. Passare sopra un hashtag evidenzia il suo nodo nel grafo.
// Con "filtro" i link filtrano le liste della pagina Knowledge; "all" toglie il filtro.
interface Props { temi: { nome: string; n: number }[]; filtro?: boolean }
const { temi, filtro = false } = Astro.props;
---
<p class="temi mono">
  {filtro && <a href="/knowledge/" data-tema="">all</a>}
  {temi.map(t => <a href={hrefTema(t.nome)} data-tema={t.nome} data-id={`tema:${t.nome}`}>#{t.nome}<span>{t.n}</span></a>)}
</p>

<script>
  document.querySelectorAll<HTMLElement>('.temi [data-id]').forEach(a => {
    const invia = (id: string | null) => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: id }));
    a.addEventListener('mouseenter', () => invia(a.dataset.id!));
    a.addEventListener('mouseleave', () => invia(null));
  });
</script>

<style>
  .temi { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; }
  .temi a { text-decoration: none; color: var(--accent); border: 1px solid var(--line); padding: 1px 8px; }
  .temi a:hover, .temi a[aria-current="true"] { border-color: var(--accent); }
  .temi a[aria-current="true"] { color: var(--bg); background: var(--accent); }
  .temi span { color: var(--muted); margin-left: 6px; }
  .temi a[aria-current="true"] span { color: var(--bg); }
</style>
