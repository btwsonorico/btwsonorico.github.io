---
import { execSync } from 'node:child_process';
import salvati from '../data/contributi.json';

// Griglia dei contributi degli ultimi 12 mesi, dall'API GraphQL di GitHub durante la build.
// Token: GH_CONTRIB_TOKEN (secret nel workflow) oppure, in locale, quello della gh CLI.
// Serve il token dell'utente: solo così il conteggio include i repository privati.
// Senza token usa l'ultimo calendario salvato con "npm run contributi".
const UTENTE = 'btwsonorico';

function token() {
  if (process.env.GH_CONTRIB_TOKEN) return process.env.GH_CONTRIB_TOKEN;
  try { return execSync(`gh auth token --user ${UTENTE}`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim(); }
  catch { return ''; }
}

interface Giorno { date: string; weekday: number; contributionCount: number }
async function calendario(): Promise<Giorno[]> {
  const t = token();
  if (!t) { console.warn('[Attivita] Nessun token GitHub: uso src/data/contributi.json.'); return salvati; }
  const query = `query($login: String!) { user(login: $login) { contributionsCollection { contributionCalendar {
    weeks { contributionDays { date weekday contributionCount } } } } } }`;
  const r = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: { Authorization: `bearer ${t}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ query, variables: { login: UTENTE } }),
  });
  const json = await r.json();
  if (!r.ok || json.errors) { console.warn('[Attivita] Risposta GitHub non valida, uso src/data/contributi.json:', json.errors ?? r.status); return salvati; }
  return json.data.user.contributionsCollection.contributionCalendar.weeks.flatMap((w: { contributionDays: Giorno[] }) => w.contributionDays);
}

const giorni = await calendario();
// La prima settimana può iniziare a metà: celle vuote fino al suo giorno
const vuoti = giorni[0]?.weekday ?? 0;
const max = Math.max(1, ...giorni.map(g => g.contributionCount));
const livello = (c: number) => c === 0 ? 0 : Math.min(4, Math.ceil((c / max) * 4));
const totale = giorni.reduce((s, g) => s + g.contributionCount, 0);
// Su schermi stretti restano le ultime 26 settimane (6 mesi): le celle restano abbastanza grandi
const RECENTI = 26;
const settimane = Math.ceil((vuoti + giorni.length) / 7);
const vecchia = (posizione: number) => Math.floor(posizione / 7) < settimane - RECENTI;
const totaleRecente = giorni.reduce((s, g, i) => vecchia(vuoti + i) ? s : s + g.contributionCount, 0);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const ultimo = giorni.at(-1)?.date;
---
<div class="attivita">
  {giorni.length ? <>
    <div class="griglia" role="img" aria-label={`${totale} contributions in the last 12 months`}>
      {Array.from({ length: vuoti }, () => <i class:list={{ vecchia: vecchia(0) }}></i>)}
      {giorni.map((g, i) => <span class:list={[`l${livello(g.contributionCount)}`, { vecchia: vecchia(vuoti + i) }]} data-tip={`${g.contributionCount} ${g.contributionCount === 1 ? 'contribution' : 'contributions'} · ${fmt.format(new Date(g.date))}`}></span>)}
    </div>
    <p class="mono"><span class="anno">{totale} contributions in the last 12 months</span><span class="recenti">{totaleRecente} contributions in the last 6 months</span>, public and private repositories · <a href={`https://github.com/${UTENTE}`}>github.com/{UTENTE}</a> · updated {ultimo && fmt.format(new Date(ultimo))}</p>
  </> : <p class="mono">Activity on <a href={`https://github.com/${UTENTE}`}>github.com/{UTENTE}</a></p>}
</div>

<style>
  /* La griglia riempie la larghezza disponibile, con celle quadrate, fino a 700px */
  .griglia {
    display: grid;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 2px;
    width: 100%;
    max-width: 700px;
  }
  .griglia > * { aspect-ratio: 1; }
  .recenti { display: none; }
  @media (max-width: 640px) {
    .griglia .vecchia { display: none; }
    .griglia { gap: 3px; }
    .anno { display: none; }
    .recenti { display: inline; }
  }
  span { position: relative; border-radius: 1px; background: var(--line); }
  .l1 { background: color-mix(in srgb, var(--accent) 25%, var(--line)); }
  .l2 { background: color-mix(in srgb, var(--accent) 50%, var(--line)); }
  .l3 { background: color-mix(in srgb, var(--accent) 75%, var(--line)); }
  .l4 { background: var(--accent); }
  span:hover { outline: 1px solid var(--fg); }
  span:hover::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    padding: 3px 8px;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--bg);
    background: var(--fg);
    pointer-events: none;
  }
  p { margin: var(--s1) 0 0; }
  p a { color: var(--accent); text-decoration: none; }
</style>
