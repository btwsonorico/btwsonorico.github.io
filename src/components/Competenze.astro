---
// Competenze chiave collassabili; dentro ognuna, solo il nome di ogni area e una frase. Il dettaglio è nella pagina dell'area.
// Usata da Projects e Advisory. Passare sopra una voce evidenzia il suo nodo nella scena.
import { sezioni, type Sezione } from '../lib/grafi';

interface Props { sezione: Sezione }
const { sezione } = Astro.props;
const { competenze: tutte, aree: carica } = sezioni[sezione];
// Projects si chiama Software: le pagine stanno in /software/
const percorso = sezione === 'projects' ? 'software' : sezione;
const aree = await carica();
const competenze = Object.entries(tutte)
  .map(([id, c]) => ({ id, ...c, aree: aree.filter(a => a.data.skill === id) }))
  .filter(c => c.aree.length);
---
<section class="sezione competenze">
  <h2 class="mono">Key skills</h2>
  {competenze.map((c, i) => <details class="competenza" id={c.id} open={i === 0}>
    <summary data-id={`skill:${c.id}`}>
      <span class="mono numero">{String(i + 1).padStart(2, '0')}</span>
      <span class="titolo">
        <span class="nome">{c.title}</span>
        <span class="nota">{c.summary}</span>
      </span>
      <span class="mono segno" aria-hidden="true"></span>
    </summary>
    <ul class="aree">
      {c.aree.map(a => <li>
        <a class="area" href={`/${percorso}/${a.id}/`} data-id={`area:${a.id}`}>
          <span class="nome">{a.data.title}</span>
          <span class="nota">{a.data.summary}</span>
        </a>
      </li>)}
    </ul>
  </details>)}
</section>

<script>
  document.querySelectorAll<HTMLElement>('.competenze [data-id]').forEach(s => {
    const invia = (id: string | null) => window.dispatchEvent(new CustomEvent('grafo:evidenzia', { detail: id }));
    s.addEventListener('mouseenter', () => invia(s.dataset.id!));
    s.addEventListener('mouseleave', () => invia(null));
  });
  // Aprire una competenza avvicina la scena al suo albero (o branco); chiuderla torna alla vista intera
  document.querySelectorAll<HTMLDetailsElement>('.competenza').forEach(d => {
    d.querySelector('summary')!.addEventListener('click', () => {
      // Il clic arriva prima che la voce si apra o si chiuda: qui d.open è ancora lo stato di prima
      const id = d.open ? null : `skill:${d.id}`;
      window.dispatchEvent(new CustomEvent('grafo:zoom', { detail: id }));
    });
  });
  // Un link a #competenza (dal grafo o dalla home) apre quella voce
  const apri = () => {
    const d = location.hash && document.getElementById(location.hash.slice(1));
    if (d instanceof HTMLDetailsElement) { d.open = true; d.scrollIntoView({ block: 'start' }); }
  };
  window.addEventListener('hashchange', apri);
  apri();
</script>

<style>
  .competenza { scroll-margin-top: var(--s2); border-top: 1px solid var(--line); }
  .competenza:last-child { border-bottom: 1px solid var(--line); }
  summary { display: grid; grid-template-columns: 32px 1fr auto; gap: var(--s2); align-items: baseline; padding: var(--s2) 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .titolo { display: flex; flex-direction: column; }
  summary .nome { font-size: 22px; line-height: 1.3; }
  summary:hover .nome { color: var(--accent); }
  .nota { color: var(--muted); font-size: 13px; }
  .segno { color: var(--accent); }
  .segno::before { content: '[+]'; }
  details[open] > summary .segno::before { content: '[−]'; }

  .aree { list-style: none; margin: 0 0 var(--s2) 48px; padding: 0; }
  .area { display: flex; flex-direction: column; padding: var(--s1) 0; border-top: 1px dashed var(--line); text-decoration: none; }
  .area:hover .nome { color: var(--accent); }
  /* Voce aperta da un clic nella scena 3D: un lampo di colore per trovarla */
  .lampo { animation: lampo 1.6s ease-out; }
  @keyframes lampo { from { background: color-mix(in srgb, var(--accent) 22%, transparent); } to { background: transparent; } }
  @media (prefers-reduced-motion: reduce) { .lampo { animation: none; outline: 1px solid var(--accent); } }
  @media (max-width: 640px) {
    summary { grid-template-columns: 1fr auto; gap: 4px 12px; }
    .numero { display: none; }
    .aree { margin-left: 0; }
  }
</style>
